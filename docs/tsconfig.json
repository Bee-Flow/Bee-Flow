{
  "extends": "@docusaurus/tsconfig",
  "compilerOptions": {
    // TypeScript 7 removed baseUrl (the Docusaurus base still sets it): null
    // unsets it, and these paths resolve what it did.
    "baseUrl": null,
    "paths": {
      "@site/*": ["./*"],
      "*": ["./*"]
    }
  },
  "exclude": [".docusaurus", "build", "site", ".venv", "node_modules"]
}
