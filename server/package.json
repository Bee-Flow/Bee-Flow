{
  "name": "bee-flow-server",
  "version": "1.0.0",
  "description": "Bee Flow AI core API: agents, automations, RAG, auth and licensing (Node 22 / Express 5)",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0 <23.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "start": "node index.js",
    "db:migrate": "node migrateDb.js",
    "build:editor-md": "npx -y esbuild ../agent-hub/src/editor/serialization/index.js --bundle --format=cjs --platform=node --outfile=core/markdown/editorSerialization.cjs",
    "build:editor-collab": "npx -y esbuild ../agent-hub/src/editor/collab/serverEntry.ts --bundle --format=cjs --platform=node --target=node22 --external:yjs --external:y-protocols --external:lib0 \"--banner:js=/* GENERATED by 'cd server && npm run build:editor-collab' from agent-hub/src/editor/collab/serverEntry.ts. Do not edit. */ /* eslint-disable */ /* jscpd:ignore-start */\" \"--footer:js=/* jscpd:ignore-end */\" --outfile=core/markdown/editorCollab.cjs",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "geo:fetch": "node scripts/fetch-geo-db.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE.md",
