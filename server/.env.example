# Bee Flow server — environment template
#
# Copy to `.env` and fill in. The server FAILS TO BOOT if required vars
# are missing; this is intentional — silent fallbacks to predictable
# defaults are how secrets get effectively published.

# ─────────────────────────────────────────────────────────────────
# REQUIRED — server WILL refuse to start without these
# ─────────────────────────────────────────────────────────────────

# Master signing/encryption seed. Used for:
#   - express-session cookie signing (account-takeover risk if predictable)
#   - AES-256-GCM key for OAuth-token storage in support_inboxes
#   - HMAC for time-limited storage download URLs
#   - MS-Graph subscription clientState (CSRF protection)
# Generate a fresh one (≥32 chars; 64+ recommended):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ROTATING THIS INVALIDATES existing sessions and breaks decryption of
# already-stored OAuth tokens — re-link integrations after rotation.
SESSION_SECRET=

# HMAC key for short-lived (4h) preview-iframe bearer tokens. Used by the
# sandboxed webpage preview to call /api/webpages-preview/* (DB + AI +
# Automation + Integration bridges) without a session cookie.
# Generate (≥32 chars; 64+ recommended):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In dev this auto-persists a per-project secret in OS temp so restarts
# don't invalidate tokens; in production you MUST set this explicitly.
WEBPAGE_PREVIEW_TOKEN_SECRET=

# PostgreSQL connection string for the server's runtime pool (server/db.js).
# This is the var the pool actually reads — unset, it silently falls back to
# postgresql://beeflow:beeflow@localhost:5432/beeflow_core. The server creates
# its own tables on boot. The full stack uses three databases: beeflow_core
# (this one), beeflow_tasks and monitoring_db.
CORE_DATABASE_URL=postgresql://beeflow:CHANGE_ME@localhost:5432/beeflow_core
# DATABASE_URL is read only by the maintenance script
# server/scripts/deleteOrgs.js — keep it for that script, not for the server.
# DATABASE_URL=postgresql://beeflow:CHANGE_ME@localhost:5432/beeflow_tasks

# ─────────────────────────────────────────────────────────────────
# Strongly recommended in production
# ─────────────────────────────────────────────────────────────────

# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGIN=https://app.example.com

# Force secure cookies (HTTPS-only). Defaults to true when NODE_ENV=production.
# Set explicitly to 'false' only in dev where you serve over plain HTTP.
COOKIE_SECURE=true

# Cookie SameSite policy. Use 'strict' if you don't need cross-site OAuth
# popups; 'lax' is the safe default that still allows top-level navigations.
COOKIE_SAMESITE=lax

# If your frontend lives on a sibling sub-domain (api.x.com vs app.x.com),
# set the parent domain so cookies are shared. Leave blank otherwise.
# COOKIE_DOMAIN=.example.com

# Set to 'production' to enable secure cookie defaults + drop dev logging.
NODE_ENV=production

# ─────────────────────────────────────────────────────────────────
# Optional integrations
# ─────────────────────────────────────────────────────────────────

# Redis read-through cache layer over the PG session store. Optional;
# the server falls back to PG-only sessions when REDIS_URL is unset.
# REDIS_URL=redis://localhost:6379

# Distinct secret for MS-Graph subscription clientState HMAC. If unset
# the code reuses SESSION_SECRET — fine for single-tenant; set this if
# you want independent rotation.
# MSGRAPH_CLIENT_STATE_SECRET=

# ── Automations engine tuning (all optional; defaults shown) ──
# Public inbound trigger surface rate limits (sliding window per 60s).
# AUTOMATION_WEBHOOK_RPM_PER_SLUG=120
# AUTOMATION_WEBHOOK_RPM_PER_IP=300
# AUTOMATION_EVENTS_RPM_PER_IP=600
# Authenticated run-trigger endpoints (/:id/run, /dry-run, step run, retry,
# agent-invoke) — per-user requests/min.
# AUTOMATION_RUN_TRIGGER_RPM=30
# Legacy user_sessions OAuth fallback for polling triggers. ON by default;
# set to 0 to force the automation-credentials vault only (no browser-session
# tokens). NOTE: default is ENABLED — the fallback is used unless this is '0'.
# AUTOMATION_AUTH_LEGACY=1   (was ROUTINE_AUTH_LEGACY; the old name still counts when this one is unset)

# OPAQUE PAKE — optional; generate via:
#   node scripts/generate-opaque-setup.js
# Changing it invalidates every existing OPAQUE registration.
# OPAQUE_SERVER_SETUP=

# Public base URL (used for outgoing webhooks / callback URLs).
# Also the switch that decides whether MS Graph subscriptions get provisioned
# at all — automation/triggerBus.js skips them while it is unset.
# PUBLIC_BASE_URL=https://api.example.com
# CLIENT_PUBLIC_HOST=app.example.com
# CLIENT_PROTOCOL=https

# Public origin of the MARKETING SITE (routes/publicRender.js). Drives canonical,
# og:url, hreflang and the sitemap's <loc> values, and gates robots.txt: while it
# is unset the host is treated as unknown and served "Disallow: /", so a public
# site MUST set it or it will not be indexed. Falls back to PUBLIC_BASE_URL when
# absent, which is the right answer on a single-host install where the app and
# the marketing site share an origin. Leave it unset on staging/preview hosts —
# that is what keeps a copy of the site out of the index.
# PUBLIC_SITE_URL=https://www.example.com

# Reranker (Azure Cohere preferred; local sidecar fallback)
# AZURE_RERANKER_ENDPOINT=
# AZURE_RERANKER_KEY=
# AZURE_RERANKER_MODEL=Cohere-rerank-v4.0-fast
# RERANKER_URL=http://reranker:8000

# Self-registration toggles
ALLOW_SIGNUPS=true
ALLOW_PASSWORD_LOGIN=true

# ─────────────────────────────────────────────────────────────────
# Deployment mode
# ─────────────────────────────────────────────────────────────────
#   Only two values are supported:
#   cloud       — multi-tenant SaaS (beeflow.ai). Allows consumer (org-less)
#                 accounts and per-user Stripe subscriptions.
#   self-hosted — customer-run, single-tenant or multi-org. Server-wide licence
#                 keys; no Stripe/billing; Community tier by default. Enforces
#                 organization domain allow-lists and disables consumer accounts.
#   (The retired 'private-cloud' value is treated as 'self-hosted'.)
DEPLOYMENT_MODE=cloud

# ─────────────────────────────────────────────────────────────────
# Licensing
# ─────────────────────────────────────────────────────────────────
# Where customers are sent when a feature gate blocks them. Shown verbatim
# in the 'upgrade_url' field of the 403 response from license middleware.
LICENSE_UPGRADE_URL=https://beeflow.ai/pricing

# Beeflow JWT license server endpoints. LEAVE UNSET in Phase 1 — admin-issued
# license blobs (`beeflow-admin-v1.*`) and the Stripe subscription fallback
# work without an external license server. Set these once license.beeflow.ai
# is live (see docs/docs/licensing/server-deploy.md).
# LICENSE_ISSUE_URL=https://license.beeflow.ai/v1/issue
# LICENSE_ISSUE_API_KEY=                 # an API key configured on the license server
# LICENSE_REFRESH_URL=https://license.beeflow.ai/v1/refresh
# LICENSE_PUBLIC_KEY_FILE=/srv/beeflow/server/license/bundled-public-key.pem

# Refresh scheduler knobs (defaults are fine for production).
# LICENSE_REFRESH_INTERVAL_SECONDS=3600
# LICENSE_REFRESH_STALE_SECONDS=86400
# LICENSE_GRACE_WINDOW_SECONDS=864000   # 10 days

# ─────────────────────────────────────────────────────────────────
# Stripe (cloud only)
# ─────────────────────────────────────────────────────────────────
# Stripe credentials are NOT read from env in production — they are entered
# once in the admin UI (Settings → Integrations → Stripe) and persisted to
# the encrypted configStore. The webhook URL you register in Stripe is:
#   https://<PUBLIC_BASE_URL>/api/stripe/webhook
# Use the matching webhook signing secret (whsec_…) when wiring it up.

# ─────────────────────────────────────────────────────────────────
# OpenTelemetry (traces + metrics → OpenObserve)  [optional]
# ─────────────────────────────────────────────────────────────────
# FULLY OPTIONAL and OFF by default: if OTEL_ENABLED is not 'true' and no
# endpoint is set, the SDK never starts (zero overhead, dev/self-host stay
# clean). Telemetry is exported OFF the request path (background batch export,
# bounded+dropping queues, short export timeout, swallowed errors) so a DOWN or
# SLOW OpenObserve NEVER affects Bee Flow's latency or availability.
#
# OTEL_ENABLED=true
#
# Export routing — pick ONE:
#   (A) direct to OpenObserve (simplest; app holds the OO auth secret):
#       OTEL_EXPORTER_OTLP_ENDPOINT=https://observe.example.com/api/default   # NO trailing slash
#       OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(user:pass)>    # SECRET
#   (B) RECOMMENDED for prod — in-cluster OTel collector (app never holds the OO
#       secret; the collector buffers/retries so the app is fully decoupled from
#       the OpenObserve VM's availability):
#       OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
#       # (no OTEL_EXPORTER_OTLP_HEADERS needed)
#
# OTEL_SERVICE_NAME=beeflow-server
# OTEL_RESOURCE_ATTRIBUTES=k8s.namespace.name=beeflow,k8s.pod.name=$(POD_NAME)
# OTEL_METRIC_EXPORT_INTERVAL_MS=60000
# OTEL_EXPORT_TIMEOUT_MS=8000        # per-attempt export timeout (fail fast if OO hangs)
# OTEL_DISABLE_UNDICI=1              # drop outbound-fetch (LLM call) spans if volume is too high

# ─────────────────────────────────────────────────────────────────
# OpenObserve usage-push (per-org / per-user token + cost)  [optional]
# ─────────────────────────────────────────────────────────────────
# Periodically pushes aggregated ai_usage_log rollups to an OpenObserve stream
# so a dashboard can show token usage + cost per organization and per user.
# OFF by default; a no-op unless USAGE_PUSH_ENABLED=true AND an OpenObserve
# endpoint + hash salt are set. Multi-pod safe (advisory lock → one pod pushes),
# resilient (a down/slow OpenObserve never affects request latency).
# Reuses the OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS above for the ingest URL + auth.
#
# USAGE_PUSH_ENABLED=true
# USAGE_HASH_SALT=<random-secret>    # REQUIRED when enabled — pseudonymizes user ids (no names/emails leave the app)
# USAGE_PUSH_STREAM=ai_usage         # target stream; use e.g. ai_usage_test for local testing on the live instance
# USAGE_PUSH_INTERVAL_MS=900000      # how often to push (default 15 min)
# USAGE_PUSH_BACKFILL_DAYS=7         # on first run, backfill this many days of closed hour buckets
# USAGE_PUSH_GRACE_MS=600000         # only push hour buckets closed longer than this ago (default 10 min)
# USAGE_PUSH_TIMEOUT_MS=8000         # per-request ingest timeout
#
# NB: OpenObserve rejects data older than ZO_INGEST_ALLOWED_UPTO (default 5h).
# For the 7-day backfill (and catch-up after downtime) to be accepted, raise it
# on the OpenObserve instance, e.g. ZO_INGEST_ALLOWED_UPTO=720 (30 days), and
# restart it. Without that, only buckets within the last 5h are ingested.
#
# ── Ops-metrics push (operational / product / security / billing) ──────────────
# Periodic SNAPSHOT of Postgres-backed gauges (queue depths, active users,
# automation runs, KB growth, guardrail/PII, data-sovereignty, Stripe outbox
# backlog, seats, trials) into per-domain OpenObserve streams. Reuses the OTEL
# endpoint + headers above. No-op unless OPS_PUSH_ENABLED=true. Aggregate,
# org-keyed only — carries no per-user data (so no salt needed).
# OPS_PUSH_ENABLED=true               # master switch (default off)
# OPS_PUSH_STREAM_PREFIX=bee          # streams: <prefix>_ops/product/security/billing
# OPS_PUSH_INTERVAL_MS=60000          # snapshot cadence (default 60s)
# OPS_PUSH_TIMEOUT_MS=8000            # per-request ingest timeout
#
# Enabling OTEL_ENABLED=true additionally ships auto-instrumented HTTP/DB/runtime
# metrics + the LLM/agent/MCP/auth/sidecar/embed/job/feature-gate meters to the
# same endpoint's OTLP metrics stream — the Lane-A counterpart to this push.

# ─────────────────────────────────────────────────────────────────
# App Studio over MCP  [optional, off by default]
# ─────────────────────────────────────────────────────────────────
# Exposes the App Studio BUILDER toolset at POST /mcp/studio so an external
# coding agent (Claude Code in VS Code) can author and edit apps in THIS
# instance — instead of writing a template module under appStudio/templates/
# and shipping it in a new API image.
#
# Fully gated: while this is unset, index.js never requires or mounts the
# route, so the path does not exist. Set it to exactly "1".
#
# Behind the flag three more gates still apply: a valid bfmcp.… bearer token
# (the same one /mcp uses), the app_studio licence capability for that user,
# and per-app write access. Mint a token with:
#   node scripts/mint-mcp-token.js --email you@example.com
# STUDIO_MCP_ENABLED=1

# Automations over MCP (POST /mcp/automations) — the automation builder toolset for
# an external coding agent. Behind the flag: the same bfmcp.… bearer token, the
# 'automations' beta feature for that user, and per-automation ownership.
# AUTOMATION_MCP_ENABLED=1

# Model calls dispatched as App Studio action STEPS (ai_extract / ai_generate /
# kb_query). Separate from STUDIO_APP_ACTION_RUN_RPM because one button press
# can legitimately spend a dozen of these — an action that reads a purchase
# order and then loops one AI call per drawing. Sized for one full intake in
# flight (MAX_FILES_PER_INTAKE is 25) plus the calls around the loop.
# STUDIO_APP_AI_STEP_RPM=30
