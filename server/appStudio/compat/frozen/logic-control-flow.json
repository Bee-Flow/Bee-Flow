    "definition": {
      "schemaVersion": 3,
      "meta": {
        "name": "Send us a request",
        "description": "",
        "icon": "Inbox"
      },
      "theme": {
        "primary": "#B45309",
        "radius": "md",
        "density": "comfortable",
        "fontScale": "md",
        "appearance": "light"
      },
      "homeScreenId": "scr_pubfrm",
      "roles": [],
      "screens": [
        {
          "id": "scr_pubfrm",
          "name": "Request",
          "icon": "FilePlus2",
          "showInNav": false,
          "maxWidth": "narrow",
          "sections": [
            {
              "id": "sec_pubfrm",
              "style": {
                "padding": 4,
                "gap": 3,
                "background": "none"
              },
              "children": [
                {
                  "id": "cmp_pubhdr",
                  "type": "heading",
                  "props": {
                    "text": "How can we help?",
                    "level": 1,
                    "accent": "none"
                  },
                  "style": {
                    "span": 12
                  },
                  "visible": true
                },
                {
                  "id": "cmp_pubfrm",
                  "type": "form",
                  "props": {
                    "name": "request",
                    "submitLabel": "Send",
                    "showReset": false,
                    "showSubmit": true,
                    "resetKey": null
                  },
                  "style": {
                    "span": 6,
                    "gap": 3,
                    "padding": 0
                  },
                  "visible": true,
                  "onSubmit": "act_pubsub",
                  "children": [
                    {
                      "id": "cmp_pubnam",
                      "type": "input_text",
                      "props": {
                        "name": "name",
                        "label": "Your name",
                        "placeholder": null,
                        "required": true,
                        "defaultValue": null,
                        "inputType": "text",
                        "valueFrom": {
                          "kind": "static",
                          "value": null
                        }
                      },
                      "style": {
                        "span": 12
                      },
                      "visible": true
                    },
                    {
                      "id": "cmp_pubdet",
                      "type": "input_textarea",
                      "props": {
                        "name": "details",
                        "label": "What do you need?",
                        "placeholder": null,
                        "required": true,
                        "rows": 4,
                        "valueFrom": {
                          "kind": "static",
                          "value": null
                        },
                        "snippets": {
                          "kind": "static",
                          "value": null
                        },
                        "snippetKey": "shortcut",
                        "snippetBody": "body",
                        "snippetLabel": "title"
                      },
                      "style": {
                        "span": 12
                      },
                      "visible": true
                    },
                    {
                      "id": "cmp_pubchk",
                      "type": "input_checkbox",
                      "props": {
                        "name": "urgent",
                        "label": "This is urgent",
                        "defaultChecked": false
                      },
                      "style": {
                        "span": 12
                      },
                      "visible": true
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "scr_pubthx",
          "name": "Thanks",
          "icon": null,
          "showInNav": false,
          "maxWidth": "narrow",
          "sections": [
            {
              "id": "sec_pubthx",
              "style": {
                "padding": 4,
                "gap": 3,
                "background": "none"
              },
              "children": [
                {
                  "id": "cmp_pubthx",
                  "type": "callout",
                  "props": {
                    "title": "Thank you",
                    "text": "We will get back to you.",
                    "textFrom": {
                      "kind": "static",
                      "value": null
                    },
                    "tone": "success",
                    "toneFrom": {
                      "kind": "static",
                      "value": null
                    },
                    "meta": null,
                    "metaFrom": {
                      "kind": "static",
                      "value": null
                    },
                    "collapsible": false
                  },
                  "style": {
                    "span": 12
                  },
                  "visible": true
                }
              ]
            }
          ]
        }
      ],
      "actions": {
        "act_pubsub": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "condition",
              "expr": "form.name == \"\"",
              "then": [
                {
                  "kind": "raise_error",
                  "message": {
                    "kind": "static",
                    "value": "Please fill in your name."
                  },
                  "code": "no_name"
                }
              ],
              "else": []
            },
            {
              "kind": "try",
              "steps": [
                {
                  "kind": "create_record",
                  "resultVar": "created",
                  "retry": {
                    "times": 1,
                    "delayMs": 200
                  }
                },
                {
                  "kind": "condition",
                  "expr": "form.urgent == true",
                  "then": [
                    {
                      "kind": "call_action",
                      "actionId": "act_publog"
                    }
                  ],
                  "else": []
                }
              ],
              "catch": [
                {
                  "kind": "set_variable",
                  "name": "problem",
                  "value": {
                    "kind": "formula",
                    "expr": "error.message"
                  }
                },
                {
                  "kind": "toast",
                  "message": "Sending failed, please try again.",
                  "tone": "danger"
                },
                {
                  "kind": "return"
                }
              ],
              "finally": [
                {
                  "kind": "set_variable",
                  "name": "tries",
                  "value": {
                    "kind": "formula",
                    "expr": "vars.tries + 1"
                  }
                }
              ]
            },
            {
              "kind": "navigate",
              "screenId": "scr_pubthx"
            }
          ]
        },
        "act_publog": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "set_variable",
              "name": "tries",
              "value": {
                "kind": "static",
                "value": 0
              }
            },
            {
              "kind": "while",
              "expr": "vars.tries < 3",
              "steps": [
                {
                  "kind": "set_variable",
                  "name": "tries",
                  "value": {
                    "kind": "formula",
                    "expr": "vars.tries + 1"
                  }
                },
                {
                  "kind": "condition",
                  "expr": "vars.tries == 1",
                  "then": [
                    {
                      "kind": "continue"
                    }
                  ],
                  "else": []
                },
                {
                  "kind": "create_record",
                  "onError": {
                    "steps": [
                      {
                        "kind": "break"
                      }
                    ]
                  }
                }
              ],
              "maxIterations": 5
            },
            {
              "kind": "return",
              "value": {
                "kind": "formula",
                "expr": "vars.tries"
              }
            }
          ]
        }
      },
      "design": {
        "font": "poppins"
      },
      "variables": [
        {
          "name": "tries",
          "label": "tries",
          "type": "number",
          "default": 0,
          "description": ""
        },
        {
          "name": "problem",
          "label": "problem",
          "type": "text",
          "default": "",
          "description": ""
        },
        {
          "name": "closed",
          "label": "closed",
          "type": "number",
          "default": 0,
          "description": ""
        }
      ]
    }
