                  "visible": true
                }
              ]
            }
          ]
        }
      ],
      "actions": {
        "act_pubsub": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "try",
              "steps": [
                {
                  "kind": "parallel",
                  "branches": [
                    {
                      "steps": [
                        {
                          "kind": "create_record",
                          "resultVar": "created",
                          "retry": {
                            "times": 1,
                            "delayMs": 200
                          }
                        }
                      ]
                    },
                    {
                      "steps": [
                        {
                          "kind": "condition",
                          "expr": "form.urgent == true",
                          "then": [
                            {
                              "kind": "call_action",
                              "actionId": "act_publog"
                            }
                          ],
                          "else": []
                        }
                      ]
                    }
                  ],
                  "failFast": true
                }
              ],
              "catch": [
                {
                  "kind": "set_variable",
                  "name": "problem",
                  "value": {
                    "kind": "formula",
                    "expr": "error.message"
                  }
                },
                {
                  "kind": "toast",
                  "message": "Sending failed, please try again.",
                  "tone": "danger"
                },
                {
                  "kind": "return"
                }
              ]
            },
            {
              "kind": "navigate",
              "screenId": "scr_pubthx"
            }
          ]
        },
        "act_publog": {
          "kind": "sequence",
          "steps": [
            {
              "kind": "create_record",
              "onError": {
                "steps": [
                  {
                    "kind": "return",
                    "value": {
                      "kind": "static",
                      "value": 0
                    }
                  }
                ]
              }
            },
            {
              "kind": "set_variable",
              "name": "tries",
              "value": {
                "kind": "formula",
                "expr": "vars.tries + 1"
              }
            },
            {
              "kind": "return",
              "value": {
                "kind": "formula",
                "expr": "vars.tries"
              }
            }
          ]
        }
      },
      "design": {
        "font": "poppins"
