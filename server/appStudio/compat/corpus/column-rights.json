              "read": [
                "lead",
                "auditor"
              ],
              "write": [
                "lead"
              ]
            }
          },
          {
            "id": "fld_tasks07",
            "key": "budget_note",
            "name": "Budget note",
            "type": "computed",
            "required": false,
            "unique": false,
            "computed": {
              "expr": "budget * 2"
            }
          },
          {
            "id": "fld_tasks08",
            "key": "shout",
            "name": "Shout",
            "type": "computed",
            "required": false,
            "unique": false,
            "computed": {
