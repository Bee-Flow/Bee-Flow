            "id": "fld_tasks01",
            "key": "title",
            "name": "Title",
            "type": "text",
            "required": true,
            "unique": false
          },
          {
            "id": "fld_tasks02",
            "key": "team",
            "name": "Team",
            "type": "text",
            "required": false,
            "unique": false
          },
          {
            "id": "fld_tasks03",
            "key": "status",
