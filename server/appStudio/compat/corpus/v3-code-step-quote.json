    "actions": {
      "act_cqquote": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "code",
            "code": "/**\n * A quote for the visitor: the price list, the quantity they asked for and a volume discount.\n */\nfunction main(inputs, ctx) {\n  const item = inputs.items.find((row) => row.name === inputs.product);\n  if (!item) return { ok: false, total: 0, note: \"Unknown product\" };\n  const qty = Math.max(1, Math.floor(Number(inputs.qty) || 1));\n  const tier = qty >= 100 ? 0.15 : qty >= 25 ? 0.05 : 0;\n  const total = Math.round(item.price * qty * (1 - tier) * 100) / 100;\n  ctx.log(\"quote\", item.name, qty, tier);\n  return { ok: true, total, note: tier ? `Volume discount ${tier * 100}%` : \"\" };\n}\n",
            "inputs": {
              "items": {
                "kind": "records",
                "tableId": "tbl_cqitem",
                "limit": 200
              },
              "product": {
                "kind": "formula",
                "expr": "form.product"
              },
              "qty": {
                "kind": "formula",
                "expr": "form.qty"
              }
            },
            "resultVar": "quote",
            "timeoutMs": 2000,
            "onError": {
              "steps": [
                {
                  "kind": "toast",
                  "message": "The quote could not be worked out.",
                  "tone": "danger"
                }
              ],
              "stop": true
            }
          },
          {
            "kind": "condition",
            "expr": "vars.quote.ok == true",
            "then": [
              {
                "kind": "create_record",
                "tableId": "tbl_cqquote",
                "values": {
                  "customer": {
                    "kind": "formula",
                    "expr": "form.customer"
                  },
                  "total": {
                    "kind": "formula",
                    "expr": "vars.quote.total"
                  },
                  "note": {
                    "kind": "formula",
                    "expr": "vars.quote.note"
                  }
                }
              },
              {
                "kind": "navigate",
                "screenId": "scr_cqdone"
              }
            ],
            "else": [
              {
                "kind": "toast",
                "message": "We do not know that product.",
                "tone": "warning"
              }
            ]
          }
        ]
      }
    },
    "homeScreenId": "scr_cqform",
    "publicAccess": {
      "entryScreenId": "scr_cqform",
      "screenIds": [
        "scr_cqform",
        "scr_cqdone"
