              "background": "none"
            },
            "children": [
              {
                "id": "cmp_block002",
                "type": "custom_block",
                "props": {
                  "block": {
                    "template": "<div class=\"hello\"><h2>{{ greeting }}</h2><p>{{ line }}</p><button data-emit=\"hello\">Say hello</button></div>",
                    "css": ".hello{text-align:center}",
                    "inputs": {
                      "greeting": {
                        "kind": "static",
                        "value": "Welcome"
                      },
                      "line": {
                        "kind": "static",
                        "value": "This page is open to everyone."
                      }
                    },
                    "events": {
                      "hello": "act_hello001",
                      "ghost": "act_secret01"
                    }
                  }
                },
                "style": {
                  "span": 12
                },
                "visible": true
              }
            ]
          }
        ]
      }
    ],
    "actions": {
