{
  "about": {
    "source": "hand-made for the custom_block package: a block with records, static and formula inputs, a repeat with a condition, class, title, aria and data-state formulas, inline svg with drawn numbers, a table, details, a wired button and an unwired link; a block in a fixed-height box; a block without content; and on a public screen a block whose template raises one of its two wired events. Definition and data model stored as the canonicalizers write them",
    "captured": "2026-11-11"
  },
  "definition": {
    "schemaVersion": 3,
    "meta": {
      "name": "Custom block",
