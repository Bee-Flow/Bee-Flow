    "screens": [
      {
        "id": "scr_team0001",
        "name": "Team",
        "icon": "Users",
        "showInNav": true,
        "maxWidth": "wide",
        "sections": [
          {
            "id": "sec_team0001",
            "style": {
              "padding": 4,
              "gap": 3,
              "background": "none"
            },
            "children": [
              {
                "id": "cmp_head0001",
                "type": "heading",
                "props": {
                  "text": "Team",
                  "level": 2,
                  "accent": "none"
                },
                "style": {
                  "span": 12
                },
                "visible": true
              },
              {
                "id": "cmp_block001",
                "type": "custom_block",
                "props": {
                  "block": {
                    "template": "<section class=\"team {{ compact ? &quot;team--compact&quot; : &quot;&quot; }}\" aria-label=\"{{ title }}\">\n  <h3>{{ title }}</h3>\n  <p data-if=\"len(rows) == 0\" class=\"empty\">Nobody here yet.</p>\n  <ul class=\"people\">\n    <li data-each=\"rows as person\" data-if=\"person.name\" data-state=\"{{ person.team }}\">\n      <strong>{{ index + 1 }}. {{ person.name }}</strong>\n      <small>{{ person.team ?? \"no team\" }}</small>\n      <button data-emit=\"pick\" data-value=\"person.id\" title=\"Open {{ person.name }}\">Open</button>\n    </li>\n  </ul>\n  <details><summary>How it is counted</summary><p>One bar per person, as wide as the name is long.</p></details>\n  <svg viewbox=\"0 0 100 {{ max(len(rows), 1) * 6 }}\" width=\"200\" role=\"img\" aria-label=\"Name lengths\">\n    <g data-each=\"rows as person\"><rect x=\"0\" y=\"{{ index * 6 }}\" width=\"{{ len(person.name) * 4 }}\" height=\"4\" fill=\"var(--bf-primary)\"></rect></g>\n  </svg>\n  <table><thead><tr><th scope=\"col\">Name</th><th scope=\"col\">Team</th></tr></thead>\n    <tbody><tr data-each=\"rows\"><td>{{ item.name }}</td><td colspan=\"1\">{{ item.team }}</td></tr></tbody></table>\n  <a data-emit=\"later\">Later</a>\n</section>",
                    "css": ".team{padding:12px;border:1px solid var(--bf-border);border-radius:var(--bf-radius);background:var(--bf-surface)}\n.team--compact{padding:4px}\n.people{list-style:none;margin:0;padding:0}\n.people li{display:flex;gap:8px;align-items:center;padding:4px 0}\n.empty{color:var(--bf-text-muted)}\nhtml[data-appearance=\"dark\"] .team{border-color:var(--bf-text-muted)}\n@media (max-width: 400px){.people li{flex-direction:column}}",
                    "inputs": {
                      "rows": {
                        "kind": "records",
                        "tableId": "tbl_people01"
                      },
                      "title": {
                        "kind": "static",
                        "value": "People"
                      },
                      "compact": {
                        "kind": "formula",
                        "expr": "vars.compact"
                      }
                    },
                    "events": {
                      "pick": "act_pick0001",
                      "later": null
                    }
                  }
                },
                "style": {
                  "span": 8
                },
                "visible": true
              },
              {
                "id": "cmp_fixed001",
                "type": "custom_block",
                "props": {
                  "block": {
                    "template": "<p class=\"note\">Picked: <strong>{{ picked }}</strong></p>",
                    "inputs": {
                      "picked": {
                        "kind": "formula",
                        "expr": "vars.picked"
                      }
                    }
                  }
                },
                "style": {
                  "span": 4,
                  "height": "md"
                },
                "visible": true
              },
              {
                "id": "cmp_empty001",
                "type": "custom_block",
                "props": {},
                "style": {
                  "span": 12
                },
                "visible": true
              }
            ]
          }
        ]
      },
      {
        "id": "scr_hello001",
        "name": "Welcome",
        "icon": "Hand",
        "showInNav": false,
        "maxWidth": "narrow",
        "sections": [
          {
