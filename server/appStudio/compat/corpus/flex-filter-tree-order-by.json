  "datasets": [
    {
      "id": "ds_flexdfown",
      "name": "Open or over budget, per owner",
      "tableId": "tbl_flexdf",
      "source": {
        "kind": "table",
        "tableId": "tbl_flexdf"
      },
      "descriptor": {
        "filters": [
          {
            "any": [
              {
                "field": "status",
                "op": "eq",
