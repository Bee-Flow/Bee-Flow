            "children": [
              {
                "id": "cmp_flexdflist",
                "type": "table",
                "props": {
                  "source": {
                    "kind": "records",
                    "tableId": "tbl_flexdf",
                    "filter": [
                      {
                        "field": "archived",
                        "op": "neq",
                        "value": true
                      },
                      {
                        "any": [
                          {
                            "all": [
                              {
                                "field": "status",
                                "op": "eq",
                                "value": "open"
                              },
                              {
                                "field": "spent",
                                "op": "gt",
                                "otherField": "budget"
                              }
                            ]
                          },
                          {
                            "all": [
                              {
                                "field": "owner",
                                "op": "eq",
                                "value": {
                                  "kind": "formula",
                                  "expr": "currentUser.id"
                                }
                              },
                              {
                                "not": {
                                  "field": "status",
                                  "op": "eq",
                                  "value": "done"
                                }
                              }
                            ]
                          }
                        ]
                      },
                      {
                        "not": {
                          "any": [
                            {
                              "field": "name",
                              "op": "startsWith",
                              "value": "Test"
                            },
                            {
                              "field": "name",
                              "op": "isNull"
                            }
                          ]
                        }
                      }
                    ],
                    "orderBy": [
                      {
                        "field": "status",
                        "dir": "asc"
                      },
                      {
                        "field": "due",
                        "dir": "desc"
                      },
                      {
                        "field": "name",
                        "dir": "asc"
                      }
                    ],
                    "limit": 50
                  },
                  "columns": [
                    {
                      "key": "name",
                      "label": "Name"
                    },
                    {
                      "key": "status",
                      "label": "Status"
                    },
                    {
                      "key": "spent",
                      "label": "Spent"
                    },
                    {
                      "key": "budget",
                      "label": "Budget"
                    }
                  ],
                  "emptyText": "Nothing to show yet.",
                  "rowLimit": 25,
                  "look": "default"
                },
                "style": {
                  "span": 12
                },
                "visible": true
              },
              {
                "id": "cmp_flexdfone",
                "type": "table",
                "props": {
                  "source": {
                    "kind": "records",
                    "tableId": "tbl_flexdf",
                    "filter": [
                      {
                        "field": "spent",
                        "op": "gt",
                        "otherField": "budget"
                      }
                    ],
                    "orderBy": [
                      {
                        "field": "spent",
                        "dir": "desc"
                      }
                    ]
                  },
                  "columns": [
                    {
                      "key": "name",
                      "label": "Name"
                    }
                  ],
                  "emptyText": "Nothing to show yet.",
                  "rowLimit": 25,
                  "look": "default"
                },
                "style": {
                  "span": 12
                },
                "visible": true
              },
              {
                "id": "cmp_flexdfagg",
                "type": "table",
                "props": {
                  "source": {
                    "kind": "aggregate",
                    "tableId": "tbl_flexdf",
                    "filter": [
                      {
                        "not": {
                          "all": [
                            {
                              "field": "status",
                              "op": "eq",
                              "value": "done"
                            },
                            {
                              "field": "spent",
                              "op": "lte",
                              "otherField": "budget"
                            }
                          ]
                        }
                      }
                    ],
                    "orderBy": [
                      {
                        "field": "n",
                        "dir": "desc"
                      },
                      {
                        "field": "total",
                        "dir": "desc"
                      },
                      {
                        "field": "status",
                        "dir": "asc"
                      }
                    ],
                    "groupBy": [
                      {
                        "field": "status"
                      }
                    ],
                    "aggregates": [
                      {
                        "fn": "count",
                        "as": "n"
                      },
                      {
                        "fn": "sum",
                        "field": "spent",
                        "as": "total"
                      }
                    ]
                  },
                  "columns": [
                    {
                      "key": "status",
                      "label": "Status"
                    },
                    {
                      "key": "n",
                      "label": "Projects"
                    },
                    {
                      "key": "total",
                      "label": "Spent"
                    }
                  ],
                  "emptyText": "Nothing to show yet.",
                  "rowLimit": 25,
                  "look": "default"
                },
                "style": {
                  "span": 12
                },
                "visible": true
              }
