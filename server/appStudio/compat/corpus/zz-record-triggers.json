{
  "about": {
    "source": "hand-made for package H4 (record triggers): a trigger on new rows, one on a changed field with a condition, one on a table visitors of a public page can write (with the opt-in), one that is switched off, and a button that calls a triggered action and adds the page steps a trigger may not carry",
    "captured": "2026-11-11"
  },
  "definition": {
    "schemaVersion": 3,
    "meta": {
      "name": "Record triggers",
      "description": "Orders that log themselves, started by the server when a row changes.",
      "icon": "Zap"
    },
    "theme": {
      "primary": "#1D4ED8",
      "radius": "md",
      "density": "comfortable",
      "fontScale": "md",
      "appearance": "auto"
    },
    "roles": [],
    "variables": [
      {
        "name": "summary",
        "label": "Summary",
        "type": "text",
        "default": "",
        "description": ""
      }
    ],
    "screens": [
      {
        "id": "scr_home0001",
        "name": "Home",
        "icon": "Home",
        "showInNav": true,
        "maxWidth": "medium",
        "sections": [
          {
            "id": "sec_main0001",
            "style": {
              "padding": 4,
              "gap": 3,
              "background": "none"
            },
            "children": [
              {
                "id": "cmp_head0001",
                "type": "heading",
                "props": {
                  "text": "Orders",
                  "level": 2,
                  "accent": "none"
                },
                "style": {
                  "span": 12
                },
                "visible": true
              },
              {
                "id": "cmp_btn00001",
                "type": "button",
                "props": {
                  "label": "Write the digest now",
                  "variant": "primary",
                  "iconLeft": null,
                  "role": "button",
                  "disabledWhen": null
                },
                "style": {
                  "span": 3
                },
                "visible": true,
                "onClick": "act_button01"
              }
            ]
          }
        ]
      }
    ],
    "actions": {
      "act_digest01": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "ai_generate",
            "prompt": "Summarise what changed today.",
            "documentMode": "auto",
            "output": "text",
            "resultVar": "summary"
          },
          {
            "kind": "create_record",
            "tableId": "tbl_digest01",
            "values": {
              "note": {
                "kind": "formula",
                "expr": "vars.summary.text"
              }
            }
          },
          {
            "kind": "condition",
            "expr": "vars.summary.text != \"\"",
            "then": [
              {
                "kind": "call_action",
                "actionId": "act_shared01"
              }
            ],
            "else": []
          }
        ]
      },
      "act_shared01": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "update_record",
            "tableId": "tbl_digest01",
            "recordId": {
              "kind": "static",
              "value": "r1"
            },
            "values": {
              "note": {
                "kind": "static",
                "value": "seen"
              }
            }
          }
        ]
      },
      "act_button01": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "call_action",
            "actionId": "act_digest01"
          },
          {
            "kind": "toast",
            "message": "Digest written",
            "tone": "info"
          },
          {
            "kind": "refresh"
          }
        ]
      },
      "act_logrow01": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "create_record",
            "tableId": "tbl_log00001",
            "values": {
              "note": {
                "kind": "formula",
                "expr": "trigger.record.event + \" \" + trigger.record.id"
              },
              "by": {
                "kind": "formula",
                "expr": "trigger.record.by"
              }
            }
          }
        ]
      },
      "act_done0001": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "condition",
            "expr": "trigger.record.before.status != \"done\"",
            "then": [
              {
                "kind": "update_record",
                "tableId": "tbl_orders01",
                "recordId": {
                  "kind": "formula",
                  "expr": "trigger.record.id"
                },
                "values": {
                  "closed": {
                    "kind": "formula",
                    "expr": "today"
                  }
                }
              }
            ],
            "else": []
          },
          {
            "kind": "call_action",
            "actionId": "act_logrow01"
          }
        ]
      }
    },
    "homeScreenId": "scr_home0001",
    "triggers": [
      {
        "id": "on_new_order",
        "kind": "record",
        "actionId": "act_logrow01",
        "tableId": "tbl_orders01",
        "on": [
          "create"
        ]
      },
      {
        "id": "on_done",
        "kind": "record",
        "actionId": "act_done0001",
        "tableId": "tbl_orders01",
        "on": [
          "update"
        ],
        "fields": [
          "status"
        ],
        "when": "trigger.record.row.status == \"done\""
      },
      {
        "id": "on_intake",
        "kind": "record",
        "actionId": "act_logrow01",
        "tableId": "tbl_intake01",
        "on": [
          "create"
        ],
        "allowPublicWrites": true
      },
      {
        "id": "on_removed",
        "kind": "record",
        "actionId": "act_logrow01",
        "tableId": "tbl_orders01",
        "on": [
          "delete"
        ],
        "enabled": false
      }
    ]
  },
  "dataModel": {
    "tables": [
      {
        "id": "tbl_digest01",
        "key": "digest",
        "label": "Digest",
        "fields": [
          {
            "key": "note",
            "label": "Note",
            "type": "text"
          }
        ]
      },
      {
        "id": "tbl_orders01",
        "key": "orders",
        "label": "Orders",
        "fields": [
          {
            "key": "title",
            "label": "Title",
            "type": "text"
          },
          {
            "key": "status",
            "label": "Status",
            "type": "text"
          },
          {
            "key": "closed",
            "label": "Closed",
            "type": "date"
          }
        ]
      },
      {
        "id": "tbl_log00001",
        "key": "log",
        "label": "Log",
        "fields": [
          {
            "key": "note",
            "label": "Note",
            "type": "text"
          },
          {
            "key": "by",
            "label": "By",
            "type": "text"
          }
        ]
      },
      {
        "id": "tbl_intake01",
        "key": "intake",
        "label": "Intake",
        "fields": [
          {
            "key": "question",
            "label": "Question",
            "type": "text"
          }
        ],
        "access": {
          "default": "app",
          "roles": {
            "public": {
              "create": true
            }
          },
          "rowFilters": {}
        }
      }
    ]
  }
}
