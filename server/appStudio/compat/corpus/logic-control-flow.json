                },
                "style": {
                  "span": 6,
                  "gap": 3,
                  "padding": 0
                },
                "visible": true,
                "onSubmit": "act_pubsub",
                "children": [
                  {
                    "id": "cmp_pubnam",
                    "type": "input_text",
                    "props": {
                      "name": "name",
                      "label": "Your name",
                      "placeholder": null,
                      "required": true,
                      "defaultValue": null,
                      "inputType": "text",
                      "valueFrom": {
                        "kind": "static",
                        "value": null
                      }
                    },
                    "style": {
                      "span": 12
                    },
                    "visible": true
                  },
                  {
                    "id": "cmp_pubdet",
                    "type": "input_textarea",
                    "props": {
                      "name": "details",
                      "label": "What do you need?",
                      "placeholder": null,
                      "required": true,
                      "rows": 4,
                      "valueFrom": {
                        "kind": "static",
                        "value": null
                      },
                      "snippets": {
                        "kind": "static",
                        "value": null
                      },
                      "snippetKey": "shortcut",
                      "snippetBody": "body",
                      "snippetLabel": "title"
                    },
                    "style": {
                      "span": 12
                    },
                    "visible": true
                  },
                  {
                    "id": "cmp_pubchk",
                    "type": "input_checkbox",
                    "props": {
                      "name": "urgent",
