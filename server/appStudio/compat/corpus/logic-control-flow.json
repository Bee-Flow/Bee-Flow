            },
            "children": [
              {
                "id": "cmp_pubthx",
                "type": "callout",
                "props": {
                  "title": "Thank you",
                  "text": "We will get back to you.",
                  "textFrom": {
                    "kind": "static",
                    "value": null
                  },
                  "tone": "success",
                  "toneFrom": {
                    "kind": "static",
                    "value": null
                  },
                  "meta": null,
                  "metaFrom": {
                    "kind": "static",
                    "value": null
                  },
                  "collapsible": false
                },
                "style": {
                  "span": 12
                },
                "visible": true
              }
            ]
          }
        ]
      },
      {
        "id": "scr_pubbck",
        "name": "Back office",
        "icon": "Inbox",
        "showInNav": true,
        "maxWidth": "wide",
        "sections": [
          {
            "id": "sec_pubbck",
            "style": {
              "padding": 4,
              "gap": 3,
              "background": "none"
            },
            "children": [
              {
                "id": "cmp_pubgrd",
                "type": "data_grid",
                "props": {
                  "source": {
                    "kind": "records",
                    "tableId": "tbl_pubreq",
                    "filter": [
                      {
                        "field": "status",
                        "op": "eq",
                        "value": "new"
                      }
                    ],
                    "sort": [
                      {
                        "field": "created_at",
                        "dir": "desc"
                      }
                    ]
                  },
                  "columns": [
                    {
                      "key": "name",
                      "label": "Name",
                      "format": "text"
                    },
                    {
                      "key": "details",
                      "label": "Details",
                      "format": "text"
                    },
                    {
                      "key": "urgent",
                      "label": "Urgent",
                      "format": "badge"
                    }
                  ],
                  "pageSize": 25,
                  "selectable": "none",
                  "searchable": false,
                  "rowActions": [],
                  "toolbarActions": [],
                  "addRowLabel": null,
                  "addRowActionId": null,
                  "bulkActions": [],
                  "density": "comfortable",
                  "clamp": "off",
                  "rowTone": [],
                  "groupBy": null,
                  "groupOrder": [],
                  "activeWhen": null,
                  "zebra": false,
                  "emptyText": "Nothing to show yet.",
                  "look": "default"
                },
                "style": {
                  "span": 12
                },
                "visible": true,
                "onRowClick": "act_pubcls"
              },
              {
                "id": "cmp_pubcnt",
                "type": "stat",
                "props": {
                  "label": "Urgent requests",
                  "value": {
                    "kind": "aggregate",
                    "tableId": "tbl_pubreq",
                    "filter": [
                      {
                        "field": "urgent",
                        "op": "eq",
                        "value": true
                      }
                    ],
                    "aggregates": [
                      {
                        "fn": "count",
                        "as": "n"
                      }
                    ]
                  },
                  "caption": null,
                  "captionSegments": [],
                  "icon": null,
                  "delta": {
                    "kind": "static",
                    "value": null
                  },
                  "deltaFormat": "number",
                  "trend": {
                    "kind": "static",
                    "value": null
                  },
                  "positiveIsGood": true,
                  "look": "plain"
                },
                "style": {
                  "span": 3
                },
                "visible": true
              }
            ]
          }
        ]
      }
    ],
    "actions": {
      "act_pubsub": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "condition",
            "expr": "form.name == \"\"",
            "then": [
              {
                "kind": "raise_error",
                "message": {
                  "kind": "static",
                  "value": "Please fill in your name."
                },
                "code": "no_name"
              }
            ],
            "else": []
          },
          {
            "kind": "try",
            "steps": [
              {
                "kind": "create_record",
                "tableId": "tbl_pubreq",
                "values": {
                  "name": {
                    "kind": "formula",
                    "expr": "form.name"
                  },
                  "details": {
                    "kind": "formula",
                    "expr": "form.details"
                  },
                  "urgent": {
                    "kind": "formula",
                    "expr": "form.urgent"
                  },
                  "status": {
                    "kind": "static",
                    "value": "new"
                  }
                },
                "resultVar": "created",
                "retry": {
                  "times": 1,
                  "delayMs": 200
                }
              },
              {
                "kind": "condition",
                "expr": "form.urgent == true",
                "then": [
                  {
                    "kind": "call_action",
                    "actionId": "act_publog"
                  }
                ],
                "else": []
              }
            ],
            "catch": [
              {
                "kind": "set_variable",
                "name": "problem",
                "value": {
                  "kind": "formula",
                  "expr": "error.message"
                }
              },
              {
                "kind": "toast",
                "message": "Sending failed, please try again.",
                "tone": "danger"
              },
              {
                "kind": "return"
              }
            ],
            "finally": [
              {
                "kind": "set_variable",
                "name": "tries",
                "value": {
                  "kind": "formula",
                  "expr": "vars.tries + 1"
                }
              }
            ]
          },
          {
            "kind": "navigate",
            "screenId": "scr_pubthx"
          }
        ]
      },
      "act_publog": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "set_variable",
            "name": "tries",
            "value": {
              "kind": "static",
              "value": 0
            }
          },
          {
            "kind": "while",
            "expr": "vars.tries < 3",
            "steps": [
              {
                "kind": "set_variable",
                "name": "tries",
                "value": {
                  "kind": "formula",
                  "expr": "vars.tries + 1"
                }
              },
              {
                "kind": "condition",
                "expr": "vars.tries == 1",
                "then": [
                  {
                    "kind": "continue"
                  }
                ],
                "else": []
              },
              {
                "kind": "create_record",
                "tableId": "tbl_publog",
                "values": {
                  "note": {
                    "kind": "static",
                    "value": "urgent request"
                  }
                },
                "onError": {
                  "steps": [
                    {
                      "kind": "break"
                    }
                  ]
                }
              }
            ],
            "maxIterations": 5
          },
          {
            "kind": "return",
            "value": {
              "kind": "formula",
              "expr": "vars.tries"
            }
          }
        ]
      },
      "act_pubcls": {
        "kind": "sequence",
        "steps": [
          {
            "kind": "try",
            "steps": [
              {
                "kind": "loop",
                "source": {
                  "kind": "static",
                  "value": [
                    1,
                    2,
                    3
                  ]
                },
                "itemVar": "n",
                "steps": [
                  {
                    "kind": "condition",
                    "expr": "vars.n > 2",
                    "then": [
                      {
                        "kind": "break"
                      }
                    ],
                    "else": []
                  },
                  {
                    "kind": "update_record",
                    "tableId": "tbl_pubreq",
                    "recordId": {
                      "kind": "formula",
                      "expr": "item.id"
                    },
                    "values": {
                      "status": {
                        "kind": "static",
                        "value": "closed"
                      }
                    }
                  },
                  {
                    "kind": "set_variable",
                    "name": "closed",
                    "value": {
                      "kind": "formula",
                      "expr": "vars.closed + 1"
                    }
                  }
                ]
              }
            ],
            "finally": [
              {
                "kind": "refresh",
                "tableId": "tbl_pubreq"
              }
            ]
          }
        ]
      }
    },
    "homeScreenId": "scr_pubbck",
    "publicAccess": {
      "entryScreenId": "scr_pubfrm",
      "screenIds": [
        "scr_pubfrm",
        "scr_pubthx"
