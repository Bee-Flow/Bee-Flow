{
  "about": {
    "source": "hand-made for the control-flow step kinds (since 3): return, break, continue, while, raise_error and try with catch and finally, on a public form submit, in a called action and in a back-office action; the public-intake app with new actions, stored as canonicalizeAppDefinition produced it at capture (publish stores canonical bytes)",
    "captured": "2026-11-10"
  },
  "definition": {
    "schemaVersion": 3,
    "meta": {
      "name": "Control flow intake",
      "description": "Public request form with a back office.",
      "icon": "Inbox"
    },
    "theme": {
