        "default": 0,
        "description": ""
      },
      {
        "name": "problem",
        "label": "problem",
        "type": "text",
        "default": "",
        "description": ""
      },
      {
        "name": "closed",
        "label": "closed",
        "type": "number",
        "default": 0,
        "description": ""
      }
    ],
