            "key": "title",
            "name": "Title",
            "type": "text",
            "required": true,
            "unique": false
          },
          {
            "id": "fld_lghsts",
            "key": "status",
            "name": "Status",
            "type": "select",
            "options": [
              {
                "value": "open",
                "label": "Open"
              },
              {
                "value": "done",
                "label": "Done"
              }
            ],
            "required": false,
            "unique": false
          }
        ],
        "access": {
          "default": "app",
          "roles": {},
          "rowFilters": {}
        }
      }
    ],
    "roles": [],
