    { "name": "a longer name that ends in url is not url()", "css": ".a { color: éurl(data:image/x \" ) \" ); } } nav { color: red; } .b { content: \" \"; }", "removed": ["unbalanced }"], "keeps": ["nav { color: red; }"], "drops": [] },
