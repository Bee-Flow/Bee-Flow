    { "name": "scheme-relative", "css": ".a { background: url(//example.test/a.png); }", "removed": ["outside address"], "keeps": [], "drops": ["example.test"] },
    { "name": "asset reference with a path behind it", "css": ".a { background: url(asset:abc/../../x); }", "removed": ["outside address"], "keeps": [], "drops": ["asset:abc"] },
    { "name": "data that is not an image", "css": ".a { background: url(data:text/html,x); }", "removed": ["outside address"], "keeps": [], "drops": ["text/html"] },
    { "name": "escaped url keyword", "css": ".a { background: \\75rl(/api/x); }", "removed": ["outside address"], "keeps": [], "drops": ["/api/x"] },
    { "name": "image-set with a path string", "css": ".a { background: image-set(\"/api/x\" 1x); }", "removed": ["outside address"], "keeps": [], "drops": ["/api/x"] },
