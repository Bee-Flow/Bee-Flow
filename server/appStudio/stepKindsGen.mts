/**
 * Writes server/shared/appDefinition/stepKinds.generated.mjs from the step registry
 * (componentSpecs/steps/<kind>.js): what the pure step helpers and the browser need to know
 * about a registry step kind. Run it after adding or changing a registry file, then
 * `npm run gen:shared` (the browser reads the mirrored copy).
 *
 *   node server/appStudio/stepKindsGen.mts           write the file
 *   node server/appStudio/stepKindsGen.mts --check   exit 1 when the file is stale
 *
 * stepRegistry.test.js runs the same comparison, so a stale file fails the server tests.
 */

import fs from 'node:fs';
import { createRequire } from 'node:module';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const nodeRequire = createRequire(import.meta.url);

type Entry = { kind: string };
const registry = nodeRequire('./componentSpecs/stepRegistry.js') as {
    EXTENSION_STEP_ENTRIES: readonly Entry[];
    stepFlowProjection: (entries: readonly Entry[]) => Record<string, unknown>;
};

export const STEP_KINDS_FILE = path.join(path.dirname(fileURLToPath(import.meta.url)), '..', 'shared', 'appDefinition', 'stepKinds.generated.mjs');

const HEADER = `// @typecheck strict
/**
 * GENERATED by server/appStudio/stepKindsGen.mts from the step registry
 * (server/appStudio/componentSpecs/steps/<kind>.js). Do not edit: change the
 * registry file, run \`node server/appStudio/stepKindsGen.mts\`, then
 * \`npm run gen:shared\`.
 *
 * What the pure step helpers (stepFlow.mjs) and the browser need to know about
 * a registry step kind: where it holds child steps, whether a failed step may
 * be tried again, and whether it runs on the server.
 */

/** @type {Readonly<Record<string, { childSlots: readonly { field: string, each?: string, walked?: boolean }[], retrySafe: boolean, server: boolean }>>} */
`;

/** The text of the generated file for these registry entries. */
export function renderStepKindsFile(entries: readonly Entry[] = registry.EXTENSION_STEP_ENTRIES): string {
    return `${HEADER}export const EXTENSION_STEP_KINDS = Object.freeze(${JSON.stringify(registry.stepFlowProjection(entries), null, 4)});\n`;
}

if (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
    const wanted = renderStepKindsFile();
    const current = fs.existsSync(STEP_KINDS_FILE) ? fs.readFileSync(STEP_KINDS_FILE, 'utf8') : '';
    if (process.argv.includes('--check')) {
        if (current !== wanted) {
            process.stderr.write('stepKinds.generated.mjs is stale: run `node server/appStudio/stepKindsGen.mts`, then `npm run gen:shared`.\n');
            process.exit(1);
        }
    } else if (current !== wanted) {
        fs.writeFileSync(STEP_KINDS_FILE, wanted);
        process.stdout.write('wrote server/shared/appDefinition/stepKinds.generated.mjs\n');
    }
}
