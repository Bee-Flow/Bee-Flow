{
  "flows": [
    {
      "flowPath": "f/ops/invoice_intake",
      "automation": {
        "title": "Invoice intake",
        "description": "A PDF lands in the Invoices folder; read it and tell the team.",
        "triggerType": "app_event",
        "scheduleCron": null,
        "scheduleTz": null
      },
      "definition": {
        "trigger": {
          "id": "trg",
          "type": "trigger",
          "kind": "app_event",
          "label": "Nextcloud: file.new",
          "appEvent": {
            "provider": "nextcloud",
            "event": "file.new",
            "filter": {
              "inFolder": "/Invoices",
              "expr": "trigger.actor == \"office\""
            }
          }
        },
        "steps": [
          {
            "id": "name",
            "type": "code",
            "label": "File name",
            "code": "/**\n * File name\n * @param {*} inputs.path - path\n */\nasync function main(inputs, ctx) {\n    async function __wm_main(path) {\n      const parts = path.split(\"/\");\n      return parts[parts.length - 1];\n    }\n    return __wm_main(inputs.path);\n}\n",
            "inputs": {
              "path": {
                "kind": "ref",
                "path": "trigger.output.path"
              }
            },
            "allowedHosts": []
          },
          {
            "id": "read",
            "type": "integration_action",
            "label": "Get file content",
            "tool": "nextcloud_read_file",
            "inputs": {
              "path": {
                "kind": "ref",
                "path": "trigger.output.path"
              }
            },
            "retry": {
              "max": 3,
              "backoffMs": 10000
            }
          },
          {
            "id": "post",
            "type": "integration_action",
            "label": "Tell the team",
            "tool": "nextcloud_talk_send_message",
            "inputs": {
              "token": {
                "kind": "literal",
                "value": "room-token-to-pick"
              },
              "message": {
                "kind": "expr",
                "value": "(\"New invoice: \" + toStr(steps.name.output.result) + \" (\" + toStr(len(steps.read.output.content)) + \" characters)\")"
              }
            }
          }
        ],
        "edges": [
          {
            "from": "trg",
            "to": "name"
          },
          {
            "from": "name",
            "to": "read"
          },
          {
            "from": "read",
            "to": "post"
          },
          {
            "from": "trg_2",
            "to": "name"
          }
        ],
        "triggers": [
          {
            "id": "trg_2",
            "type": "trigger",
            "kind": "schedule",
            "label": "Schedule",
            "schedule": {
              "cron": "0 7 * * 1-5",
              "tz": "Europe/Amsterdam"
            }
          }
        ],
        "vars": {
          "folder": "/Invoices"
        }
      },
      "report": {
        "flowPath": "f/ops/invoice_intake",
        "modules": [
          {
            "wmId": "name",
            "summary": "File name",
            "source": "rawscript:bun",
            "status": "shim",
            "confidence": "medium",
            "reason": "Plain script without packages: it runs as a code step.",
            "stepIds": [
              "name"
            ]
          },
          {
            "wmId": "read",
            "summary": "Get file content",
            "source": "script:hub/28150/nextcloud/nextcloud_webdav:_get_file_content",
            "status": "mapped",
            "confidence": "medium",
            "reason": "Known Nextcloud Hub script.",
            "stepIds": [
              "read"
            ]
          },
          {
            "wmId": "post",
