            "code": "/**\n * Map the fields\n * @param {*} inputs.columns - columns\n * @param {*} inputs.values - values\n */\nasync function main(inputs, ctx) {\n    async function __wm_main(columns, values) {\n      const out = {};\n      for (const col of columns) if (values[col.title]) out[col.id] = values[col.title];\n      return out;\n    }\n    return __wm_main(inputs.columns, inputs.values);\n}\n",
