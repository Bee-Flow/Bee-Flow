{
  "flows": [
    {
      "flowPath": "f/fixtures/expense-claim.flow",
      "automation": {
        "title": "Expense claim",
        "description": "A claim form with receipts: file them, read them, share the folder.",
        "triggerType": "app_event",
        "scheduleCron": null,
        "scheduleTz": null
      },
      "definition": {
        "trigger": {
          "id": "trg",
          "type": "trigger",
          "kind": "app_event",
          "label": "Nextcloud: forms.submitted",
          "appEvent": {
            "provider": "nextcloud",
            "event": "forms.submitted",
            "filter": {}
          }
        },
        "steps": [
          {
            "id": "submission",
            "type": "integration_action",
            "label": "Get the form submission",
            "tool": "nextcloud_forms_get_submissions",
            "inputs": {
              "formId": {
                "kind": "ref",
                "path": "trigger.output.formId"
              },
              "submissionId": {
                "kind": "ref",
                "path": "trigger.output.submissionId"
              }
            }
          },
          {
            "id": "folder_name",
            "type": "code",
            "label": "Folder name",
            "code": "/**\n * Folder name\n * @param {*} inputs.userId - userId\n */\nasync function main(inputs, ctx) {\n    async function __wm_main(userId) {\n      return `/Expenses/Claim of ${userId} ${(/* @__PURE__ */ new Date()).toISOString().slice(0, 10)}`;\n    }\n    return __wm_main(inputs.userId);\n}\n",
            "inputs": {
              "userId": {
                "kind": "ref",
                "path": "trigger.output.actor"
              }
            },
            "allowedHosts": []
          },
          {
            "id": "folder",
            "type": "integration_action",
            "label": "Create folder",
            "tool": "nextcloud_create_folder",
            "inputs": {
              "path": {
                "kind": "ref",
                "path": "steps.folder_name.output.result"
              }
            }
          },
          {
            "id": "receipts",
            "type": "parallel",
            "label": "In parallel",
            "branches": [
              [
                {
                  "id": "each_receipt",
                  "type": "stop_error",
                  "label": "Windmill: each_receipt (still to convert)",
                  "message": "This Windmill step has not been converted yet: The result of \"submission\" has a different shape in Bee Flow; submission.answers cannot be found in it."
                }
              ],
              [
                {
                  "id": "dates",
                  "type": "stop_error",
                  "label": "Windmill: Analyze image (still to convert)",
                  "message": "This Windmill step has not been converted yet: Images to AI is off for this organisation, so the builder reads the text of the images (OCR) and works from that."
                }
              ]
            ],
            "failOnAnyBranchError": true
          },
          {
            "id": "requester",
            "type": "integration_action",
            "label": "About the requester",
            "tool": "nextcloud_get_user",
            "inputs": {
              "userId": {
                "kind": "ref",
                "path": "steps.submission.output.submissions[0].userId"
              }
            }
          },
          {
            "id": "tag",
            "type": "integration_action",
            "label": "Tag the folder",
            "tool": "nextcloud_tag_file",
            "inputs": {
              "fileId": {
                "kind": "literal",
                "value": 4242
              },
              "tagId": {
                "kind": "literal",
                "value": 5
              }
            }
          },
          {
            "id": "people",
            "type": "code",
            "label": "Who gets the folder",
            "code": "/**\n * Who gets the folder\n * @param {*} inputs.requester - requester\n * @param {*} inputs.manager - manager\n */\nasync function main(inputs, ctx) {\n    async function __wm_main(requester, manager) {\n      const out = [requester];\n      if (manager) out.push(manager);\n      return out;\n    }\n    return __wm_main(inputs.requester, inputs.manager);\n}\n",
            "inputs": {
              "requester": {
                "kind": "ref",
                "path": "trigger.output.actor"
              },
              "manager": {
                "kind": "ref",
                "path": "steps.requester.output.manager"
              }
            },
            "allowedHosts": []
          },
          {
            "id": "share",
            "type": "integration_action",
            "label": "Share the folder",
            "tool": "nextcloud_share_with_user",
            "inputs": {
              "path": {
                "kind": "ref",
                "path": "steps.folder_name.output.result"
              },
              "shareWith": {
                "kind": "ref",
                "path": "loop.item"
              }
            },
            "forEach": {
              "overRef": "steps.people.output.result",
              "itemVar": "item",
              "maxIterations": 1000
            }
          },
          {
            "id": "notify",
            "type": "integration_action",
            "label": "Tell the requester",
            "tool": "nextcloud_notifications_send",
            "inputs": {
              "userId": {
                "kind": "ref",
                "path": "trigger.output.actor"
              },
              "shortMessage": {
                "kind": "literal",
                "value": "Expense claim filed"
              },
              "longMessage": {
                "kind": "literal",
                "value": "Your claim and receipts are in the shared folder."
              }
            }
          }
        ],
        "edges": [
          {
            "from": "trg",
            "to": "submission"
          },
          {
            "from": "submission",
            "to": "folder_name"
          },
          {
            "from": "folder_name",
