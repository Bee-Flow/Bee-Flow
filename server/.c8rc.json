{
  "all": true,
  "src": ["."],
  "extension": [".js", ".mjs", ".mts"],
  "include": ["**/*.js", "**/*.mjs", "**/*.mts"],
  "exclude": [
    "**/*.test.js",
    "**/*.test.mjs",
    "**/*.test.mts",
    "node_modules/**",
    "coverage/**",
    "scripts/**",
    "testUtils/**",
    "migrations/**"
  ],
  "reporter": ["text-summary", "lcov", "json-summary"],
  "reports-dir": "coverage"
}
