# Public-repo .gitignore.
#
# This file lives at server/.gitignore in the monorepo and is lifted to
# the root of Bee-Flow/beeflow by the filter-repo sync. The monorepo's
# own .gitignore at the parent dir does NOT travel to the public repo,
# so anything we want ignored on the public repo must be listed here.

# ── Dependencies ────────────────────────────────────────────────
node_modules/
__pycache__/
*.pyc

# ── Environment / Secrets ───────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.services
.env.portainer*
.install-env*
.install-config*
.install-log*

# ── SSH Keys & Credentials ──────────────────────────────────────
*.ppk
*.pem
*.key
ssh-key-*
*-vpn-key*
config.json

# Seed/test users — bcrypt hashes are offline-crackable, never commit
config/users.json
config/users.*.json
data/users.json

# Benchmark / scratch files at root — typically contain real-looking PII
test-bench-*.js
test-huge*.js
retry-test*.js
bench-*.js
scratch-*.js

# ── Databases ───────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
data/
# `data/` above is un-anchored, so it also matches migrations/data/, where
# scripts/mergeComplianceKeys.mjs writes the generated Dutch map the
# compliance-centre translation migration (and its test) reads. The file
# existed on every developer's disk and never reached CI. Re-include the
# DIRECTORY by name — git will not descend into an excluded directory to
# evaluate a pattern for the files under it. server/data/ (uploads) stays out.
!migrations/data/

# ── Backups & Archives ──────────────────────────────────────────
backups/
*.zip
*.tar.gz
*.tgz

# ── Build Artifacts ─────────────────────────────────────────────
dist/

# ── Logs ────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ── OS / Editor ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ── Vendored build artefacts (staged by CI / build:runtime, never committed —
#    a committed copy would silently drift from its agent-hub source) ────────
vendor/app-runtime/

# ── Docker runtime data ─────────────────────────────────────────
docker-data/
pgdata/

# ── Tests / coverage ────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
tmp/

# ── Deploy scripts (operator-specific, often contain creds) ─────
deploy-*.sh
deploy/
test-services.sh
