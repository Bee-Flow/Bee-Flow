# Signed package artifacts produced by scripts/pack.mjs + sign.mjs
dist/

# Per-module BUILD OUTPUTS — regenerated by scripts/build.mjs / pack.mjs / sign.mjs.
# Commit the SOURCE only (module.manifest.json, package.json, server/src, frontend/src,
# assets, test); these are derived and cause churn if tracked.
modules/*/manifest.json
modules/*/integrity.json
modules/*/signature.jws
modules/*/server/entry.cjs
modules/*/frontend/index.js
modules/*/frontend/index.css
