{
  // JSDoc type checking of the plain JS, no build step: `npm run typecheck`. Starts loose;
  // tsconfig.strict.json is counted by scripts/tsc-error-ratchet.mjs (.tsc-strict-ratchet.json).
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "node20",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["scripts/**/*.mjs", "modules/*/server/src/**/*.js", "test-kit/**/*.js"],
  "exclude": ["**/node_modules", "**/*.test.*"]
}
