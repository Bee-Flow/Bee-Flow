# Bee Flow Configuration
# Copy this to .env and fill in your values

# Session secret (REQUIRED — the server fails to boot without it).
# Generate one:  openssl rand -hex 32
SESSION_SECRET=

# Session lifetime. The default is a FIXED 30-day window from sign-in, not an
# inactivity timeout — set SESSION_ROLLING=true if your access-control policy
# describes inactivity (most do). SESSION_MAX_AGE_DAYS accepts fractions
# (0.5 = 12 hours) and is capped at 365; an unparseable value falls back to 30.
# SESSION_MAX_AGE_DAYS=30
# SESSION_ROLLING=false

# Retention for the sign-in and access-control trail (access_audit_log).
# OFF by default — these rows are ISO A.8.15 evidence and deleting them cannot
# be undone, so nothing is purged until you set this. Below 365 is raised to
# 365; an unreadable value keeps everything. Leaving it unset keeps IP
# addresses indefinitely, which GDPR minimisation argues against.
# ACCESS_AUDIT_RETENTION_DAYS=730

# Deployment mode: 'cloud' (Bee Flow SaaS — Stripe subscriptions, product
# website) or 'self-hosted' (customer-run — licence keys, no Stripe/billing,
# Community tier by default). These are the only two valid values.
DEPLOYMENT_MODE=self-hosted

# Set to 'false' to disable new account self-registration (sign-up button hidden)
ALLOW_SIGNUPS=true

# Set to 'false' to disable username/password login (SSO-only mode; admin login still works)
ALLOW_PASSWORD_LOGIN=true

# ── Authentication abuse resistance ───────────────────────────────────────────
# All of these have working defaults; they are listed so the knobs are findable.
# See server/auth/loginThrottle.js and server/auth/authRateLimits.js.
#
# The PRIMARY control counts consecutive FAILED sign-ins per submitted
# identifier and locks it for 1m → 5m → 15m → 1h as the attempts repeat. It is
# keyed on the string that was typed, whether or not it names a real account, so
# it can never become an account-existence oracle.
# LOGIN_THROTTLE_ENABLED=true
# LOGIN_MAX_FAILURES_PER_ACCOUNT=10
# LOGIN_FAILURE_WINDOW_MS=900000
#
# The per-source backstop — the password-SPRAY half. Per-account limits are
# structurally blind to one password tried against forty accounts, so this
# counts failures and DISTINCT identifiers per source address.
#
# What it does depends on whether the peer address identifies a real client. A
# private/loopback peer means a proxy is not forwarding the visitor IP (an L4
# load balancer without PROXY protocol), so every visitor shares one bucket:
#   • real client address  → hard 429 block at LOGIN_MAX_FAILURES_PER_IP;
#   • shared/unknown address → a growing DELAY on failed sign-ins only.
# Successful sign-ins are never delayed, so a whole tenant base behind one load
# balancer is slowed at worst, never locked out.
# LOGIN_THROTTLE_IP_ENABLED=true
# LOGIN_MAX_FAILURES_PER_IP=100
# LOGIN_IP_DELAY_AFTER_FAILURES=10
# LOGIN_IP_DELAY_AFTER_IDENTIFIERS=5      # the spray signature
# LOGIN_IP_DELAY_MAX_MS=5000
#
# Every failed sign-in takes at least this long, whatever branch produced it.
# Removes the residual timing variance between the cost-12 admin row, cost-10
# user rows and the dummy-hash path. It must EXCEED the slowest of those or it
# equalises nothing: a cost-12 compare alone is ~233 ms on modest hardware and
# ~327 ms end to end, so 250 ms left the admin username measurably slow. Raise
# this if you run slower hardware or a higher bcrypt cost. Set to 0 to disable.
# LOGIN_MIN_RESPONSE_MS=450
#
# Coarse per-IP request caps (hard caps, real client addresses only).
# AUTH_LOGIN_IP_MAX=60          # per 5 minutes
# AUTH_SIGNUP_IP_MAX=10         # per hour
# AUTH_FORGOT_IP_MAX=20         # per 15 minutes
# AUTH_RESEND_IP_MAX=10         # per 15 minutes
# AUTH_RESET_IP_MAX=20          # per 15 minutes
#
# Target-keyed caps. These key on the e-mail/username the caller ASKED FOR, so
# they bound e-mail bombing and repeat-signup abuse even when the client IP is
# not visible. Keyed on the submitted string, never on a resolved account, so
# they cannot become an account-existence oracle.
# AUTH_FORGOT_TARGET_MAX=3      # reset mails per address per hour
# AUTH_RESEND_TARGET_MAX=3      # verification mails per address per hour
# AUTH_SIGNUP_TARGET_MAX=5      # signups per address per hour

# ── Password policy ───────────────────────────────────────────────────────────
# A bundled deny-list of common/breached passwords is ALWAYS enforced (see
# server/auth/commonPasswords.js). Set this to 'hibp' to additionally check
# Have I Been Pwned. That is an outbound call, so it is off by default — the
# protocol is k-anonymity (only the first 5 characters of the password's SHA-1
# hash are sent, never the password), and it fails open if unreachable.
# PASSWORD_BREACH_CHECK=hibp

# ── Signup bot challenge ──────────────────────────────────────────────────────
# Off unless BOTH a provider and a secret are set. Anonymous tenant creation is
# otherwise unlimited, and every tenant carries an LLM quota that costs money.
# Provider: turnstile | hcaptcha | recaptcha
# SIGNUP_CAPTCHA_PROVIDER=turnstile
# SIGNUP_CAPTCHA_SECRET=
# SIGNUP_CAPTCHA_SITE_KEY=            # public — served to the SPA
# SIGNUP_CAPTCHA_FAIL_OPEN=false      # true = allow signups when the verifier is down
# Enabling a provider ALSO requires its origins in the frontend CSP, or the
# widget silently fails to load and signup becomes impossible:
#   CAPTCHA_ORIGIN=https://challenges.cloudflare.com
#   CAPTCHA_ORIGIN=https://js.hcaptcha.com https://newassets.hcaptcha.com
#   CAPTCHA_ORIGIN=https://www.google.com https://www.gstatic.com
CAPTCHA_ORIGIN=

# Google Tag Manager origin for the frontend CSP. Leave EMPTY unless this
# deployment actually runs Google Analytics: a GTM container can be configured
# to inject arbitrary script, so allow-listing it grants script execution to
# whoever controls that container.
#   GA_ORIGIN=https://www.googletagmanager.com
GA_ORIGIN=

# Contact address published in /.well-known/security.txt. Defaults to
# security@<CLIENT_PUBLIC_HOST domain>, so a self-hosted install advertises its
# own address rather than Bee Flow's.
#
# There is deliberately no fallback beyond that: an install whose host has no
# routable mail domain (localhost, an IP, a bare hostname) serves 404
# {"error":"Not configured"} rather than pointing security researchers at
# someone else's inbox. That is the correct answer, not a broken one — but it
# means a LOCAL stack publishes no security.txt unless you set this explicitly.
# SECURITY_TXT_CONTACT=security@example.com

# Server
SERVER_PORT=3001
# Which host interface publishes SERVER_PORT. Loopback by default: the API is
# meant to be reached through the agent-hub nginx, which is where the rate
# limits and security headers live — a 0.0.0.0 binding lets anyone on the
# network call /auth/* and /api/* directly and skip that layer entirely.
#
# NOTE FOR TESTING: with the default, http://localhost:3001 still answers, and
# that is what a loopback binding means — it serves the loopback interface.
# Three assessments in a row have filed "backend directly reachable" after
# probing from localhost. The check that distinguishes a loopback binding from
# an exposed one is to probe the host's LAN address (e.g. 192.168.x.x:3001),
# which refuses, while :5176 on the same address answers.
# Set to 0.0.0.0 only if something outside this machine must talk to the API
# port itself (an external reverse proxy, an inbound webhook, or a frontend
# built with VITE_API_URL pointing at SERVER_PUBLIC_HOST).
SERVER_BIND_HOST=127.0.0.1
SERVER_PROTOCOL=http
SERVER_PUBLIC_HOST=localhost:3001

# Client
CLIENT_PORT=5176
CLIENT_PROTOCOL=http
CLIENT_PUBLIC_HOST=localhost:5176
VITE_API_URL=

# PostgreSQL (required)
# CORE_DATABASE_URL is the connection string the server's runtime pool actually
# reads (server/db.js); unset, it silently falls back to
# postgresql://beeflow:beeflow@localhost:5432/beeflow_core. The stack uses three
# databases: beeflow_core (this one — users, agents, configs, conversations),
# beeflow_tasks and monitoring_db (compose provisions all three).
CORE_DATABASE_URL=postgresql://beeflow:beeflow@localhost:5432/beeflow_core
# DATABASE_URL is read only by the maintenance script
# server/scripts/deleteOrgs.js — not by the running server.
# DATABASE_URL=postgresql://beeflow:beeflow@localhost:5432/beeflow_tasks

# Required by docker-compose.yml itself (postgres + rustfs containers use :?
# interpolation, so the stack refuses to start without them). No defaults —
# generate your own:  openssl rand -hex 24
DB_PASSWORD=
RUSTFS_SECRET_KEY=

# Encryption (required — generate unique values)
MASTER_ENCRYPTION_KEY=<generate-a-64-char-hex-key>
# OPAQUE_SERVER_SETUP=  # Generate with: node server/scripts/generate-opaque-setup.js (changing it invalidates existing OPAQUE registrations)

# Feature flags
ENABLE_TASKS=false
ENABLE_MONITORING=false

# System knowledge bases
# Set to 'true' to skip the Dutch legal sources auto-seed + weekly refresh on
# boot. The seed is CPU-bound and can take many minutes on a fresh DB; handy
# for local dev. Leave unset/false in production.
# SKIP_SYSTEM_KB_SEED=false
# Override the weekly refresh interval (ms); default is 7 days.
# SYSTEM_KB_REFRESH_INTERVAL_MS=604800000

# CORS
CORS_ORIGIN=http://localhost:5176

# Security keys (YubiKey / FIDO2) as a second factor. A key only works on the
# relying-party ID it was registered under: by default the page's host, or
# CLIENT_PUBLIC_HOST when the page is on a subdomain of it. Set this to pin that
# parent domain (e.g. example.com for both example.com and app.example.com).
# Changing it later makes existing keys unusable; users fall back to their
# other factors or their recovery codes.
# WEBAUTHN_RP_ID=

# Nextcloud integration (optional)
# NEXTCLOUD_URL=https://your-nextcloud-instance.com
# NEXTCLOUD_CLIENT_ID=your-client-id
# NEXTCLOUD_CLIENT_SECRET=your-client-secret

# Reranker — Azure Cohere (recommended; takes priority over local sidecar)
# AZURE_RERANKER_ENDPOINT=https://your-resource.services.ai.azure.com
# AZURE_RERANKER_KEY=your-azure-api-key
# AZURE_RERANKER_MODEL=Cohere-rerank-v4.0-fast

# Reranker — Local sidecar (fallback if Azure not configured)
# RERANKER_URL=http://beeflow-reranker:8000

# Website analytics (Umami) — opt-in 'analytics' compose profile.
# Required to enable the analytics container; the URL + admin credentials are
# otherwise configured in Admin ▸ Website Analytics ▸ Settings.
# UMAMI_APP_SECRET=generate-a-long-random-string
# UMAMI_URL=http://umami:3000              # server→Umami API base (internal)
# UMAMI_PUBLIC_URL=https://stats.example.com  # browser script origin (optional; admin UI usually sets this)
# Content-Security-Policy source for the tracker script, passed to the frontend
# container. Required for ANY external analytics origin — http AND https. The
# CSP used to allow scripts from any https host, which made a public stats
# domain work without configuration (and any other https host too); script-src
# now lists only the origins the app actually loads code from. Leave empty when
# analytics is off; without it the tracker is blocked and collects nothing.
# ANALYTICS_ORIGIN=https://stats.example.com

# Extra origins the BROWSER may open connections to (fetch/XHR/EventSource),
# appended to the frontend CSP's connect-src.
#
# connect-src used to end in a blanket `https: wss:`, which let the page POST
# anything it could read to any host on the internet — most of what an XSS
# wants. It is now an explicit list: 'self' (all API calls), the telemetry
# beacon, ANALYTICS_ORIGIN, and whatever you put here. Space-separated.
#
# Set this if you point the app at an endpoint of your own and the browser
# talks to it directly. The symptom of a missing entry is a feature that
# silently does nothing, with "Refused to connect" in the browser console.
# EXTRA_CONNECT_SRC=https://api.example.com wss://realtime.example.com

# ── Headless browser (PDF export, thumbnails, SPA ingestion, browse_web) ──────
# The server image carries no Chromium; it drives a remote Playwright server.
# The compose files run one as the `browser` sidecar on a network it shares
# only with the server, and point the server at it. Without a reachable
# browser, notebook PDF export answers 503 "PDF export is not available on
# this server" and browse_web is not offered.
#
# BROWSER_WS_PATH — the sidecar's private path (ws://browser:9222/<path>).
# Playwright's server has no authentication, so treat it as a secret:
#   openssl rand -hex 24      (selfhost.sh generates it)
# Unset, the compose files fall back to a fixed, guessable default.
# BROWSER_WS_PATH=
#
# BROWSER_WS_ENDPOINT — where the server connects. The compose files derive it
# from BROWSER_WS_PATH; set it only to use an external Playwright server
# (same Playwright version as the server, see scripts/check-playwright-lockstep.mjs).
# Left empty outside compose, the server starts a `bf-browser` container
# itself over the Docker socket (/var/run/docker.sock mounted, and the server
# user in the socket's group: group_add with its gid).
# BROWSER_WS_ENDPOINT=ws://browser:9222/<BROWSER_WS_PATH>
#
# BROWSER_MEMORY_LIMIT — memory cap of the sidecar (compose mem_limit).
# BROWSER_MEMORY_LIMIT=1g
# BROWSER_IMAGE — the sidecar image. docker-compose.from-registry.yml defaults
# it to pwt-runner at the server's own TAG, so the two Playwright versions move
# together; docker-compose.yml and .install.yml build it from server/pwt-runner.
# docker-compose.dockerhub.yml defaults to ghcr :latest: pin it to
# ghcr.io/bee-flow/pwt-runner:sha-<commit> whenever you pin TAG there.
# A runner from another release than the server refuses it (HTTP 428).
# BROWSER_IMAGE=ghcr.io/bee-flow/pwt-runner:sha-<commit>
#
# Docker-socket fallback only, i.e. outside the compose files (they always set
# BROWSER_WS_ENDPOINT; an empty value there still means the sidecar):
# PLAYWRIGHT_RUNNER_IMAGE — the image for the browser container and the Tests
#   Studio runners; unset, the server pulls ghcr.io/bee-flow/pwt-runner
#   (`latest` first in production) or builds server/pwt-runner.
# PLAYWRIGHT_RUNNER_IMAGE=ghcr.io/bee-flow/pwt-runner:latest
# PLAYWRIGHT_RUNNER_IMAGE_TAG=latest
# BROWSER_CONTAINER_MEMORY_MB=1024
# BROWSER_CONTAINER_CPUS=1.0
# How long "Docker is not reachable" is trusted before the server probes again.
# DOCKER_UNAVAILABLE_RETRY_MS=30000
#
# BROWSER_ALLOW_LOCAL_LAUNCH — native development only (`npm start` on a machine
# with `npx playwright install chromium` done). Launches a browser in the
# server process when no remote one is reachable. Never works in the server
# image, which has no browser to launch.
# BROWSER_ALLOW_LOCAL_LAUNCH=true

# ── Edition: which product surfaces this install ships ────────────────────────
# Bee Flow's optional surfaces are registered as built-in platform modules
# (server/modules/catalog.js). Switching one off is a HARD off, independent of
# licence tier: its routes 404, its capabilities disappear from the entitlement
# projection (so the UI stops offering it), and its schedulers never start.
#
# Leave BOTH unset for the full product — that is the default and it is what
# every existing install already does.
#
#   BEEFLOW_EDITION=core        ship core only: chat, agents, knowledge,
#                               integrations, auth/admin, billing, privacy.
#   BEEFLOW_MODULES=a,b,c       explicit allow-list; wins over BEEFLOW_EDITION.
#
# Switchable ids: automation, approvals, apps, compliance, support, webpages,
# notebooks, meetingNotes, learning, projects
#
# Example — core plus automations and approvals, nothing else:
#   BEEFLOW_EDITION=core
#   BEEFLOW_MODULES=automation,approvals
#
# Note: turning a surface off does not drop its tables. Migrations still run,
# so re-enabling is a restart, never a data migration.
# BEEFLOW_EDITION=
# BEEFLOW_MODULES=

# ── App Studio over MCP (developer feature, off by default) ─────────────────
# Mounts POST /mcp/studio, which exposes the App Studio builder toolset to an
# external coding agent (Claude Code in VS Code) so customer apps are authored
# against a running instance instead of shipped as a template in a new image.
# While unset the route is never mounted. Set to exactly "1" to enable, then
# mint a bearer token:
#   docker compose exec server node scripts/mint-mcp-token.js --email you@example.com
# STUDIO_MCP_ENABLED=1

# Automations over MCP: mounts POST /mcp/automations so the same coding agent can
# build AUTOMATIONS in this instance instead of driving the chat builder turn
# by turn. Same shape as the flag above — while unset the route is never
# mounted. Behind it: the same bfmcp.… bearer token and the 'automations' beta
# feature for that user.
# AUTOMATION_MCP_ENABLED=1

# ── Automation kill switches (operator, all off = the feature runs) ────────────
# Three switches that turn a runner feature off for the WHOLE box without
# touching any data or any organisation's settings. Reach for one during an
# incident, not as configuration.
#
# All three share one grammar: 1 / true / on / yes switch the feature OFF.
# Anything else — including the literal 0 and false — leaves it running. So
# "…_DISABLED=0" means "leave it on", which is what it looks like it means.
#
# AUTOMATION_ASK_ONCE_DISABLED — "ask this app only once per run". Steps stop
# reusing an answer within a run and ask the app every time; slower, never
# wrong. Also switches off the durable tier, which rides on top of it.
# AUTOMATION_ASK_ONCE_DISABLED=1
#
# INTEGRATION_CACHE_DISABLED — only the DURABLE tier ("…and keep the answer for
# later runs"). Nothing new is stored and nothing stored is served, whatever an
# organisation's admin has ticked. The per-run reuse above keeps working.
# INTEGRATION_CACHE_DISABLED=1
#
# DATATABLE_RETENTION_DISABLED — the datatable row retention sweep. Rows past
# their table's retention window stop being deleted. That window is a promise
# the product makes to a data subject, and the Studio keeps showing it, so
# switch this off only for as long as the incident lasts.
# DATATABLE_RETENTION_DISABLED=1

# ── Learning Center videos (optional) ───────────────────────────────────────
# Lesson videos are not in git or the images. The server fetches the pack this
# release pins (sha256-checked) from the Bee Flow GitHub release `learn-media`
# shortly after startup. Without a pack, lessons simply play without their video.
# Air-gapped: LEARN_MEDIA_AUTO=off, then `npm run learn-media:fetch -- <tarball>`.
# LEARN_MEDIA_AUTO=off                              # off/false/0: never fetch by itself
# LEARN_MEDIA_SOURCE=https://mirror.example.com/learn-media/   # your own mirror of the release assets
# LEARN_MEDIA_DIR=/srv/beeflow/learn-media          # served at /learn-media/* (default: server/data/learn-media)
# LEARN_MEDIA_PACK_URL=https://example.com/learn-media-2026.10.tar.gz
# LEARN_MEDIA_PACK_SHA256=                          # optional, tarball sha256
# LEARN_MEDIA_BASE_URL=https://cdn.example.com/learn-media   # agent-hub container: load from a CDN

# ── Production checklist ──────────────────────────────────────────────────────
# Operationally significant vars a production install should decide on
# explicitly. CORE_DATABASE_URL is covered above (the server's runtime pool).
#
# Public base URL of the API (https://api.example.com). Also the switch that
# decides whether MS-Graph subscriptions get provisioned at all.
# PUBLIC_BASE_URL=
#
# HMAC key for short-lived webpage-preview tokens. Auto-generated in dev only;
# production MUST set it explicitly (openssl rand -hex 32).
# WEBPAGE_PREVIEW_TOKEN_SECRET=
#
# How many proxies sit in front of the server (default 1). Rate limiting and
# login throttling key on the client IP; behind TWO proxies (e.g. CDN +
# nginx) set this to 2 or every visitor shares one bucket.
# TRUST_PROXY_HOPS=1
#
# Redis read-through cache over the PG session store (optional; PG-only
# sessions without it).
# REDIS_URL=redis://localhost:6379
#
# Object storage (S3-compatible). The compose stack wires these from the
# rustfs container; set them only for an external endpoint.
# RUSTFS_ENDPOINT=https://s3.example.com
# RUSTFS_ACCESS_KEY=
#
# Server log level: error | warn | info | http | debug (default info).
# LOG_LEVEL=info
