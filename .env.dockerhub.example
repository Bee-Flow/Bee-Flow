# ══════════════════════════════════════════════════════════════════
# Bee Flow — self-host from Docker Hub
# ══════════════════════════════════════════════════════════════════
#
#   cp .env.dockerhub.example .env
#   # fill in the four secrets below, then:
#   docker compose -f docker-compose.dockerhub.yml up -d
#
# Then open http://localhost:5176.
# ══════════════════════════════════════════════════════════════════

# ── Images ────────────────────────────────────────────────────────
# Pin TAG to a version in production. `latest` moves with every release, so a
# `docker compose pull` can upgrade you at a moment you did not choose.
#   TAG=2026.08.19-918
REGISTRY=docker.io/beeflowapp
TAG=latest

# ── Secrets — REQUIRED, generate these before the first start ─────
#
#   openssl rand -hex 32     # SESSION_SECRET and MASTER_ENCRYPTION_KEY
#   openssl rand -hex 24     # RUSTFS_SECRET_KEY
#   openssl rand -hex 16     # DB_PASSWORD
#
# On Windows without openssl:
#   powershell -c "-join ((1..32)|%{'{0:x2}' -f (Get-Random -Max 256)})"
#
# BACK UP MASTER_ENCRYPTION_KEY. It is the root key for every stored credential
# — API keys, integration tokens. Lose it and that data cannot be recovered, and
# changing it has the same effect as losing it.
SESSION_SECRET=
MASTER_ENCRYPTION_KEY=
DB_PASSWORD=
RUSTFS_SECRET_KEY=

# ── Addresses ─────────────────────────────────────────────────────
# These drive CORS and cookies. If they do not match the URL people actually
# use, login appears to work and then the session is silently dropped.
#
# Behind a domain and TLS, set:
#   CLIENT_PUBLIC_HOST=beeflow.example.com
#   CLIENT_PROTOCOL=https
#   SERVER_PUBLIC_HOST=beeflow.example.com
#   SERVER_PROTOCOL=https
#   COOKIE_SECURE=true
CLIENT_PUBLIC_HOST=localhost:5176
CLIENT_PROTOCOL=http
SERVER_PUBLIC_HOST=localhost:3001
SERVER_PROTOCOL=http
COOKIE_SECURE=false
# COOKIE_DOMAIN=.example.com          # only when sharing cookies across subdomains

# ── Ports ─────────────────────────────────────────────────────────
CLIENT_PORT=5176
SERVER_PORT=3001
# The API is bound to loopback by default. Change this only if something other
# than the web interface must reach it directly.
SERVER_BIND_HOST=127.0.0.1

# ── Database ──────────────────────────────────────────────────────
DB_USER=beeflow
DB_NAME=beeflow_core

# ── Privacy Shield (optional) ─────────────────────────────────────
# Start it with:  docker compose -f docker-compose.dockerhub.yml --profile guard up -d
#
# Detection needs real CPU. Raise GUARD_MEM to 6g if large documents are refused
# rather than merely slow.
GUARD_CPUS=3
GUARD_MEM=4g
# GUARD_PII_REGIONS=NL,BE,DE          # default `*` = all shipped regions
# SERVICES_API_KEY=                   # shared secret between server and guard

# ── Models (optional) ─────────────────────────────────────────────
# Leave blank and add providers in the admin UI after first login — that stores
# keys encrypted, rather than in this file.
#
# To run models on your own hardware, point at an OpenAI-compatible endpoint:
#   OLLAMA_URL=http://host.docker.internal:11434
LLM_API_URL=
LLM_API_KEY=
OLLAMA_URL=
