{
  "name": "bee-flow-ai-monorepo",
  "private": true,
  "description": "Root workspace for the Bee Flow AI monorepo: dev orchestration, image builds, and secret-scan scripts. The deployable services live in their own directories (see REPO-STRUCTURE.md).",
  "engines": {
    "node": ">=22.15.0 <23.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev:server": "cd server && npm run start",
    "dev:frontend": "cd agent-hub && npm run dev",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "build:dev": "./scripts/build-images.sh build dev",
    "build:prd": "./scripts/build-images.sh build prd",
    "push:dev": "./scripts/build-images.sh push dev",
    "push:prd": "./scripts/build-images.sh push prd",
    "lint:secrets": "./scripts/check-no-test-secrets.sh",
    "lint:deps": "node scripts/audit-ratchet.mjs",
    "lint:deps:test": "node --test scripts/audit-ratchet.test.mjs",
    "lint:budget": "node scripts/eslint-budget.mjs agent-hub && node scripts/eslint-budget.mjs server",
    "lint:ts-ratchet": "node scripts/ts-ratchet.mjs agent-hub",
    "lint:i18n-ratchet": "node scripts/i18n-ratchet.mjs agent-hub",
    "lint:i18n-ratchet-mobile": "node scripts/i18n-ratchet.mjs mobile",
    "lint:i18n-gen": "node scripts/gen-i18n-defaults.mjs --check",
    "lint:shared-mirror": "node scripts/gen-shared-mirror.mjs --check",
    "lint:style-ratchet": "node scripts/count-ratchet.mjs inline-style agent-hub",
    "lint:eslint-disable-ratchet": "node scripts/count-ratchet.mjs eslint-disable agent-hub",
    "lint:fire-event-ratchet": "node scripts/count-ratchet.mjs fire-event agent-hub",
    "lint:explicit-any-ratchet": "node scripts/count-ratchet.mjs explicit-any agent-hub && node scripts/count-ratchet.mjs explicit-any mobile",
    "lint:as-unknown-as-ratchet": "node scripts/count-ratchet.mjs as-unknown-as agent-hub && node scripts/count-ratchet.mjs as-unknown-as mobile",
    "lint:authfetch-effect-ratchet": "node scripts/count-ratchet.mjs authfetch-effect agent-hub",
    "lint:authfetch-outside-api-ratchet": "node scripts/count-ratchet.mjs authfetch-outside-api agent-hub",
    "lint:module-mock-ratchet": "node scripts/count-ratchet.mjs module-mock server",
    "lint:status-5xx-ratchet": "node scripts/count-ratchet.mjs status-5xx server",
    "lint:log-user-content-ratchet": "node scripts/count-ratchet.mjs log-user-content server",
    "lint:error-echo-ratchet": "node scripts/count-ratchet.mjs error-echo server",
    "lint:sse-head-ratchet": "node scripts/count-ratchet.mjs sse-head server",
    "lint:inline-pglite-ratchet": "node scripts/count-ratchet.mjs inline-pglite server",
    "lint:empty-catch-ratchet": "node scripts/count-ratchet.mjs empty-catch server && node scripts/count-ratchet.mjs empty-catch agent-hub",
    "lint:rollback-in-store-ratchet": "node scripts/count-ratchet.mjs rollback-in-store server",
    "lint:db-in-routes-ratchet": "node scripts/count-ratchet.mjs db-in-routes server",
    "lint:long-function-ratchet": "node scripts/count-ratchet.mjs long-function server && node scripts/count-ratchet.mjs long-function agent-hub",
    "lint:local-zod-helper-ratchet": "node scripts/count-ratchet.mjs local-zod-helper server",
    "lint:file-budget": "node scripts/file-budget.mjs server agent-hub desktop guard-service",
    "lint:big-file-ratchet": "node scripts/count-ratchet.mjs big-file agent-hub && node scripts/count-ratchet.mjs big-file server",
    "lint:line-ref-ratchet": "node scripts/count-ratchet.mjs line-ref agent-hub && node scripts/count-ratchet.mjs line-ref server && node scripts/count-ratchet.mjs line-ref mobile",
    "lint:dutch-comment-ratchet": "node scripts/count-ratchet.mjs dutch-comment agent-hub && node scripts/count-ratchet.mjs dutch-comment server",
    "lint:import-zones-ratchet": "node scripts/count-ratchet.mjs import-zones agent-hub",
    "lint:unchecked-mutation-ratchet": "node scripts/count-ratchet.mjs unchecked-mutation agent-hub",
    "lint:source-text": "node scripts/source-text-tests.mjs server --gate",
    "lint:checkjs-ratchet": "node scripts/checkjs-ratchet.mjs server",
    "lint:layering-ratchet": "node --test server/layering.test.js",
    "lint:scc-ratchet": "node scripts/scc-ratchet.mjs server agent-hub mobile",
    "lint:duplication": "node scripts/duplication-ratchet.mjs",
    "lint:bundle": "node scripts/bundle-ratchet.mjs agent-hub",
    "lint:entry-budget": "node scripts/entry-budget.mjs agent-hub",
    "lint:coverage": "node scripts/coverage-ratchet.mjs server && node scripts/coverage-ratchet.mjs agent-hub && node scripts/coverage-ratchet.mjs mobile",
    "lint:gitleaks": "./scripts/scan-secrets.sh",
    "lint:checks": "node scripts/check-required-checks.mjs",
    "lint:duplicated-files": "node scripts/check-duplicated-files.mjs",
    "lint:workflows": "node scripts/check-workflow-concurrency.mjs",
    "lint:legal-catalogue": "node scripts/check-legal-catalogue.mjs",
    "lint:package-registry": "node scripts/check-package-registry.mjs",
    "lint:version-drift": "node scripts/check-version-drift.mjs",
    "lint:editor-bundles": "node scripts/check-editor-bundles.mjs",
    "lint:compose-drift": "node scripts/check-compose-drift.mjs",
    "i18n:gen": "node scripts/gen-i18n-defaults.mjs",
    "learn-media:fetch": "node scripts/learn-media-fetch.mjs",
    "gen:shared": "node scripts/gen-shared-mirror.mjs",
    "count:source-text": "node scripts/source-text-tests.mjs server",
    "check:fast": "node scripts/check-fast.mjs",
    "test:scripts": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "jscpd": "^5.4.1"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  }
}
