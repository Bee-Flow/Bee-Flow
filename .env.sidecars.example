# ══════════════════════════════════════════════════════════════════
# Bee Flow — shared sidecars (.env.sidecars)
# ══════════════════════════════════════════════════════════════════
#
# Configuration of docker-compose.sidecars.yml, run by ./selfhost-sidecars.sh:
# one guard / classifier / Ollama for several Bee Flow stacks on this machine.
# selfhost-sidecars.sh copies this file to .env.sidecars and generates the key.
# ══════════════════════════════════════════════════════════════════

# Same TAG as the stacks that use these sidecars; upgrade the sidecars first.
# TAG=

# Which sidecars to run (saved from the command line, like PROFILES of
# selfhost.sh): guard, classify, local-llm.
PROFILES=guard classify

# The stacks that may use them, by STACK_NAME: one internal network
# `<stack>-sidecars` each. Each stack then starts with
#   SHARED_SIDECARS="guard classify" STACK_NAME=<stack> ./selfhost.sh
SIDECAR_STACKS=public internal

# The key the guard and the classifier require (openssl rand -hex 24).
# Every stack sends it as PII_SERVICE_API_KEY / CLASSIFY_SERVICE_API_KEY; it
# is NOT the SERVICES_API_KEY of a stack (that one stays per stack).
SERVICES_API_KEY=CHANGE_ME

# Sizing. One guard serves every stack: give it the cores the stacks together
# would have given their own guards.
# GUARD_CPUS=4
# GUARD_MEM=4g
# GUARD_PII_MAX_CONCURRENCY=4
# CLASSIFY_CPUS=3
# CLASSIFY_MEM=3g

# The guard sees the text of every stack. WARNING keeps request content out
# of its log; do not lower this on a shared guard.
# GUARD_LOG_LEVEL=WARNING
