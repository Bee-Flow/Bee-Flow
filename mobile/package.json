{
    "name": "@beeflow/mobile",
    "version": "1.1.0",
    "private": true,
    "description": "Bee Flow for Android — the native mobile client for the Bee Flow AI workspace. Built from this monorepo, shipped as an APK.",
    "license": "SEE LICENSE IN ../LICENSE.md",
    "repository": {
        "type": "git",
        "url": "https://github.com/Bee-Flow/Bee-Flow.git",
        "directory": "mobile"
    },
    "main": "expo-router/entry",
    "engines": {
        "node": ">=22.0.0 <23.0.0"
    },
    "packageManager": "npm@10.9.0",
    "scripts": {
        "start": "expo start --dev-client",
        "android": "expo run:android",
        "prebuild": "expo prebuild --platform android --no-install",
        "prebuild:clean": "expo prebuild --platform android --clean --no-install",
        "verify": "npm run typecheck && npm run lint && npm test && npm run verify:native",
        "verify:native": "expo prebuild --platform android --no-install --clean && expo export --platform android --output-dir .verify-bundle",
        "lint": "eslint . --max-warnings 0",
        "lint:cached": "eslint . --max-warnings 0 --cache --cache-strategy content --cache-location .eslintcache",
        "typecheck": "node ./node_modules/typescript-7/bin/tsc --noEmit",
        "test": "jest --ci",
        "test:watch": "jest --watch",
        "sync:tokens": "node scripts/sync-web-tokens.mjs"
    },
    "dependencies": {
        "@dagrejs/dagre": "^3.1.2",
        "@expo-google-fonts/fira-code": "^0.4.1",
        "@expo-google-fonts/geist": "^0.4.2",
        "@expo-google-fonts/ibm-plex-sans": "^0.4.1",
        "@expo-google-fonts/inter": "^0.4.2",
        "@noble/ciphers": "^2.4.0",
        "@noble/curves": "^2.4.0",
        "@noble/hashes": "^2.4.0",
        "@react-native-async-storage/async-storage": "2.2.0",
        "@react-native-community/netinfo": "12.0.1",
        "@tanstack/react-query": "^5.104.5",
        "expo": "57.0.31",
        "expo-application": "~57.0.3",
        "expo-audio": "~57.0.5",
        "expo-auth-session": "~57.0.16",
        "expo-background-task": "~57.0.21",
        "expo-build-properties": "~57.0.22",
        "expo-camera": "~57.0.6",
        "expo-clipboard": "~57.0.2",
        "expo-constants": "~57.0.22",
        "expo-crypto": "~57.0.4",
        "expo-document-picker": "~57.0.3",
        "expo-file-system": "~57.0.7",
        "expo-font": "~57.0.4",
        "expo-haptics": "~57.0.3",
        "expo-image": "~57.0.5",
        "expo-image-manipulator": "~57.0.21",
        "expo-image-picker": "~57.0.20",
        "expo-keep-awake": "~57.0.2",
        "expo-linking": "~57.0.13",
        "expo-local-authentication": "~57.0.3",
        "expo-localization": "~57.0.2",
        "expo-notifications": "~57.0.24",
        "expo-router": "~57.0.29",
        "expo-secure-store": "~57.0.4",
        "expo-share-intent": "^8.0.1",
        "expo-sharing": "~57.0.24",
        "expo-splash-screen": "~57.0.10",
        "expo-status-bar": "~57.0.1",
        "expo-system-ui": "~57.0.4",
        "expo-task-manager": "~57.0.21",
        "expo-web-browser": "~57.0.3",
        "highlight.js": "11.12.0",
        "lucide-react-native": "1.61.0",
        "marked": "18.1.1",
        "mathjax-full": "3.2.2",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-native": "0.86.3",
        "react-native-gesture-handler": "~2.32.0",
        "react-native-reanimated": "4.5.1",
        "react-native-safe-area-context": "~5.7.0",
        "react-native-screens": "~4.26.0",
        "react-native-svg": "15.15.4",
        "react-native-webview": "13.16.2",
        "react-native-worklets": "0.10.1",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@serenity-kit/opaque": "^1.1.0",
        "@testing-library/react-native": "^14.1.0",
        "@types/jest": "^30.0.0",
        "@types/react": "~19.2.0",
        "@types/semver": "^7.8.0",
        "eslint": "^9.39.5",
        "eslint-config-expo": "~57.0.2",
        "jest": "^30.5.2",
        "jest-expo": "~57.0.6",
        "react-test-renderer": "19.2.3",
        "semver": "^7.8.5",
        "typescript": "~5.9.2",
        "typescript-7": "npm:typescript@7.0.2"
    },
    "overrides": {
        "zod": "~4.6.7",
        "shell-quote": "^1.11.0",
        "brace-expansion@1": "^1.1.21",
        "brace-expansion@5": "^5.0.12",
        "speech-rule-engine": {
            "@xmldom/xmldom": "^0.9.12"
        },
        "xcode": {
            "uuid": "^11.1.1"
        }
    },
    "expo": {
        "autolinking": {
            "nativeModulesDir": "./modules"
        }
    }
}
