                    "required": true,
                    "rows": 4,
                    "type": "input_text",
                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "What happened, in one line",
                    "max": null,
                    "min": null,
                    "name": "title",
                    "nodeId": "cmp_rpf2",
                    "options": [],
                    "placeholder": "Mailing sent with every recipient in the To field",
                    "required": true,
                    "rows": 4,
                    "type": "input_text",
                  },
                  {
                    "initial": "confidentiality",
                    "inputType": "text",
                    "label": "Kind of breach",
                    "max": null,
                    "min": null,
                    "name": "breach_type",
                    "nodeId": "cmp_rpf5",
                    "options": [
                      {
                        "label": "Confidentiality — data seen by the wrong people",
                        "value": "confidentiality",
                      },
                      {
                        "label": "Integrity — data altered without authorisation",
                        "value": "integrity",
                      },
                      {
                        "label": "Availability — data lost or unreachable",
                        "value": "availability",
                      },
                    ],
                    "placeholder": null,
                    "required": true,
                    "rows": 4,
                    "type": "input_select",
                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "What we know so far",
                    "max": null,
                    "min": null,
                    "name": "description",
                    "nodeId": "cmp_rpf6",
                    "options": [],
                    "placeholder": "What was exposed, how it came to light, who is involved.",
                    "required": true,
                    "rows": 4,
                    "type": "input_textarea",
                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "Categories of personal data affected (Art. 33(3)(a))",
                    "max": null,
                    "min": null,
                    "name": "data_categories",
                    "nodeId": "cmp_rpf7",
                    "options": [],
                    "placeholder": "Name, e-mail address, order history",
                    "required": false,
                    "rows": 4,
                    "type": "input_text",
                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "People affected (estimate)",
                    "max": 100000000,
                    "min": 0,
                    "name": "people_affected",
                    "nodeId": "cmp_rpf8",
                    "options": [],
                    "placeholder": null,
                    "required": false,
                    "rows": 4,
