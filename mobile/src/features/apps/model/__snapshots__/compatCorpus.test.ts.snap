                "description": null,
                "id": "cmp_nnform",
                "inputs": [
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "Why a risk to people is unlikely (Art. 33(1))",
                    "max": null,
                    "min": null,
                    "name": "justification",
                    "nodeId": "cmp_nnf1",
                    "options": [],
                    "placeholder": "What was affected, why it cannot harm anyone, and what makes you confident of that.",
                    "required": true,
                    "rows": 4,
                    "type": "input_textarea",
                  },
                  {
                    "initial": "2026-01-15",
                    "inputType": "text",
