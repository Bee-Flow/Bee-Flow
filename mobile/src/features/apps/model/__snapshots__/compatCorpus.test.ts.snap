    {
      "id": "scr_report",
      "plans": [
        {
          "plan": {
            "blocks": [
              {
                "divider": false,
                "id": "cmp_rphdr",
                "kind": "page_header",
                "subtitle": "Report first, investigate second. A record you can correct beats a deadline you missed while gathering detail.",
                "title": "Report a breach",
              },
              {
                "action": {
                  "actionId": "act_goclock",
                  "kind": "navigate",
                  "label": "Back to the register",
                  "runnable": false,
                },
                "id": "cmp_rpback",
                "kind": "button",
              },
              {
                "body": "The 72 hours of Article 33 run from the moment the organisation became **aware** — which can be days or months after the thing itself happened. A backup found missing this morning, lost last spring, is due within 72 hours of this morning. If a processor told you, awareness is the moment **they told you**; record that on the Systems tab afterwards.",
                "id": "cmp_rpnote",
                "kind": "callout",
                "title": "The clock starts at awareness, not at the incident",
                "tone": "warning",
              },
              {
                "action": {
                  "actionId": "act_report",
                  "kind": "sequence",
                  "label": "Submit",
                  "runnable": false,
                },
                "description": null,
                "id": "cmp_rpform",
                "inputs": [
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "Reference",
                    "max": null,
                    "min": null,
                    "name": "reference",
                    "nodeId": "cmp_rpf1",
