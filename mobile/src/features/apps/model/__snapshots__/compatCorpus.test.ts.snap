                    "max": null,
                    "min": null,
                    "name": "risk_summary",
                    "nodeId": "cmp_asf3",
                    "options": [],
                    "placeholder": "What could happen to them, how likely, and what makes it more or less severe.",
                    "required": true,
                    "rows": 4,
                    "type": "input_textarea",
                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "People affected",
