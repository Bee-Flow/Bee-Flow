            "secretary",
            "member",
            "auditor",
          ],
        },
      ],
    },
    {
      "id": "scr_actions",
      "plans": [
        {
          "plan": {
            "blocks": [
              {
                "divider": false,
                "id": "cmp_achdr",
                "kind": "page_header",
                "subtitle": "Only confirmed actions appear here — a suggestion lives on the Review screen until someone owns it. Drag a card to change its status.",
                "title": "Actions",
              },
            ],
            "screen": "scr_actions",
            "unsupported": [
              "filter_bar",
              "kanban (browser-only)",
              "modal",
            ],
