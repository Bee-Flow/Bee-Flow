                    "nodeId": "cmp_asf4",
                    "options": [],
                    "placeholder": null,
                    "required": false,
                    "rows": 4,
                    "type": "input_number",
                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "Records affected",
                    "max": 100000000,
                    "min": 0,
                    "name": "records_affected",
                    "nodeId": "cmp_asf5",
                    "options": [],
                    "placeholder": null,
                    "required": false,
                    "rows": 4,
                    "type": "input_number",
                  },
                  {
                    "initial": false,
                    "inputType": "text",
                    "label": "Special-category data is involved (Art. 9)",
                    "max": null,
                    "min": null,
                    "name": "special_categories",
                    "nodeId": "cmp_asf6",
                    "options": [],
                    "placeholder": null,
                    "required": false,
                    "rows": 4,
