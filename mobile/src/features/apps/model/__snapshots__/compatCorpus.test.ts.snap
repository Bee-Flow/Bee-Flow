                  },
                  {
                    "initial": null,
                    "inputType": "text",
                    "label": "Reasons for the delay (only if later than 72 hours)",
                    "max": null,
                    "min": null,
                    "name": "late_reason",
                    "nodeId": "cmp_auf3",
                    "options": [],
