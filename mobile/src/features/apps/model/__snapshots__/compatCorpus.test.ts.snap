    {
      "id": "scr_dossier",
      "plans": [
        {
          "plan": {
            "blocks": [
              {
                "divider": true,
                "id": "cmp_mdhdr",
                "kind": "page_header",
                "subtitle": "Everything on this screen belongs to one meeting.",
                "title": "Dossier",
              },
              {
                "action": {
                  "actionId": "act_mdback",
                  "kind": "navigate",
                  "label": "Meetings",
                  "runnable": false,
                },
                "id": "cmp_mdback",
                "kind": "button",
              },
              {
                "body": "Reading decisions and actions out of a transcript needs nothing configured — it runs in the app. **Send for transcription** is different: it marks the recording \`queued\` and asks an automation to pick it up, so someone has to wire one first (Automations → an automation that takes queued recordings, runs WhisperX, writes the text back and sets the status to Transcribed). Until then, paste or upload the transcript yourself — or skip it entirely and write the decisions and actions in by hand. Nothing below depends on the AI.",
                "id": "cmp_mdnote",
                "kind": "callout",
                "title": "How transcription works here",
                "tone": "info",
              },
              {
                "action": {
                  "actionId": "act_mdrecopen",
