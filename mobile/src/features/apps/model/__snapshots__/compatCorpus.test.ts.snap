    {
      "id": "scr_breach",
      "plans": [
        {
          "plan": {
            "blocks": [
              {
                "divider": true,
                "id": "cmp_brhdr",
                "kind": "page_header",
                "subtitle": null,
                "title": "Breach file",
              },
              {
                "action": {
                  "actionId": "act_goclock",
