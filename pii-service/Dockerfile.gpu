# GPU-capable PII detection service (NVIDIA CUDA)
# Used in production where an NVIDIA L4 GPU is available.
# Falls back to CPU if no GPU is found at runtime.
FROM nvidia/cuda:12.1.0-runtime-ubuntu22.04@sha256:402700b179eb764da6d60d99fe106aa16c36874f7d7fb3e122251ff6aea8b2f7

# Install Python 3.11
RUN apt-get update && apt-get install -y \
    python3.11 python3-pip python3.11-dev curl \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf python3.11 /usr/local/bin/python3 \
    && ln -sf python3 /usr/local/bin/python

WORKDIR /app

# Install Python dependencies
COPY requirements.gpu.txt .
RUN pip install --no-cache-dir -r requirements.gpu.txt

COPY app/ ./app/

# Model cache — mount -v pii-model-cache:/cache/huggingface
ENV HF_HOME=/cache/huggingface
ENV TRANSFORMERS_CACHE=/cache/huggingface

# Runtime user: uid 1000, no home directory. The model cache is the only
# path it owns, so a first-start download still lands.
RUN useradd --uid 1000 --user-group --no-create-home --shell /usr/sbin/nologin app \
    && mkdir -p /cache/huggingface \
    && chown -R app:app /cache
USER app

EXPOSE 8200

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8200"]
