# Reranker Service Configuration
# Copy to .env and configure. Cross-encoder reranker for search results;
# CPU-only (ONNX Runtime in the image, sentence-transformers in local dev).

# ── Model ────────────────────────────────────────────────────────
# HuggingFace model id (local dev fallback; the Docker image uses the ONNX
# snapshot baked into MODEL_DIR instead).
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# Directory holding model.onnx + tokenizer files (production / Docker).
MODEL_DIR=/app/model

# ── Runtime ──────────────────────────────────────────────────────
# Port the service listens on.
PORT=8000
# ONNX Runtime thread count (inter- and intra-op). 0 lets ONNX Runtime
# pick the thread count itself.
# ORT_THREADS=0
