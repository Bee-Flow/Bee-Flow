# Copy to .env for local runs (e2e/.env is gitignored).
# The runner scripts and playwright.config.ts load this file automatically;
# already-set environment variables always win.

# Frontend base URL the browser drives.
#   Local docker stack:  http://localhost:5176
#   Local dev (vite):    http://localhost:5276
BASE_URL=http://localhost:5176

# Server API base URL (used for health probes only).
#   Local docker stack:  http://localhost:3001
#   Local dev (node):    http://localhost:3101
API_URL=http://localhost:3001

# Smoke account. In CI this is the boot-init admin with a throwaway password.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Needed for: npm run gen (spec generation), agentic runs/fallback, and the
# LLM-written failure report. Plain playwright runs (npm test) don't need it.
ANTHROPIC_API_KEY=

# Which stack capabilities are available; scenarios whose `requires` is not
# a subset of this list are skipped. Unset = everything is assumed available.
E2E_CAPABILITIES=llm,search
