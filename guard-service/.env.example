# Guard Service Configuration
# Copy to .env and configure

# ── Redis ────────────────────────────────────────────────────────
GUARD_REDIS_URL=redis://guard-redis:6379/1

# ── CPU PII detection (GLiNER multi PII v1, Apache 2.0) ──────────
# Used as fallback when Azure AI Text Analytics is not configured.
# Multilingual incl. Dutch; ~50 PII categories via zero-shot labels.
# Set to false to skip loading the model (saves ~400 MB RAM).
GUARD_PII_MODEL=E3-JSI/gliner-multi-pii-domains-v1
GUARD_PII_ENABLED=true

# ── AI-disclosure classifier (optional, absent by default) ───────
# /disclosure answers "no opinion" unless an encoder was baked into the image
# with --build-arg GUARD_DISCLOSURE_MODEL=... (see README). Leaving this alone
# is the supported configuration: the Art. 50 keyword rule then stands alone,
# which is what it did before this endpoint existed.
GUARD_DISCLOSURE_ENABLED=true
GUARD_DISCLOSURE_MODEL_DIR=/opt/disclosure-encoder

# ── Logging ──────────────────────────────────────────────────────
GUARD_LOG_LEVEL=INFO
