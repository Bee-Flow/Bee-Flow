# Guard Service Configuration
# Copy to .env and configure

# ── Redis ────────────────────────────────────────────────────────
GUARD_REDIS_URL=redis://guard-redis:6379/1

# ── CPU PII detection (GLiNER multi PII v1, Apache 2.0) ──────────
# Used as fallback when Azure AI Text Analytics is not configured.
# Multilingual incl. Dutch; ~50 PII categories via zero-shot labels.
# Set to false to skip loading the model (saves ~400 MB RAM).
GUARD_PII_MODEL=E3-JSI/gliner-multi-pii-domains-v1
GUARD_PII_ENABLED=true

# ── AI-disclosure classifier (optional, absent by default) ───────
# /disclosure answers "no opinion" unless an encoder was baked into the image
# with --build-arg GUARD_DISCLOSURE_MODEL=... (see README). Leaving this alone
# is the supported configuration: the Art. 50 keyword rule then stands alone,
# which is what it did before this endpoint existed.
GUARD_DISCLOSURE_ENABLED=true
GUARD_DISCLOSURE_MODEL_DIR=/opt/disclosure-encoder

# ── Logging ──────────────────────────────────────────────────────
GUARD_LOG_LEVEL=INFO

# ── Service ──────────────────────────────────────────────────────
# Shared API key: when set, every request except /health needs X-API-Key.
# SERVICES_API_KEY=
# Bind address / port.
# GUARD_HOST=0.0.0.0
# GUARD_PORT=8100
# GUARD_DEBUG=false

# ── Resource guards (defaults shown; hard bounds so one big scan can
# never monopolise the pod) ───────────────────────────────────────
# Max concurrent /pii requests admitted; extra requests queue.
# GUARD_PII_MAX_CONCURRENCY=2
# Absolute request-size ceiling in chars; larger requests are refused
# (degraded=input_too_large).
# GUARD_PII_HARD_MAX_CHARS=4000000
# Text up to this length is scanned in full; beyond it a bounded prefix is
# scanned and a partial result returned (up to the hard ceiling above).
# GUARD_PII_MAX_CHARS=1000000
# Per-request work budget in chars; 0 = derive from the detection tier.
# GUARD_PII_SCAN_BUDGET_CHARS=0
# ONNX Runtime intra-op threads; 0 = derive from the cgroup CPU quota.
# GUARD_PII_ORT_INTRA_OP_THREADS=0
# Concurrent forward passes within one scan; 0 = derive from the CPU quota.
# GUARD_PII_PREDICT_WORKERS=0
# Model concurrency protection: "tokenizer" (per-thread tokenizers, default)
# or "global" (pod-wide lock — kill switch, no rebuild).
# GUARD_PII_INFERENCE_LOCK=tokenizer
# Run one inference at startup so the first real request skips cold-start.
# GUARD_PII_WARM_INFERENCE=true

# ── Detection tuning (defaults shown) ────────────────────────────
# Regex tier rollout: on (both tiers) | shadow (both, union + counts) |
# off (GLiNER only).
# GUARD_PII_REGEX_TIER=on
# Identifier-pattern regions, comma-separated ISO 3166-1 alpha-2; * = all.
# GUARD_PII_REGIONS=*
# Treat a partial label-group failure as degraded (fail-closed friendly).
# GUARD_PII_DEGRADE_ON_PARTIAL_GROUP_FAILURE=true
# Use the fp32 ONNX graph baked into the image; false forces the (much
# slower) PyTorch weights.
# GUARD_PII_USE_ONNX=true
# GUARD_PII_ONNX_DIR=/opt/gliner-onnx
# GUARD_PII_ONNX_FILE=model.onnx

# ── AI-disclosure classifier tuning (defaults shown) ─────────────
# GUARD_DISCLOSURE_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Tokens per segment (bounds a pathological sentence-sized segment).
# GUARD_DISCLOSURE_MAX_TOKENS=128
# Similarity floor before "this looks like a disclosure" is on the table.
# GUARD_DISCLOSURE_FLOOR=0.45
# Margin between the positive/negative banks; inside it the classifier
# abstains rather than guessing.
# GUARD_DISCLOSURE_MARGIN=0.06
# Work bound per request; larger requests are refused, not truncated.
# GUARD_DISCLOSURE_MAX_CHARS=200000
