# Agent Search Engine — Environment Configuration
# Copy to .env and customize for your deployment

# ── Search API ──────────────────────────────────────────────────────
SEARCH_DEBUG=false
SEARCH_LOG_LEVEL=INFO
SEARCH_API_PORT=8000

# ── Database ────────────────────────────────────────────────────────
SEARCH_DB_USER=search
SEARCH_DB_PASSWORD=search
SEARCH_DB_NAME=search_kb
SEARCH_DATABASE_URL=postgresql://search:search@search-postgres:5432/search_kb

# ── Redis ───────────────────────────────────────────────────────────
SEARCH_REDIS_URL=redis://search-redis:6379/0

# ── Serper.dev (Google Search API) ──────────────────────────────────
# Get your API key from https://serper.dev
# Can also be set via admin dashboard (Admin → Integrations → Serper.dev API Key)
SEARCH_SERPER_API_KEY=

# ── Inference (vLLM) ────────────────────────────────────────────────
# Set to true when vLLM is running on a GPU host
SEARCH_INFERENCE_ENABLED=false
SEARCH_EMBED_API_URL=http://inference-embed:8001/v1
SEARCH_EMBED_MODEL=Qwen/Qwen3-Embedding-8B
SEARCH_RERANK_API_URL=http://inference-rerank:8002/v1
SEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SEARCH_CLEANUP_API_URL=http://inference-llm:8003/v1
SEARCH_CLEANUP_MODEL=Qwen/Qwen3-8B

# ── Cache TTLs (seconds) ───────────────────────────────────────────
SEARCH_CACHE_TTL_SEARX=900
SEARCH_CACHE_TTL_PAGE=21600
SEARCH_CACHE_TTL_CLEAN=172800
SEARCH_CACHE_TTL_KB_QUERY=120
SEARCH_CACHE_TTL_EMBEDDING=86400

# ── Web fetch ───────────────────────────────────────────────────────
SEARCH_WEB_MAX_CONCURRENT_FETCHES=3
SEARCH_WEB_CONNECT_TIMEOUT=2.0
SEARCH_WEB_READ_TIMEOUT=2.5

# ── Auto-mode ───────────────────────────────────────────────────────
SEARCH_AUTO_KB_SCORE_THRESHOLD=0.62
