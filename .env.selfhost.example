# ══════════════════════════════════════════════════════════════════
# Bee Flow — Self-Hosted Configuration
# ══════════════════════════════════════════════════════════════════
#
# This template matches docker-compose.from-registry.yml (public images
# from ghcr.io/bee-flow). The easy path is `./selfhost.sh`, which copies
# this file to .env and fills in the generated secrets for you.
#
# To do it by hand:
#   cp .env.selfhost.example .env
#   then replace every CHANGE_ME below (commands are shown inline).
# ══════════════════════════════════════════════════════════════════

# ── Deployment mode ──────────────────────────────────────────────
# 'self-hosted'  : no Stripe/billing; features unlock via a server-wide
#                  licence key activated in the app (Admin → Licence).
# Leave this as self-hosted for a local install.
DEPLOYMENT_MODE=self-hosted

# Disable public self-registration — admins create users (recommended self-host).
ALLOW_SIGNUPS=false
# Keep username/password login on so the first admin can sign in.
ALLOW_PASSWORD_LOGIN=true
# Demo/sample seeding off for a real install.
DEMO_MODE_ENABLED=false

# ── Secrets (REQUIRED — generate unique values) ──────────────────
# SESSION_SECRET        : openssl rand -hex 32
# MASTER_ENCRYPTION_KEY : openssl rand -hex 32   (must be 64 hex chars)
# DB_PASSWORD           : openssl rand -hex 24
# RUSTFS_SECRET_KEY     : openssl rand -hex 24
# SERVICES_API_KEY      : openssl rand -hex 24   (shared by server↔sidecars)
SESSION_SECRET=CHANGE_ME
MASTER_ENCRYPTION_KEY=CHANGE_ME
DB_PASSWORD=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
SERVICES_API_KEY=CHANGE_ME

# OPAQUE passwordless auth (OPTIONAL). Leave blank to rely on password login.
# Generate against the server image:
#   docker run --rm ghcr.io/bee-flow/server:latest \
#     node -e "console.log(require('./auth/opaque').generateSetup())"
OPAQUE_SERVER_SETUP=

# ── First admin (consumed once on first boot by boot-init.js) ────
# Username is 'admin'. Set a strong password; selfhost.sh generates one
# and prints it. You can change it in the app after first login.
INIT_ADMIN_PASSWORD=CHANGE_ME

# ── Public addresses ─────────────────────────────────────────────
# For a plain local install the defaults are fine. Behind a domain /
# reverse proxy, set these to your real hostnames and flip to https.
SERVER_PORT=3001
SERVER_PROTOCOL=http
SERVER_PUBLIC_HOST=localhost:3001
CLIENT_PORT=5176
CLIENT_PROTOCOL=http
CLIENT_PUBLIC_HOST=localhost:5176
# CORS is derived from CLIENT/SERVER hosts in the compose file; override only
# if you front the stack with extra origins.
# CORS_ORIGIN=https://bee-flow.your-domain.com

# Behind https set these so session cookies stick:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax

# ── Feature toggles ──────────────────────────────────────────────
ENABLE_TASKS=true
ENABLE_MONITORING=true

# ── Licence (community is the free default — no key required) ────
# The install runs at the free 'community' tier with NO licence. Community is
# a usable floor (chat, knowledge bases, multi-user, Nextcloud connector). For
# premium features, activate a server-wide licence in the app (Admin → Licence);
# pricing and keys are at https://beeflow.nl.
#
# To validate real licence JWTs issued by license.beeflow.nl, provide the public
# key (inline PEM with literal \n, or a mounted file path):
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# LICENSE_PUBLIC_KEY_FILE=/app/data/license-public-key.pem
# Where "upgrade" links point in the UI (defaults to the Bee Flow pricing page):
# LICENSE_UPGRADE_URL=https://beeflow.nl/pricing

# ── Nextcloud (OPTIONAL) ─────────────────────────────────────────
# You do NOT need these to connect a Nextcloud. The Nextcloud admin points
# the Bee Flow connector at this server from Nextcloud → Settings →
# Administration → AI → Bee Flow (pick "Self-hosted server" + this URL).
# These are only for the legacy direct-OAuth integration.
# NEXTCLOUD_URL=https://your-nextcloud-instance.com
# NEXTCLOUD_CLIENT_ID=
# NEXTCLOUD_CLIENT_SECRET=

# ── AI / LLM (OPTIONAL — configurable in-app under Admin) ────────
# LLM_API_URL=
# LLM_API_KEY=

# ── Local models: run open-weight LLMs on your own hardware ──────
# Nothing leaves your infrastructure and there is no per-token cost. Any URL
# set here is registered as a provider on boot, so its models are immediately
# selectable under Admin → AI → Chat Models.
#
# (a) Use the bundled Ollama container:
#       PROFILES="core local-llm" ./selfhost.sh
#     and uncomment:
# OLLAMA_URL=http://ollama:11434
#
# (b) Use an Ollama already running on this machine (outside Docker):
# OLLAMA_URL=http://host.docker.internal:11434
#
# (c) Point at your own GPU server:
# VLLM_URL=http://gpu-box.internal:8000/v1
# LLAMACPP_URL=http://gpu-box.internal:8080/v1
#
# (d) Any other OpenAI-compatible endpoint. LOCAL_LLM_TYPE picks the adapter:
#     lmstudio | sglang | localai | tgi | jan | koboldcpp | openai-compatible
# LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_TYPE=lmstudio
# LOCAL_LLM_API_KEY=
#
# Ollama tuning (bundled container only):
# OLLAMA_KEEP_ALIVE=15m          how long a model stays resident between turns
# OLLAMA_MAX_LOADED_MODELS=2     models held in memory at once
# OLLAMA_CONTEXT_LENGTH=8192     default context window

# ── Optional sidecar profiles ────────────────────────────────────
# Bring these up by adding --profile search / --profile guard etc.
# SEARCH_SERPER_API_KEY=
# GUARD_PII_ENABLED=true
# HF_TOKEN=
#
# PII Guard endpoint. This is the name the server reads; leaving it blank means
# PII detection is OFF and nothing is scanned or redacted — the server says so
# once, loudly, at boot.
#
# ./selfhost.sh fills this in automatically when you run with the guard profile
# (PROFILES="core guard" ./selfhost.sh), so you only set it by hand for a guard
# that lives somewhere else — your own host, a k8s service, a shared instance.
#
# Do NOT set it for a stack that does not actually run a guard: "configured but
# unreachable" is a different path from "not configured". The first one degrades
# and then applies the org's failure mode, which defaults to fail_closed, so a
# stack pointed at a guard that is not there starts blocking messages.
# PII_SERVICE_URL=http://guard-service:8100
# PII_SERVICE_API_KEY=

# Redis session cache (optional). Core-only installs run fine without it
# (Postgres-backed sessions). If you start --profile search (which includes a
# redis), enable the cache by pointing the server at it:
# REDIS_URL=redis://search-redis:6379/1
