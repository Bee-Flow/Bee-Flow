# Classify Service Configuration
# Copy to .env and configure. All defaults shown; the service listens on
# port 8300 (fixed in the image's CMD, not env-configurable).

# ── Model ────────────────────────────────────────────────────────
# Zero-shot topic classifier, baked into the image by the build. Never
# downloaded at runtime — production pods have no egress (HF_HUB_OFFLINE=1).
CLASSIFY_MODEL=knowledgator/gliclass-multilang-mini
CLASSIFY_MODEL_REVISION=0bd888b6c3ef9fca5f0a9d407bddfbbc7623486b
CLASSIFY_MODEL_DIR=/opt/model
# float32 on purpose: the checkpoint is stored as bfloat16, which is slower
# on a CPU without bf16 matmul units.
CLASSIFY_DTYPE=float32

# ── Text / label handling ────────────────────────────────────────
# Each text is pre-cut to MAX_CHARS characters, then to MAX_TOKENS tokens
# (first MAX_TOKENS-128 + last 128); the label prompt fits inside
# MAX_LENGTH, the model's whole sequence.
# CLASSIFY_MAX_CHARS=4000
# CLASSIFY_MAX_TOKENS=512
# CLASSIFY_MAX_LENGTH=1024
# joint: every label in one forward pass. independent: one pass per label
# (no label's score depends on the others, at labels-times the cost).
# CLASSIFY_LABEL_MODE=joint
# Score threshold reported to the caller; the caller decides.
# CLASSIFY_DEFAULT_THRESHOLD=0.75

# ── Admission control ────────────────────────────────────────────
# This many requests run, this many more wait, the rest get 429.
# CLASSIFY_MAX_CONCURRENCY=1
# CLASSIFY_MAX_QUEUE=8
# CLASSIFY_MAX_BODY_BYTES=262144

# ── Auth ─────────────────────────────────────────────────────────
# API key for this service. Unset, it falls back to the stack-wide
# SERVICES_API_KEY; when both are empty no key is required.
# CLASSIFY_API_KEY=

# ── Logging ──────────────────────────────────────────────────────
CLASSIFY_LOG_LEVEL=INFO
