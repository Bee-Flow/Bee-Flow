{
  "name": "@beeflow/frontend",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Bee Flow \u2014 frontend SPA. The React + Vite client for every Bee Flow deployment (SaaS, self-hosted, Nextcloud ExApp).",
  "license": "SEE LICENSE IN LICENSE.md",
  "homepage": "https://beeflow.nl",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bee-Flow/Bee-Flow.git",
    "directory": "agent-hub"
  },
  "bugs": {
    "url": "https://github.com/Bee-Flow/Bee-Flow/issues"
  },
  "keywords": [
    "bee-flow",
    "ai",
    "agents",
    "nextcloud",
    "react",
    "vite"
  ],
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE.md",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "predev": "node scripts/generate-module-shims.mjs",
    "dev": "vite",
    "dev:clean": "rm -rf node_modules/.vite && vite",
    "prebuild": "node scripts/generate-module-shims.mjs",
    "build": "vite build",
    "build:analyze": "VITE_BUNDLE_ANALYZE=1 vite build",
    "build:runtime": "vite build --config vite.runtime.config.js",
    "build:world-atlas": "node scripts/build-world-atlas.mjs",
    "lint": "eslint .",
    "lint:dead": "npx --yes knip@6.37.0 --include files",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@monaco-editor/react": "^4.7.0",
    "@openobserve/browser-logs": "^0.4.3",
    "@openobserve/browser-rum": "^0.4.3",
    "@serenity-kit/opaque": "^1.1.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@xyflow/react": "^12.12.0",
    "d3-geo": "^3.1.1",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "emoji-picker-react": "^4.22.2",
    "esbuild-wasm": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.16.47",
    "lib0": "0.2.119",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-grid-layout": "^2.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "uuid": "^13.0.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
    "web-vitals": "^6.2.2",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "msw": "^2.15.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.1.18",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.2.4",
    "vitest": "^4.1.6",
    "world-atlas": "^2.0.2"
  }
}
