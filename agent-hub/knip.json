{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/main.tsx",
    "src/test/setup.ts",
    "src/**/*.test.{js,jsx,ts,tsx}",
    "src/editor/serialization/index.ts",
    "src/shared/expr/index.mjs",
    "src/i18n/en/*.generated.mjs",
    "scripts/*.mjs",
    "vite.config.js",
    "vite.runtime.config.js"
  ],
  "project": ["src/**/*.{js,jsx,ts,tsx,mjs}", "scripts/**/*.mjs"],
  "vite": false,
  "vitest": false
}
