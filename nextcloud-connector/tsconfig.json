{
  // Type checking of the plain-JS sources with JSDoc, no build step: `npm run typecheck`.
  // Starts loose (strict off); .tsc-ratchet.json holds the number of errors under
  // tsconfig.strict.json, which may only go down.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "node20",
    "moduleResolution": "node16",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.js", "types/**/*.d.ts"]
}
