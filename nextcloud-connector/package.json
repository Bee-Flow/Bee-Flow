{
  "name": "bee-flow-connector",
  "version": "1.6.2",
  "private": true,
  "description": "Nextcloud ExApp connector for Bee Flow — proxies authenticated requests from a customer's Nextcloud to the hosted Bee Flow SaaS.",
  "license": "AGPL-3.0-or-later",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 node --test test/*.test.js",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22.15.0 <23.0.0"
  },
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-static": "^1.55.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  }
}
