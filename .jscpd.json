{
  "minLines": 10,
  "minTokens": 50,
  "mode": "weak",
  "format": [
    "javascript",
    "typescript",
    "jsx",
    "tsx",
    "python"
  ],
  "gitignore": true,
  "reporters": [
    "console"
  ],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/out/**",
    "**/.next/**",
    "**/.docusaurus/**",
    "**/coverage/**",
    "**/.venv/**",
    "**/venv/**",
    "**/__pycache__/**",
    "**/.pytest_cache/**",
    "**/vendor/**",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.bundle.js",
    "**/*.map",
    "**/*.snap",
    "**/package-lock.json",
    "**/*.lock",
    "**/migrations/**",
    "agent-hub/src/shared/**",
    "mobile/src/shared/expr/vendor/**",
    "mobile/src/core/theme/generated/**",
    "**/*.generated.js",
    "**/*.generated.ts",
    "server/core/markdown/editorSerialization.cjs",
    "server/core/markdown/editorCollab.cjs",
    "agent-hub/src/i18n/en-defaults.js",
    "agent-hub/src/components/onboarding/generated/**",
    "agent-hub/public/module-shims/**",
    "e2e/tests/generated/**",
    "mobile/src/features/flow-editor/bindings/mirror/**",
    "**/*.generated.mjs",
    "components/*/ssrfGuard.js",
    "components/webpage-to-markdown/htmlToMarkdown.js",
    "components/website-sitemap-fetcher/safeGet.js",
    "deploy/**",
    "docs_old/**"
  ]
}
