# ── Dependencies ────────────────────────────────────────────────
**/node_modules/
**/__pycache__/
**/.venv/
*.pyc

# ── AI tooling (per-machine config & caches) ────────────────────
# .claude/ (settings, hooks, commands, skills) and CLAUDE.md are intentionally
# TRACKED as a reference snapshot. settings.local.json is NOT: it is one
# machine's permissions (home paths, prod contexts, permission mode), and the
# repo is meant to be publishable.
# Its worktrees/ is the exception: a subagent working in isolation gets a git
# worktree there, which is a second checkout of this very repo. Committing one
# would put the tree inside itself, and it is gone the moment the agent is.
.claude/worktrees/
.claude/settings.local.json
.claude/settings.local.json.*
.serena/
.playwright-mcp/

# ── SBOM (regenerate via scripts/generate-sbom.sh) ──────────────
sbom/

# ── Environment / Secrets ───────────────────────────────────────
.env
.env.local
.env.development
.env.production
.env.staging
.env.dev
.env.test
.env.selfhost
.env.dockerhub
.env.portainer
server/.env
search-service/.env
guard-service/.env

# Seed/test users — bcrypt hashes are offline-crackable, never commit
server/config/users.json
server/config/users.*.json
config/users.json

# Benchmark / scratch files — typically contain real-looking PII fixtures
server/test-bench-*.js
server/test-huge*.js
server/retry-test*.js
server/bench-*.js
server/scratch-*.js

# ── SSH Keys & Credentials ──────────────────────────────────────
*.ppk
*.pub
*.pem
*.key
ssh-key-*
*-vpn-key*
config.json
scripts/pubkey_fedora

# Exception reserved for a bundled licence-verification PUBLIC key, so
# self-hosted installs could validate JWTs out of the box. The matching
# private key lives ONLY on the license server. (Currently the public key is
# supplied via LICENSE_PUBLIC_KEY / LICENSE_PUBLIC_KEY_FILE / JWKS instead —
# see server/license/verify.js.)
!server/license/bundled-public-key.pem

# ── Databases ───────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
data/
# `data/` above is UN-ANCHORED, so it matches a directory named "data" at ANY
# depth — not just the database directory it was written for. That silently
# swallowed a React data-layer directory: the files existed on every developer's
# disk and were absent from the repo, so the app built locally and the CI image
# build failed on an unresolvable import.
#
# Anchoring it to /data/ is NOT the fix: server/data/ alone is ~550 MB of user
# uploads and recordings, and training/data/ is ML corpora. Both must stay out.
# So the source directory is re-included by name instead. Re-include the
# DIRECTORY, not a glob inside it — git will not descend into an excluded
# directory to evaluate a pattern for the files under it.
#
# Anything under src/ named data/ needs a line here. If that happens twice more,
# swap this for an explicit list of the real data directories.
!agent-hub/src/components/admin/compliance/data/
# The IP location databases (DB-IP Lite, ~140 MB, `npm run geo:fetch`). Already
# covered by the unanchored `data/` above; named so nobody un-ignores it by accident.
server/data/geo/

