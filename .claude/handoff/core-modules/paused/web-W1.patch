+/**
+ * The type-only references of a source file: the counterpart of scanSource, which leaves them
+ * out. `import type` / `export type ... from`, an import or re-export whose every named specifier
+ * is `type X` (and that binds no default or namespace), `typeof import('..')` and
+ * `import('..').T` in a type position. Comments and strings are masked first, so a JSDoc
+ * `@type {import('..').T}` is not counted.
+ * @param {string} src
+ * @param {{ local?: (spec: string) => boolean }} [opts] which specifiers name a file of the tree
+ * @returns {{ spec: string, line: number }[]}
+ */
+export function scanTypeOnly(src, opts = {}) {
+    const local = opts.local || isRelative;
+    const { code, strings } = maskSource(src);
+    /** @type {{ quote: number, at: number, kind: string }[]} */
+    const hits = [];
+    const add = (m, kind) => hits.push({ quote: m.index + m[0].length - 1, at: m.index, kind });
+    for (const m of code.matchAll(/(?<![\w$.])(?:import|export)\s+type\s+[\w$*{},\s]*?\bfrom\s*['"]/g)) add(m, 'declared');
+    for (const m of code.matchAll(/(?<![\w$.])(?:import|export)\s+(?!type\s)[\w$*{},\s]*?\bfrom\s*['"]/g)) add(m, 'static');
+    for (const m of code.matchAll(/(?<![\w$.])import\s*\(\s*['"`]/g)) add(m, 'dynamic');
+    const out = [];
+    for (const h of hits) {
+        const lit = strings.get(h.quote);
+        if (!lit || !local(lit.value)) continue;
+        if (h.kind !== 'declared' && isRuntime(h, code, strings, local)) continue;
+        if (h.kind === 'dynamic' && !/^\s*\)/.test(code.slice(lit.end))) continue;
+        out.push({ at: h.at, spec: lit.value, line: src.slice(0, h.at).split('\n').length });
+    }
+    return out.sort((a, b) => a.at - b.at).map(({ spec, line }) => ({ spec, line }));
+}
+
+/**
+ * Every type-only reference between files of a tree (scanTypeOnly per file, resolved like importEdges).
+ * @param {{ treePath: string, abs: string }[]} entries
+ * @param {ResolveOptions} [opts]
+ * @returns {{ from: string, to: string, line: number }[]}
+ */
+export function typeOnlyEdges(entries, opts = {}) {
+    const files = new Set(entries.map((e) => e.treePath));
+    const vite = opts.style === 'vite';
+    const scanOpts = vite ? { local: viteLocal(opts.alias || {}) } : {};
+    const edges = [];
+    for (const { treePath, abs } of entries) {
+        if (!(vite ? VITE_CODE_FILE : CODE_FILE).test(treePath) || TYPE_FILE.test(treePath)) continue;
+        let src;
+        try { src = fs.readFileSync(abs, 'utf8'); } catch { continue; }
+        if (!src.includes('type') && !src.includes('typeof')) continue;
+        for (const hit of scanTypeOnly(src, scanOpts)) {
+            const to = resolveSpecifier(treePath, hit.spec, files, opts);
+            if (to && to !== treePath) edges.push({ from: treePath, to, line: hit.line });
+        }
+    }
