diff --git a/server/stores/userStore.credentialCleanup.projects.test.js b/server/stores/userStore.credentialCleanup.projects.test.js
new file mode 100644
index 00000000..c1b0800a
--- /dev/null
+++ b/server/stores/userStore.credentialCleanup.projects.test.js
@@ -0,0 +1,67 @@
+/**
+ * deleteUser with the projects module's teardown (projects/projectTeardown.js): each owned
+ * project is deleted on its own, never by a bare DELETE by owner. Moved out of
+ * userStore.credentialCleanup.test.js with its assertions unchanged; the statements it reads are
+ * the ones a real database ran (the ladder's schema, testUtils/pgliteTemplate.js), recorded at
+ * the pool, where the stubbed db of that file only collected them. With the projects module
+ * absent and its code not here, an owned project refuses the erasure instead
+ * (stores/user/erasurePorts.test.js).
+ *
+ * Run: cd server && node --test stores/userStore.credentialCleanup.projects.test.js
+ */
+
+process.env.NODE_ENV = 'test';
+process.env.SESSION_SECRET = process.env.SESSION_SECRET || 'integration-test-session-secret-0123456789abcdef';
+
+const assert = require('assert');
+const { test, before, after } = require('node:test');
+const { usePglitePool } = require('../testUtils/pglitePool');
+const { ladderPglite } = require('../testUtils/pgliteTemplate');
+
+const { query: rawQuery, close } = usePglitePool(ladderPglite());
+const db = require('../db');
+const userStore = require('./userStore');
+require('../projects/erasurePorts'); // deleteUser erases through these ports (the real ones)
+
+/** @type {Array<{ sql: string, params: unknown[] }>} */
+const runCalls = [];
+const pooled = { query: db.pool.query, connect: db.pool.connect };
+/** @param {(sql: any, params?: any) => Promise<unknown>} query */
+const recordQuery = (query) => async (/** @type {any} */ sql, /** @type {any} */ params) => {
+    runCalls.push({ sql: typeof sql === 'string' ? sql : String(sql?.text || ''), params: Array.isArray(params) ? params : (sql?.values || []) });
+    return query(sql, params);
+};
+/** @param {string} table */
+const deletesFrom = (table) => runCalls.filter(c =>
+    /DELETE\s+FROM/i.test(c.sql) && new RegExp(`\\b${table}\\b`, 'i').test(c.sql));
+
+before(async () => {
+    await rawQuery(`INSERT INTO organizations (id, name) VALUES ('orgA', 'Acme')`);
+    assert.strictEqual(await userStore.createUser({ id: 'u1', username: 'u1', passwordHash: '', organizationId: 'orgA' }), true);
+    await rawQuery(`INSERT INTO projects (id, name, owner_id, organization_id) VALUES ('p-owned', 'Owned', 'u1', 'orgA')`);
+    db.pool.query = /** @type {any} */ (recordQuery(pooled.query));
+    db.pool.connect = /** @type {any} */ (async () => {
+        const client = await /** @type {any} */ (pooled.connect)();
+        return { ...client, query: recordQuery(client.query) };
+    });
+});
+
+after(async () => {
+    db.pool.query = pooled.query;
+    db.pool.connect = pooled.connect;
+    await close();
+});
+
+test('deleteUser deletes owned projects through the project teardown, never a bare DELETE by owner', async () => {
+    // A bare `DELETE FROM projects WHERE owner_id = $1` cascaded the co-editing
+    // log away with colleagues' edits not yet written back, and left the
+    // project's files base behind (stores/user/projectErasure.js).
+    runCalls.length = 0;
+
+    assert.strictEqual(await userStore.deleteUser('u1'), true);
+
+    assert.strictEqual(runCalls.filter(c => /DELETE\s+FROM\s+projects\s+WHERE\s+owner_id/i.test(c.sql)).length, 0,
+        'the owner-wide DELETE must be gone');
+    const byId = deletesFrom('projects').filter(c => /DELETE\s+FROM\s+projects\s+WHERE id = \$1/i.test(c.sql));
+    assert.deepStrictEqual(byId.map(c => c.params), [['p-owned']], 'each owned project is deleted on its own');
+});
