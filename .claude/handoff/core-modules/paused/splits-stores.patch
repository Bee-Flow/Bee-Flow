@@ -0,0 +1,42 @@
+// @typecheck strict
+/**
+ * Shared by scrub.test.js (the core's sweeps) and the module halves beside it
+ * (scrub.projects.test.js, scrub.apps.test.js, scrub.automation.test.js).
+ *
+ * MODULE_RULES: the rules of RULES that a first-party module's own code notes, keyed by module.
+ * A rule belongs to the module whose function produces its report entry: the skill and
+ * document-template allow-lists live in projects/packaging/capture.js (they need the Blueprint's
+ * ref map), so their three rules are the projects module's; every other rule is noted by
+ * core/packaging/scrub.js itself and is the core's. Two checks hold this record: scrub.test.js
+ * fails when a rule not listed here never fires through the core's functions (or a listed one
+ * does), and each module's half fails when one of its listed rules never fires there. A rule a
+ * module adds without a line here fails the first, a stale line the second.
+ */
+
+'use strict';
+
+const { RULES } = require('./scrub');
+
+/** @type {Readonly<Record<string, readonly string[]>>} */
+const MODULE_RULES = Object.freeze({
+    projects: Object.freeze([RULES.SKILL_RESOURCE_REFERENCE, RULES.SKILL_TENANT_IDENTITY, RULES.DOCUMENT_TENANT_IDENTITY]),
+});
+
+/** @typedef {{ ref: string, pipeline: boolean, slots: unknown[], findings: unknown[] }} LiftOptions */
+
+/**
+ * Lift options of a release (pipeline mode).
+ * @param {string} ref
+ * @param {Record<string, unknown>} [extra]
+ * @returns {LiftOptions & Record<string, unknown>}
+ */
+const pipe = (ref, extra = {}) => ({ ref, pipeline: true, slots: [], findings: [], ...extra });
+
+/**
+ * Lift options of a gallery file.
+ * @param {string} ref
+ * @returns {LiftOptions}
+ */
+const gallery = (ref) => ({ ref, pipeline: false, slots: [], findings: [] });
+
+module.exports = { MODULE_RULES, pipe, gallery };
