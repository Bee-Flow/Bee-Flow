diff --git a/server/stores/documentSharing.testkit.js b/server/stores/documentSharing.testkit.js
new file mode 100644
index 00000000..376b9715
--- /dev/null
+++ b/server/stores/documentSharing.testkit.js
@@ -0,0 +1,63 @@
+// @typecheck strict
+/**
+ * The test bed of documentSharing.pg.test.js and its datatables half
+ * (documentSharing.datatables.pg.test.js): a real Postgres (PGlite behind db.js) with the users,
+ * groups and projects the sharing code reads, the document and notebook stores initialised, and
+ * the encryption key sources swapped for fixed keys under a tier the test chooses.
+ *
+ *   let tier = 'none';
+ *   const bed = documentSharingBed(usePglitePool(), () => tier);
+ */
+
+'use strict';
+
+const { before, after } = require('node:test');
+const crypto = require('node:crypto');
+const { makeSwaps } = require('../testUtils/swaps');
+
+/**
+ * Open the bed on the test's PGlite pool (testUtils/pglitePool.js usePglitePool(), opened before
+ * this call so the stores below answer from it): registers its own before() and after().
+ * @param {ReturnType<typeof import('../testUtils/pglitePool').usePglitePool>} pool
+ * @param {() => string} tier  the encryption tier the policy answers, read at call time
+ */
+function documentSharingBed(pool, tier) {
+    const { pg, close } = pool;
+    const documents = require('./documentStore');
+    const notebooks = require('./notebookStore');
+    const sharing = require('./lib/documentSharing');
+    const encryption = require('./lib/documentCrypto');
+    const { swap, restore } = makeSwaps();
+    const userKey = crypto.randomBytes(32);
+    const orgKey = crypto.randomBytes(32);
+    /**
+     * Run `fn` as `id` with the session's key unlocked.
+     * @template T
+     * @param {string} id
+     * @param {() => T} fn
+     * @returns {T}
+     */
+    const unlocked = (id, fn) => encryption.sessions.run(/** @type {Parameters<typeof encryption.sessions.run>[0]} */ (
+        { session: { user: { id }, encryptionKey: userKey.toString('base64') } }), fn);
+    /** @param {Record<string, unknown>} [extra] */
+    const make = (extra = {}) => documents.createDocument(/** @type {Parameters<typeof documents.createDocument>[0]} */ (
+        { userId: 'alice', name: 'Shared plan', bodyHtml: '<p>Confidential content</p>', settings: { houseStyle: false }, ...extra }));
+
+    before(async () => {
+        await pg.exec(`CREATE TABLE users (id TEXT PRIMARY KEY, "organizationId" TEXT, groups TEXT DEFAULT '[]', username TEXT, "displayName" TEXT);
+            INSERT INTO users VALUES ('alice','org1','[]','Alice',NULL),('bob','org1','["finance"]','Bob',NULL),('carol','org1','[]','Carol',NULL),('eve','org2','["finance"]','Eve',NULL);
+            CREATE TABLE groups (id TEXT PRIMARY KEY, "organizationId" TEXT, name TEXT);
+            INSERT INTO groups VALUES ('finance','org1','Finance'),('foreign','org2','Foreign');
+            CREATE TABLE projects (id TEXT PRIMARY KEY, owner_id TEXT, organization_id TEXT NOT NULL DEFAULT '');`);
+        swap(encryption.keySources, 'policy', async () => ({ enabled: tier() !== 'none', tier: tier() }));
+        swap(encryption.keySources, 'userKey', async () => userKey);
+        swap(encryption.keySources, 'orgKey', async () => orgKey);
+        await documents.initDB();
+        await notebooks.initDB();
+    });
+    after(async () => { restore(); await close(); });
+
+    return { pg, documents, notebooks, sharing, encryption, swap, orgKey, unlocked, make };
+}
+
+module.exports = { documentSharingBed };
