@@ -0,0 +1,43 @@
+// @typecheck
+/**
+ * deleteUser with the projects module loaded but its erasure port not
+ * registered: refused before the first write, the account stays. Moved out of
+ * users.erasurePorts.test.js unchanged: with the module absent the core
+ * resolves the teardown itself (stores/user/erasurePorts.js projectTeardown).
+ *
+ * Run: cd server && node --test stores/user/users.erasurePorts.projects.test.js
+ */
+
+'use strict';
+
+process.env.NODE_ENV = 'test';
+
+const { test, before, after } = require('node:test');
+const assert = require('node:assert');
+
+const { usePglitePool } = require('../../testUtils/pglitePool');
+
+const { close } = usePglitePool();
+const users = require('./users');
+const { initDB } = require('./schema');
+const { resetErasurePortsForTests, registerErasurePorts } = require('./erasurePorts');
+const db = require('../../db');
+
+before(async () => {
+    await initDB();
+    await db.run(`INSERT INTO organizations (id, name) VALUES ('org1', 'Acme')`);
+    assert.strictEqual(await users.createUser({ id: 'alice', username: 'alice', passwordHash: '', organizationId: 'org1' }), true);
+});
+
+after(close);
+
+const stillThere = async (id) => !!(await db.getOne('SELECT id FROM users WHERE id = $1', [id]));
+
+test('deleteUser with the notebooks port registered and the projects port not rejects before any write', async () => {
+    resetErasurePortsForTests();
+    // Notebooks registered, projects not: still refused before the DELETE.
+    registerErasurePorts({ notebooks: { deleteAllForUser: async () => ({ notebooks: 0 }) } });
+    await assert.rejects(() => users.deleteUser('alice'), /Erasure port 'projects' is not registered/);
+    assert.strictEqual(await stillThere('alice'), true);
+    resetErasurePortsForTests();
+});
