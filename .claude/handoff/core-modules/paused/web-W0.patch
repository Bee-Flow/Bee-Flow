new file mode 100644
index 00000000..1060297b
--- /dev/null
+++ b/agent-hub/vite/beeflowModules.mjs
@@ -0,0 +1,192 @@
+/**
+ * The build side of the module host (src/moduleHost): which first-party module areas this web
+ * client is built with, and the refusal of a hidden module's files. Used by `vite build`, the
+ * dev server and vitest alike (registered in vite.config.js). node:* only.
+ *
+ * (a) `virtual:beeflow/first-party` exports AREAS, one row per area file
+ *     `src/firstParty/<id>.<zone>.ts(x)` of every root (agent-hub/ and modules/<id>/frontend/),
+ *     `{ id, zone, load: () => import(<file>) }`, and HIDE, the hidden module ids (or 'all').
+ *     An area of the zone `public` is imported statically, with the public shell; every other
+ *     zone's area is its own chunk, loaded with the core boundary that hosts its keys
+ *     (src/moduleHost/lazyZone.ts) and never with the entry.
+ * (c) BEEFLOW_HIDE_MODULES=all|<id>,<id> leaves the hidden modules' areas out, and any import of
+ *     a hidden module's file (static, `import()`, `import.meta.glob`) fails the build with a
+ *     message that names the file, the module and the importer. A file in modules/<id>/frontend
+ *     belongs to <id>; a file still in agent-hub/ belongs to whoever scripts/module-map.json says
+ *     (read when the checkout has it; the agent-hub image does not, and there only module roots
+ *     can be hidden), with the semantics of server/modules/roots/rootSet.cjs.
+ * (e) Once a module root exists: the dev server may read it, React is deduplicated across roots,
+ *     and vitest and the dependency scan include its sources.
+ *
+ * Seams, for later slices of plan phase 2 (DESIGN.md A3):
+ * (b) `virtual:beeflow/en-namespaces` (the i18n chunk loaders over every root): slice W5.
+ * (d) resolving a request by TREE PATH over the roots (a moved file found at its old path from a
+ *     core importer): slice W7. Until then a module root holds only files no core file imports.
+ */
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+export const FIRST_PARTY_VIRTUAL = 'virtual:beeflow/first-party';
+const RESOLVED_VIRTUAL = `\0${FIRST_PARTY_VIRTUAL}`;
+export const AREA_ZONES = ['boot', 'public', 'hub', 'studio', 'admin', 'settings', 'docs', 'demo'];
+/** Zones whose area files are imported statically: they render with the entry, before any lazy boundary. */
+const STATIC_ZONES = new Set(['public']);
+const AREA_FILE = /^([A-Za-z][A-Za-z0-9_]*)\.([a-z]+)\.tsx?$/;
+
+const slash = (p) => p.split(path.sep).join('/');
+
+/** @param {string | undefined} value BEEFLOW_HIDE_MODULES */
+export function parseHide(value) {
+    return String(value || '').split(',').map((s) => s.trim()).filter(Boolean);
+}
+
+/** @param {string[]} hide */
+const isHidden = (hide, id) => !!id && (hide.includes('all') || hide.includes(id));
+
+/**
+ * The roots of the web client: agent-hub/ (id null) and every modules/<id>/frontend/ that exists.
+ * @param {{ hubDir: string, modulesDir: string }} dirs
+ * @returns {{ id: string | null, dir: string }[]}
+ */
+export function webRoots({ hubDir, modulesDir }) {
+    const roots = [{ id: null, dir: hubDir }];
+    if (!fs.existsSync(modulesDir)) return roots;
+    for (const e of fs.readdirSync(modulesDir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name))) {
+        const dir = path.join(modulesDir, e.name, 'frontend');
+        if (e.isDirectory() && fs.existsSync(path.join(dir, 'src'))) roots.push({ id: e.name, dir });
+    }
+    return roots;
+}
+
+/**
+ * Every area file of every root, minus the hidden modules', sorted by module then zone.
+ * @param {{ id: string | null, dir: string }[]} roots
+ * @param {string[]} hide
+ * @returns {{ id: string, zone: string, file: string }[]}
+ */
+export function listAreas(roots, hide) {
+    const out = [];
+    for (const root of roots) {
+        const dir = path.join(root.dir, 'src', 'firstParty');
+        if (!fs.existsSync(dir)) continue;
+        for (const name of fs.readdirSync(dir).sort()) {
+            if (/\.(test|testkit|fixture)\.|\.d\.ts$|\.generated\./.test(name)) continue;
+            const m = AREA_FILE.exec(name);
+            if (!m) continue;
+            const [, id, zone] = m;
+            if (!AREA_ZONES.includes(zone)) throw new Error(`beeflow-modules: ${slash(path.join(dir, name))}: "${zone}" is no zone (${AREA_ZONES.join(', ')})`);
+            if (root.id && root.id !== id) throw new Error(`beeflow-modules: ${slash(path.join(dir, name))} is an area of "${id}" in the root of "${root.id}"`);
+            if (isHidden(hide, id)) continue;
+            out.push({ id, zone, file: path.join(dir, name) });
+        }
+    }
+    return out.sort((a, b) => a.id.localeCompare(b.id) || a.zone.localeCompare(b.zone));
+}
+
+/**
+ * The source of `virtual:beeflow/first-party`.
+ * @param {{ id: string, zone: string, file: string }[]} areas
+ * @param {string[]} hide
+ */
+export function renderFirstParty(areas, hide) {
+    const lines = ['// Generated by agent-hub/vite/beeflowModules.mjs: the area files of this build.'];
+    const rows = areas.map((a, i) => {
+        const spec = JSON.stringify(slash(a.file));
+        if (!STATIC_ZONES.has(a.zone)) return `    { id: ${JSON.stringify(a.id)}, zone: ${JSON.stringify(a.zone)}, load: () => import(${spec}) },`;
+        lines.push(`import * as area${i} from ${spec};`);
+        return `    { id: ${JSON.stringify(a.id)}, zone: ${JSON.stringify(a.zone)}, load: () => Promise.resolve(area${i}) },`;
+    });
+    return [...lines, `export const HIDE = ${JSON.stringify(hide)};`, 'export const AREAS = [', ...rows, '];', ''].join('\n');
+}
+
+/**
+ * Who owns a file of the web client: the module of the root it lies in, else the ownership map
+ * (`ownerOf('agent-hub', treePath)`), else nobody (the core). Files outside src/ and in
+ * node_modules belong to nobody.
+ * @param {{ id: string | null, dir: string }[]} roots
+ * @param {((pkg: string, treePath: string) => string | null) | null} mapOwner
+ */
+export function ownerResolver(roots, mapOwner) {
+    const cache = new Map();
+    return (file) => {
+        const clean = file.split('?')[0];
+        if (cache.has(clean)) return cache.get(clean);
+        let owner = null;
+        if (path.isAbsolute(clean) && !clean.includes(`${path.sep}node_modules${path.sep}`)) {
+            const root = [...roots].reverse().find((r) => clean.startsWith(r.dir + path.sep));
+            const treePath = root ? slash(path.relative(root.dir, clean)) : null;
+            if (root && treePath.startsWith('src/')) owner = root.id ?? (mapOwner ? mapOwner('agent-hub', treePath) : null);
+        }
+        cache.set(clean, owner);
+        return owner;
+    };
+}
+
+/** The message of a refused import. */
+export function hiddenImportMessage({ file, owner, importer, hubDir }) {
+    const rel = (p) => slash(path.relative(path.dirname(hubDir), p));
+    return `Cannot import ${rel(file)}: module "${owner}" is not present (BEEFLOW_HIDE_MODULES)` + (importer ? `; imported by ${rel(importer.split('?')[0])}` : '');
+}
+
+/**
+ * @param {{ hubDir?: string, repoDir?: string, env?: Record<string, string | undefined> }} [opts]
+ */
+export function beeflowModules({ hubDir = path.resolve(import.meta.dirname, '..'), repoDir = path.resolve(hubDir, '..'), env = process.env } = {}) {
+    const hide = parseHide(env.BEEFLOW_HIDE_MODULES);
+    const modulesDir = path.join(repoDir, 'modules');
+    const roots = webRoots({ hubDir, modulesDir });
+    const areaDirs = roots.map((r) => path.join(r.dir, 'src', 'firstParty'));
+    let ownerOf = null;
+
+    async function loadOwner() {
+        const lib = path.join(repoDir, 'scripts', 'module-map.mjs');
+        const map = fs.existsSync(lib) ? (await import(pathToFileURL(lib).href)).loadModuleMap(repoDir) : null;
+        ownerOf = ownerResolver(roots, map ? (pkg, p) => map.ownerOf(pkg, p) : null);
+    }
+
+    return {
+        name: 'beeflow-modules',
+        enforce: 'pre',
+        config() {
+            const moduleRoots = roots.filter((r) => r.id);
+            if (!moduleRoots.length) return null;
+            const srcs = moduleRoots.map((r) => slash(path.relative(hubDir, path.join(r.dir, 'src'))));
+            return {
+                server: { fs: { allow: moduleRoots.map((r) => r.dir) } },
+                resolve: { dedupe: ['react', 'react-dom'] },
+                optimizeDeps: { entries: srcs.map((s) => `${s}/**/*.{ts,tsx}`) },
+                test: { include: ['**/*.{test,spec}.?(c|m)[jt]s?(x)', ...srcs.map((s) => `${s}/**/*.{test,spec}.?(c|m)[jt]s?(x)`)] },
+            };
+        },
+        async buildStart() {
+            if (hide.length) await loadOwner();
+        },
+        async resolveId(source, importer, options) {
+            if (source === FIRST_PARTY_VIRTUAL) return RESOLVED_VIRTUAL;
+            if (!hide.length || source.startsWith('\0') || source.startsWith('virtual:')) return null;
+            if (importer && (importer.startsWith('\0') || importer.includes('/node_modules/'))) return null;
+            if (!ownerOf) await loadOwner();
+            const resolved = await this.resolve(source, importer, { ...options, skipSelf: true });
+            if (!resolved || resolved.external) return resolved;
+            const owner = ownerOf(resolved.id);
+            if (owner && isHidden(hide, owner)) this.error(hiddenImportMessage({ file: resolved.id.split('?')[0], owner, importer, hubDir }));
+            return resolved;
+        },
+        load(id) {
+            if (id !== RESOLVED_VIRTUAL) return null;
+            return renderFirstParty(listAreas(roots, hide), hide);
+        },
+        configureServer(server) {
+            const changed = (file) => {
+                if (!areaDirs.some((d) => file.startsWith(d + path.sep))) return;
+                const mod = server.moduleGraph.getModuleById(RESOLVED_VIRTUAL);
+                if (mod) server.moduleGraph.invalidateModule(mod);
+                server.ws.send({ type: 'full-reload' });
+            };
+            server.watcher.on('add', changed);
+            server.watcher.on('unlink', changed);
+        },
+    };
+}
