@@ -0,0 +1,225 @@
+/**
+ * The module host's accessors, each kind in each state a module can be in on a page:
+ *   loaded        built, and the server loaded it
+ *   absent        built, but the server reports it absent (an edition without it)
+ *   not built     left out of this web build (BEEFLOW_HIDE_MODULES, a core image)
+ *   chunk failed  built and loaded, but its area file would not load on this page
+ *   fetch failed  the server's module states could not be read: every built module counts as loaded
+ * plus: a failing module chunk never reloads the page and never blanks its host, a zone's
+ * static part renders on the host's first commit, and the shell's boundary waits for the boot.
+ */
+import { act, render, screen } from '@testing-library/react';
+import { Suspense, useLayoutEffect, type ComponentType, type ReactNode } from 'react';
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { lazyEntry, type ModuleArea } from './contract';
+import { lazyZone, loadZone, moduleImport, moduleList, modulePart, moduleScreen, moduleState, moduleValue, moduleWrap, visibleByOwner } from './index';
+import { bootModules, isBooted, setModuleStateSource } from './registry';
+import { resetModules, withAreas, withModules } from './testing';
+
+// Made-up keys of the learning module, of every kind; the contract has none of them.
+const SCREEN = 'learning:TestScreen' as never;
+const PART = 'learning:TestPart' as never;
+const WRAP = 'learning:TestWrap' as never;
+const VALUE = 'learning:testValue' as never;
+const LIST = 'test.rows' as never;
+
+// The made-up keys have no props type in the contract: the tests render them as plain components.
+type Loose = ComponentType<{ children?: ReactNode }>;
+const screenOf = () => moduleScreen(SCREEN) as Loose;
+const partOf = () => modulePart(PART) as Loose;
+const wrapOf = () => moduleWrap(WRAP) as Loose;
+
+const Screen = () => <p>module screen</p>;
+const Part = () => <p>module part</p>;
+const Wrap = ({ children }: { children?: ReactNode }) => <section aria-label="module wrap">{children}</section>;
+const AREA = {
+    id: 'learning', zone: 'hub',
+    screens: { [SCREEN]: Screen }, parts: { [PART]: Part }, wraps: { [WRAP]: Wrap },
+    values: { [VALUE]: 'provided' }, lists: { [LIST]: ['row'] },
+} as unknown as ModuleArea;
+
+type Scenario = 'loaded' | 'absent' | 'not built' | 'chunk failed' | 'fetch failed';
+
+const chunkError = () => new TypeError('Failed to fetch dynamically imported module: /assets/learning.hub-x.js');
+
+/** Start the page in a scenario, boot it the way the shell does, and load the zone. */
+async function enter(scenario: Scenario) {
+    const load = scenario === 'chunk failed' ? () => Promise.reject(chunkError()) : async () => ({ default: AREA });
+    const server = scenario === 'absent' ? { learning: 'absent' as const } : { learning: 'loaded' as const };
+    setModuleStateSource(scenario === 'fetch failed' ? () => Promise.reject(new Error('503')) : async () => ({ modules: server }));
+    withAreas([{ id: 'learning', zone: 'hub', load }], { booted: false, hide: scenario === 'not built' ? ['learning'] : [] });
+    await loadZone('hub');
+}
+
+const EXPECT: Record<Scenario, { state: string; screen: string; part: boolean; wrapped: boolean; value: string; imported: string | null; rows: string[] }> = {
+    loaded: { state: 'loaded', screen: 'module screen', part: true, wrapped: true, value: 'provided', imported: 'provided', rows: ['row'] },
+    absent: { state: 'absent', screen: 'Not installed', part: false, wrapped: false, value: 'fallback', imported: null, rows: [] },
+    'not built': { state: 'absent', screen: 'Not installed', part: false, wrapped: false, value: 'fallback', imported: null, rows: [] },
+    'chunk failed': { state: 'failed', screen: 'Not available right now', part: false, wrapped: false, value: 'fallback', imported: null, rows: [] },
+    'fetch failed': { state: 'loaded', screen: 'module screen', part: true, wrapped: true, value: 'provided', imported: 'provided', rows: ['row'] },
+};
+
+afterEach(() => {
+    setModuleStateSource(async () => null);
+    resetModules();
+    vi.restoreAllMocks();
+});
+
+describe.each(Object.keys(EXPECT) as Scenario[])('a module that is %s', (scenario) => {
+    const want = EXPECT[scenario];
+    beforeEach(() => enter(scenario));
+
+    it(`has the state ${want.state}`, () => {
+        expect(moduleState('learning')).toBe(want.state);
+    });
+
+    it('screen', async () => {
+        const S = screenOf();
+        render(<Suspense fallback="loading"><S /></Suspense>);
+        expect(await screen.findByText(want.screen)).toBeInTheDocument();
+    });
+
+    it('part', async () => {
+        const P = partOf();
+        render(<div><span>host</span><P /></div>);
+        expect(screen.getByText('host')).toBeInTheDocument();
+        expect(!!screen.queryByText('module part')).toBe(want.part);
+    });
+
+    it('wrap', () => {
+        const W = wrapOf();
+        render(<W><span>core child</span></W>);
+        expect(screen.getByText('core child')).toBeInTheDocument();
+        expect(!!screen.queryByRole('region', { name: 'module wrap' })).toBe(want.wrapped);
+    });
+
+    it('value, frozen for the page', () => {
+        expect(moduleValue(VALUE, 'fallback' as never)).toBe(want.value);
+        expect(moduleValue(VALUE, 'another fallback' as never)).toBe(want.value);
+    });
+
+    it('import', async () => {
+        expect(await moduleImport(VALUE)).toBe(want.imported);
+    });
+
+    it('list', () => {
+        expect(moduleList(LIST)).toEqual(want.rows);
+    });
+});
+
+describe('failure stays inside the module', () => {
+    it('a lazy part whose chunk never loads leaves the host rendered, marks the module failed and never reloads', async () => {
+        const reload = vi.fn();
+        vi.spyOn(window, 'location', 'get').mockReturnValue({ ...window.location, reload } as Location);
+        sessionStorage.clear();
+        const area = { id: 'learning', zone: 'hub', parts: { [PART]: lazyEntry<object>(() => Promise.reject(chunkError())) } } as unknown as ModuleArea;
+        withAreas([{ id: 'learning', zone: 'hub', load: async () => ({ default: area }) }]);
+        await loadZone('hub');
+        const P = partOf();
+        vi.spyOn(console, 'warn').mockImplementation(() => {});
+        vi.spyOn(console, 'error').mockImplementation(() => {});
+        render(<Suspense fallback={<span>part loading</span>}><main><span>host</span><P /></main></Suspense>);
+        await act(() => new Promise((r) => setTimeout(r, 400)));
+        expect(screen.getByText('host')).toBeInTheDocument();
+        expect(screen.queryByText('part loading')).toBeNull();
+        expect(moduleState('learning')).toBe('failed');
+        expect(reload).not.toHaveBeenCalled();
+        expect(sessionStorage.getItem('beeflow-chunk-reload')).toBeNull();
+    });
+
+    it('every module failed: the host still renders, its parts are empty, its screens say unavailable', async () => {
+        vi.spyOn(console, 'warn').mockImplementation(() => {});
+        withAreas([{ id: 'learning', zone: 'hub', load: () => Promise.reject(chunkError()) }], { server: { learning: 'failed', cowork: 'failed' } });
+        await loadZone('hub');
+        const P = partOf();
+        const S = screenOf();
+        render(<main><span>host</span><P /><S /></main>);
+        expect(screen.getByText('host')).toBeInTheDocument();
+        expect(screen.queryByText('module part')).toBeNull();
+        expect(screen.getByText('Not available right now')).toBeInTheDocument();
+    });
+});
+
+describe('zones', () => {
+    it('a part an area provides as a component is in the DOM on the host boundary\'s first commit', async () => {
+        withAreas([{ id: 'learning', zone: 'settings', load: async () => ({ default: { ...AREA, zone: 'settings' } }) }]);
+        const P = partOf();
+        const seen: boolean[] = [];
+        function SettingsHost() {
+            useLayoutEffect(() => { seen.push(!!document.querySelector('p')?.textContent?.includes('module part')); }, []);
+            return <div><span>settings host</span><P /></div>;
+        }
+        const Host = lazyZone('settings', async () => ({ default: SettingsHost }));
+        render(<Suspense fallback={<span>fallback</span>}><Host /></Suspense>);
+        expect(await screen.findByText('settings host')).toBeInTheDocument();
+        expect(seen).toEqual([true]);
+    });
+
+    it('a lazy part suspends to the host\'s own boundary, as the core\'s lazy import did', async () => {
+        const area = { id: 'learning', zone: 'hub', parts: { [PART]: lazyEntry(async () => ({ default: Part })) } } as unknown as ModuleArea;
+        withAreas([{ id: 'learning', zone: 'hub', load: async () => ({ default: area }) }]);
+        await loadZone('hub');
+        const P = partOf();
+        render(<Suspense fallback={<span>host fallback</span>}><span>host</span><P /></Suspense>);
+        expect(screen.getByText('host fallback')).toBeInTheDocument();
+        expect(await screen.findByText('module part')).toBeInTheDocument();
+    });
+
+    it('a key asked for outside its zone loads its area first', async () => {
+        withAreas([{ id: 'learning', zone: 'studio', load: async () => ({ default: { ...AREA, zone: 'studio' } }) }]);
+        const P = partOf();
+        render(<Suspense fallback="loading"><P /></Suspense>);
+        expect(await screen.findByText('module part')).toBeInTheDocument();
+    });
+});
+
+describe('boot', () => {
+    it('reads the server once per page; a slow server counts as no answer after 3 s', async () => {
+        vi.useFakeTimers();
+        try {
+            const source = vi.fn(() => new Promise<never>(() => {}));
+            setModuleStateSource(source);
+            withAreas([], { booted: false });
+            const booted = bootModules();
+            expect(bootModules()).toBe(booted);
+            expect(isBooted()).toBe(false);
+            await vi.advanceTimersByTimeAsync(3000);
+            await booted;
+            expect(isBooted()).toBe(true);
+            expect(source).toHaveBeenCalledTimes(1);
+            expect(moduleState('learning')).toBe('loaded');
+        } finally {
+            vi.useRealTimers();
+        }
+    });
+
+    it('an unknown answer or an unknown id counts as no opinion; a known one is taken', async () => {
+        setModuleStateSource(async () => ({ modules: { learning: 'absent', nonsense: 'absent', cowork: 'sideways' } }));
+        withAreas([], { booted: false });
+        await bootModules();
+        expect(moduleState('learning')).toBe('absent');
+        expect(moduleState('cowork')).toBe('loaded');
+    });
+
+    it('a read before the boot fails loudly in tests', () => {
+        withAreas([], { booted: false });
+        expect(() => moduleState('learning')).toThrow(/before bootModules/);
+        expect(() => moduleValue(VALUE, 'x' as never)).toThrow(/before bootModules/);
+    });
+
+    it('a screen rendered before the boot waits for it', async () => {
+        setModuleStateSource(async () => ({ modules: { learning: 'absent' } }));
+        withAreas([], { booted: false });
+        const S = screenOf();
+        render(<Suspense fallback="booting"><S /></Suspense>);
+        expect(await screen.findByText('Not installed')).toBeInTheDocument();
+    });
+});
+
+describe('rows', () => {
+    it('visibleByOwner keeps every row while no owner table names it', () => {
+        withModules({ learning: 'absent' });
+        const rows = [{ id: 'agents' }, { id: 'learning' }];
+        expect(visibleByOwner('settings', rows, (r) => r.id)).toEqual(rows);
+    });
+});
