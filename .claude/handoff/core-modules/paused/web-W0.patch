index 00000000..06d7010e
--- /dev/null
+++ b/agent-hub/src/moduleHost/loadModuleChunk.ts
@@ -0,0 +1,31 @@
+import { logger } from '../utils/logger';
+
+/**
+ * Load a chunk of a first-party module (an area file, or a component an area provides with
+ * lazyEntry): one retry after a short pause, then the failure is reported through `onFailed`
+ * (the registry marks the module 'failed' for this page), logged, and rethrown.
+ *
+ * Unlike the core's own lazy boundaries (utils/lazyWithReload.ts) this never reloads the page
+ * and never touches the reload flag: a module that cannot load is a missing part of the page,
+ * not a reason to throw away the page the person is on. Its host decides what to show
+ * (ModuleUnavailable, nothing, or the bare children).
+ */
+export async function loadModuleChunk<T>(
+    moduleId: string,
+    importer: () => Promise<T>,
+    { onFailed, retryDelayMs = 250 }: { onFailed: (moduleId: string, err: unknown) => void; retryDelayMs?: number },
+): Promise<T> {
+    try {
+        return await importer();
+    } catch (first) {
+        logger.debug(`module ${moduleId}: chunk failed to load, retrying once`, first);
+    }
+    await new Promise((resolve) => setTimeout(resolve, retryDelayMs));
+    try {
+        return await importer();
+    } catch (err) {
+        logger.warn(`module ${moduleId}: chunk failed to load twice; the module is unavailable on this page`, err);
+        onFailed(moduleId, err);
+        throw err;
+    }
+}
