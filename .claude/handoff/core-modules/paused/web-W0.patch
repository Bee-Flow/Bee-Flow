@@ -0,0 +1,25 @@
+import type { MouseEvent } from 'react';
+import { useTranslation } from '../hooks/useTranslation';
+import { navigate } from '../router/history';
+
+/**
+ * What a screen of an absent first-party module shows, inside the shell: its address still
+ * parses, and the page says plainly that this part is not installed here. Nothing that sells
+ * it (DESIGN.md, decision 6): no lock, no upgrade text, one way back to the app.
+ */
+export default function ModuleNotInstalled() {
+    const { t } = useTranslation();
+    const toApp = (e: MouseEvent<HTMLAnchorElement>) => {
+        e.preventDefault();
+        navigate('/app');
+    };
+    return (
+        <div role="status" className="h-full flex flex-col items-center justify-center px-6 py-12 text-center">
+            <div className="text-lg font-semibold text-[var(--text-primary)] mb-2">{t('module_host.not_installed_title')}</div>
+            <div className="text-sm text-[var(--text-tertiary)] mb-6 max-w-md leading-relaxed">{t('module_host.not_installed_body')}</div>
+            <a href="/app" onClick={toApp} className="text-sm font-medium text-[var(--accent-primary)] hover:underline">
+                {t('module_host.back_to_app')}
+            </a>
+        </div>
+    );
+}
