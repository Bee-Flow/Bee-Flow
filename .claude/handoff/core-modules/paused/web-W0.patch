index 00000000..ad8d08e7
--- /dev/null
+++ b/agent-hub/src/test/guiInventory/areaKeys.ts
@@ -0,0 +1,77 @@
+/**
+ * The keys of the module host (src/moduleHost) as the GUI inventory reads them: per key
+ * (`<id>:<Export>`), the file the area file of its module (src/firstParty/<id>.<zone>.tsx,
+ * any root) provides it from, so a lookup reads as the import it replaced (sourceAst.ts).
+ */
+
+import fs from 'node:fs';
+import ts from 'typescript';
+import { importBindings, resolveImport } from './imports';
+import { webFile, webFilesUnder } from './ownership';
+
+const AREA_KINDS = new Set(['screens', 'parts', 'wraps']);
+const AREA_DIR = 'src/firstParty';
+
+/** Module-host key (`<id>:<Export>`) -> tree path of the file its area file provides it from. */
+export type KeyFiles = ReadonlyMap<string, string>;
+
+/** The tree path of the first `import('…')` inside an expression (a `lazyEntry(() => import('…'))`). */
+function importedFile(node: ts.Node, from: string): string | null {
+    let found: string | null = null;
+    const visit = (n: ts.Node) => {
+        if (found) return;
+        if (ts.isCallExpression(n) && n.expression.kind === ts.SyntaxKind.ImportKeyword) {
+            const arg = n.arguments[0];
