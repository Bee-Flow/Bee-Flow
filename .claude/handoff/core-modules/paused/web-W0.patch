+++ b/agent-hub/src/moduleHost/lazyZone.ts
@@ -0,0 +1,29 @@
+import type { ComponentType, ExoticComponent } from 'react';
+import type { ZoneKey } from './contract';
+import { loadZone } from './registry';
+import { importerId, lazy, lazyWithI18n } from '../utils/lazyWithReload';
+
+type PropsOf<T> = T extends ComponentType<infer P> ? P : never;
+
+/**
+ * A core lazy boundary that hosts the keys of a zone: `lazyZone('settings', () => import('./X'))`
+ * in place of `lazy(() => import('./X'))`. The host's chunk and the area files of the zone's
+ * loaded modules load in parallel, and the boundary resolves once both are in, so a part an
+ * area provides as a component renders on the host's first commit (no Suspense fallback, no
+ * layout shift). The host keeps lazyWithReload's retry and reload; an area that fails to load
+ * makes only its module 'failed' (registry.loadChunk), never the host.
+ */
+export function lazyZone<T>(zone: ZoneKey, importer: () => Promise<{ default: T }>): ExoticComponent<PropsOf<T>>;
+export function lazyZone(zone: ZoneKey, importer: () => Promise<{ default: ComponentType }>): ExoticComponent {
+    return lazy(() => Promise.all([importer(), loadZone(zone)]).then(([m]) => m), importerId(importer));
+}
+
+/**
+ * The boundary of the signed-in shell (AppRoutes.tsx): the AuthedApp chunk, the English
+ * catalogue, the server's module states (bootModules) and the area files of the zone `boot`,
+ * all in parallel. A marketing pageview never reaches it, so no module code joins the entry.
+ */
+export function lazyWithShell<T>(importer: () => Promise<{ default: T }>): ExoticComponent<PropsOf<T>>;
+export function lazyWithShell(importer: () => Promise<{ default: ComponentType }>): ExoticComponent {
+    return lazyWithI18n(() => Promise.all([importer(), loadZone('boot')]).then(([m]) => m), importerId(importer));
+}
