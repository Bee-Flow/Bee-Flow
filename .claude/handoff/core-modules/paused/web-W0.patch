diff --git a/agent-hub/src/moduleHost/registry.ts b/agent-hub/src/moduleHost/registry.ts
new file mode 100644
index 00000000..8f5db687
--- /dev/null
+++ b/agent-hub/src/moduleHost/registry.ts
@@ -0,0 +1,236 @@
+/**
+ * The module host's state for one page: which first-party modules this web client was built
+ * with, which of them the server loaded, which area files have loaded, and which modules failed
+ * on this page.
+ *
+ * The ONLY importer of `virtual:beeflow/*` (eslint: no-restricted-imports): the build plugin
+ * (agent-hub/vite/beeflowModules.mjs) lists the area files of every root, minus the modules
+ * BEEFLOW_HIDE_MODULES hides, and this file turns that list into answers.
+ *
+ * A module is 'loaded' when it is built (not hidden) and the server did not report it absent or
+ * failed; on no answer from the server (an old server, a 404, an error, 3 s) every built module
+ * counts as loaded, which is what the client did before modules existed. The answer is read once
+ * per page (bootModules) and then frozen, so the accessors give a component the same answer on
+ * every render and hooks keep their order; only a chunk that fails on this page turns its module
+ * 'failed' afterwards.
+ */
+
+import { AREAS, HIDE } from 'virtual:beeflow/first-party';
+import type { FirstPartyId, ModuleArea, ModuleState, ZoneKey } from './contract';
+import { FIRST_PARTY_IDS } from './ids.generated';
+import { loadModuleChunk } from './loadModuleChunk';
+import { logger } from '../utils/logger';
+
+/** One area file of the build: module, zone, and the import of its chunk. */
+export interface AreaRecord {
+    id: FirstPartyId;
+    zone: ZoneKey;
+    load: () => Promise<{ default: ModuleArea }>;
+}
+
+/** What the server says (GET /api/modules/first-party): module id -> state. */
+export type ServerModuleStates = Partial<Record<FirstPartyId, ModuleState>>;
+type StateSource = () => Promise<unknown>;
+
+const STATE_TIMEOUT_MS = 3000;
+const KNOWN = new Set<string>(FIRST_PARTY_IDS);
+
+export function isFirstPartyId(id: string): id is FirstPartyId {
+    return KNOWN.has(id);
+}
+
+function buildAreas(raw: readonly { id: string; zone: string; load: () => Promise<{ default: unknown }> }[]): AreaRecord[] {
+    return raw.filter((a) => isFirstPartyId(a.id)).map((a) => a as AreaRecord);
+}
+
+interface HostState {
+    areas: AreaRecord[];
+    hidden: (id: FirstPartyId) => boolean;
+    server: ServerModuleStates | null;
+    failed: Set<FirstPartyId>;
+    loaded: Map<AreaRecord, ModuleArea>;
+    loading: Map<AreaRecord, Promise<void>>;
+    boot: Promise<void> | null;
+    booted: boolean;
+}
+
+function hiddenBy(hide: readonly string[]): (id: FirstPartyId) => boolean {
+    const all = hide.includes('all');
+    return (id) => all || hide.includes(id);
+}
+
+function freshState(areas: AreaRecord[], hide: readonly string[]): HostState {
+    return { areas, hidden: hiddenBy(hide), server: null, failed: new Set(), loaded: new Map(), loading: new Map(), boot: null, booted: false };
+}
+
+let host = freshState(buildAreas(AREAS), HIDE);
+let stateSource: StateSource = async () => null;
+const resetListeners = new Set<() => void>();
+
+/** Dev and test fail loudly on a read before bootModules(); production answers as if every built module loaded. */
+const STRICT = !!import.meta.env.DEV;
+
+/**
+ * Where bootModules reads the server's answer. The server route (GET /api/modules/first-party,
+ * plan phase 2 slice WS) does not exist yet: until it is wired here, no request is made and every
+ * built module counts as loaded.
+ */
+export function setModuleStateSource(source: StateSource): void {
+    stateSource = source;
+}
+
+function parseStates(body: unknown): ServerModuleStates | null {
+    const modules = (body as { modules?: unknown } | null)?.modules;
+    if (!modules || typeof modules !== 'object') return null;
+    const out: ServerModuleStates = {};
+    for (const [id, state] of Object.entries(modules as Record<string, unknown>)) {
+        if (isFirstPartyId(id) && (state === 'loaded' || state === 'absent' || state === 'failed')) out[id] = state;
+    }
+    return out;
+}
+
+async function readServerStates(): Promise<ServerModuleStates | null> {
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    const timeout = new Promise<null>((resolve) => { timer = setTimeout(() => resolve(null), STATE_TIMEOUT_MS); });
+    try {
+        return parseStates(await Promise.race([stateSource(), timeout]));
+    } catch (err) {
+        logger.debug('module host: no module states from the server; every built module counts as loaded', err);
+        return null;
+    } finally {
+        clearTimeout(timer);
+    }
+}
+
+/** Read the server's module states once per page. Never rejects; idempotent. */
+export function bootModules(): Promise<void> {
+    if (host.boot) return host.boot;
+    const at = host;
+    at.boot = readServerStates().then((server) => {
+        at.server = server;
+        at.booted = true;
+    });
+    return at.boot;
+}
+
+export function isBooted(): boolean {
+    return host.booted;
+}
+
+/** True once booted. Before that: throws in dev and test, false in production. */
+export function assertBooted(what: string): boolean {
+    if (host.booted) return true;
+    if (STRICT) throw new Error(`module host: ${what} was read before bootModules() resolved`);
+    return false;
+}
+
+function isBuilt(id: FirstPartyId): boolean {
+    return !host.hidden(id);
+}
+
+/** The state of a module on this page. */
+export function moduleState(id: FirstPartyId): ModuleState {
+    if (!isBuilt(id)) return 'absent';
+    if (!assertBooted(`moduleState('${id}')`)) return 'loaded';
+    const server = host.server?.[id];
+    if (server === 'absent') return 'absent';
+    if (server === 'failed' || host.failed.has(id)) return 'failed';
+    return 'loaded';
+}
+
+/** Is the module there (loaded, or there but failed)? False only when it is absent: its rows go. */
+export function moduleAvailable(id: FirstPartyId): boolean {
+    return moduleState(id) !== 'absent';
+}
+
+/** Mark a module failed for the rest of this page (a chunk of it would not load). */
+function markModuleFailed(id: string): void {
+    if (isFirstPartyId(id)) host.failed.add(id);
+}
+
+/** Load a module chunk: one retry, then the module is failed on this page; never a reload. */
+export function loadChunk<T>(id: FirstPartyId, importer: () => Promise<T>): Promise<T> {
+    return loadModuleChunk(id, importer, { onFailed: markModuleFailed });
+}
+
+function loadArea(area: AreaRecord): Promise<void> {
+    const pending = host.loading.get(area);
+    if (pending) return pending;
+    const at = host;
+    const p = loadChunk(area.id, area.load).then(
+        (mod) => { at.loaded.set(area, mod.default); },
+        () => undefined,
+    );
+    at.loading.set(area, p);
+    return p;
+}
+
+function loadAreas(areas: AreaRecord[]): Promise<void> {
+    return Promise.allSettled(areas.filter((a) => moduleState(a.id) === 'loaded').map(loadArea)).then(() => undefined);
+}
+
+/** Boot, then load the area files of every loaded module in one zone. Never rejects. */
+export async function loadZone(zone: ZoneKey): Promise<void> {
+    await bootModules();
+    await loadAreas(host.areas.filter((a) => a.zone === zone));
+}
+
+/** Boot, then load every area file of one module (a key asked for outside its zone). Never rejects. */
+export async function loadAreasOf(id: FirstPartyId): Promise<void> {
+    await bootModules();
+    await loadAreas(host.areas.filter((a) => a.id === id));
+}
+
+type MapKind = 'screens' | 'parts' | 'wraps' | 'values';
+
+type EntryLookup =
+    | { found: true; entry: unknown }
+    | { found: false; pending: boolean };
+
+/** What the loaded area files of a key's module provide for it; `pending` while one of them has not loaded. */
+export function findEntry(kind: MapKind, key: string, id: FirstPartyId): EntryLookup {
+    let pending = false;
+    for (const area of host.areas) {
+        if (area.id !== id) continue;
+        const mod = host.loaded.get(area);
+        if (!mod) {
+            pending ||= !host.failed.has(id);
+            continue;
+        }
+        const map = mod[kind] as Record<string, unknown> | undefined;
+        if (map && Object.hasOwn(map, key)) return { found: true, entry: map[key] };
+    }
+    return { found: false, pending };
+}
+
+/** The rows the loaded areas of available modules add to a list, in the order of the build's area list. */
+export function listRows(list: string): unknown[] {
+    if (!assertBooted(`moduleList('${list}')`)) return [];
+    const rows: unknown[] = [];
+    for (const area of host.areas) {
+        const mod = host.loaded.get(area);
+        if (!mod || moduleState(area.id) !== 'loaded') continue;
+        const contributed = (mod.lists as Record<string, readonly unknown[]> | undefined)?.[list];
+        if (contributed) rows.push(...contributed);
+    }
+    return rows;
+}
+
+/** Called when the state is reset (tests): the accessors drop what they froze. */
+export function onHostReset(listener: () => void): void {
+    resetListeners.add(listener);
+}
+
+/**
+ * Tests only (src/moduleHost/testing.ts): start the page over with other areas, hidden modules
+ * or server states. `undefined` keeps the build's own list.
+ */
+export function resetModuleHost(opts: { areas?: AreaRecord[]; hide?: readonly string[]; server?: ServerModuleStates | null; booted?: boolean } = {}): void {
+    host = freshState(opts.areas ?? buildAreas(AREAS), opts.hide ?? HIDE);
+    if (opts.booted !== false) {
+        host.server = opts.server ?? null;
+        host.booted = true;
+        host.boot = Promise.resolve();
+    }
+    for (const listener of resetListeners) listener();
+}
diff --git a/agent-hub/src/moduleHost/testing.ts b/agent-hub/src/moduleHost/testing.ts
new file mode 100644
index 00000000..c1970933
--- /dev/null
+++ b/agent-hub/src/moduleHost/testing.ts
@@ -0,0 +1,49 @@
+/**
+ * Test helpers for the module host. src/test/setup.ts boots the host once per test file with
+ * no server answer (every built module loaded); a suite that needs another state starts the
+ * page over with one of these, and calls the returned function (or resetModules) afterwards.
+ *
+ *   withModules({ cowork: 'absent', learning: 'failed' })   as if the server said so
+ *   withModules({ learning: 'absent' }, { built: false })  as if the build left them out
+ *   await mockModulePart('learning:LessonPlayerHost', Stub) provide one key without its area file
+ *   withAreas([...])                                         a made-up set of area files
+ */
+
+import type { ComponentType } from 'react';
+import type { FirstPartyId, ModuleArea, ModuleParts, ModuleState, ZoneKey } from './contract';
+import { loadZone, resetModuleHost, type AreaRecord, type ServerModuleStates } from './registry';
+
+type Restore = () => void;
+
+/** Start over with the build's own areas, nothing hidden beyond the build's, every built module loaded. */
+export function resetModules(): void {
+    resetModuleHost();
+}
+
+/**
+ * Start the page over with these module states. `built: false` hides the modules from the
+ * build instead (BEEFLOW_HIDE_MODULES), the other way a module is absent.
+ */
+export function withModules(states: Partial<Record<FirstPartyId, ModuleState>>, { built = true }: { built?: boolean } = {}): Restore {
+    if (built) resetModuleHost({ server: states as ServerModuleStates });
+    else resetModuleHost({ hide: Object.keys(states) });
+    return resetModules;
+}
+
+/** Start the page over with these area files in place of the build's (a missing `load` result fails like a missing chunk). */
+export function withAreas(areas: { id: FirstPartyId; zone: ZoneKey; load: () => Promise<{ default: ModuleArea }> }[], opts: { server?: ServerModuleStates; hide?: string[]; booted?: boolean } = {}): Restore {
+    resetModuleHost({ areas: areas as AreaRecord[], ...opts });
+    return resetModules;
+}
+
+/**
+ * Provide one part by key, as a component of a made-up area file of its module (every module
+ * loaded, the area already in), so it renders on the first commit.
+ */
+export async function mockModulePart<K extends keyof ModuleParts>(key: K, component: ComponentType<ModuleParts[K]>, zone: ZoneKey = 'boot'): Promise<Restore> {
+    const id = key.slice(0, key.indexOf(':')) as FirstPartyId;
+    const area: ModuleArea = { id, zone, parts: { [key]: component } };
+    const restore = withAreas([{ id, zone, load: async () => ({ default: area }) }]);
+    await loadZone(zone);
+    return restore;
+}
