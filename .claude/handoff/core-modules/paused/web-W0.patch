+/**
+ * Whose row is it: per shell list (a HOST), the rows a first-party module owns.
+ *
+ * The shell lists themselves (STUDIO_SECTIONS, ADMIN_TABS, the settings routes, the sidebar
+ * builders, the organisation sections, PAGE_ROUTES, DEMO_FEATURES) stay where they are, byte
+ * for byte (DESIGN.md, decision 1). A table here only says whose a row is, and visibleByOwner
+ * (src/moduleHost) drops the rows of an absent module before any gate or lock logic sees them,
+ * so an absent module has no locked row and no teaser. One file per host, so the slices that
+ * fill them do not write the same file.
+ */
+
+import type { FirstPartyId } from '../contract';
+import { ADMIN_OWNERS } from './admin';
+import { DEMO_OWNERS } from './demo';
+import { ORG_SECTION_OWNERS } from './orgSections';
+import { PAGE_OWNERS } from './pages';
+import { SETTINGS_OWNERS } from './settings';
+import { SIDEBAR_OWNERS } from './sidebar';
+import { STUDIO_OWNERS } from './studio';
+import type { OwnerTable } from './table';
+
+const OWNER_TABLES = {
+    studio: STUDIO_OWNERS,
+    sidebar: SIDEBAR_OWNERS,
+    admin: ADMIN_OWNERS,
+    settings: SETTINGS_OWNERS,
+    pages: PAGE_OWNERS,
+    orgSections: ORG_SECTION_OWNERS,
+    demo: DEMO_OWNERS,
+} as const satisfies Record<string, OwnerTable>;
+
+export type OwnerHost = keyof typeof OWNER_TABLES;
+
+/** The module that owns a row of a host's list, or null for a core row. */
+export function ownerOfRow(host: OwnerHost, key: string): FirstPartyId | null {
+    const table: OwnerTable = OWNER_TABLES[host];
+    return (Object.hasOwn(table, key) && table[key]) || null;
+}
