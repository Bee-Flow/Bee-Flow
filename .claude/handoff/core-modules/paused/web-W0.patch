diff --git a/agent-hub/src/moduleHost/index.ts b/agent-hub/src/moduleHost/index.ts
new file mode 100644
index 00000000..f6aa552d
--- /dev/null
+++ b/agent-hub/src/moduleHost/index.ts
@@ -0,0 +1,182 @@
+/**
+ * The module host: how the core asks a first-party module for what it shows, by key
+ * (`<moduleId>:<Export>`, contract.ts), and what it gets when the module is not there.
+ *
+ *   moduleScreen(k)   a page or panel   absent -> ModuleNotInstalled, failed -> ModuleUnavailable
+ *   modulePart(k)     a part of a core screen          absent or failed -> nothing
+ *   moduleWrap(k)     a provider around core children  absent or failed -> the children alone
+ *   moduleValue(k, a) a function, hook or constant     absent -> `a`; frozen per page
+ *   moduleImport(k)   the same, at callback time       absent -> null
+ *   moduleList(l)     rows modules add to a core list  absent -> none
+ *   visibleByOwner(host, rows, keyOf)  the rows of a shell list without those of absent modules
+ *
+ * The components are made once per key at module scope (`const X = modulePart('…')`) and decide
+ * at render time. A key provided as a component renders on the first commit of its zone; a key
+ * provided with lazyEntry suspends to the host's own Suspense boundary, as the core's lazy
+ * import did. Nothing here adds a Suspense boundary or reloads the page.
+ */
+
+import { createElement, Fragment, lazy, type ComponentType, type ReactNode } from 'react';
+import { isLazyEntry, type FirstPartyId, type ModuleLists, type ModuleParts, type ModuleScreens, type ModuleValues, type ModuleWraps } from './contract';
+import ModuleBoundary from './ModuleBoundary';
+import ModuleNotInstalled from './ModuleNotInstalled';
+import ModuleUnavailable from './ModuleUnavailable';
+import { ownerOfRow, type OwnerHost } from './owners';
+import {
+    assertBooted, bootModules, findEntry, isBooted, isFirstPartyId, listRows, loadAreasOf, loadChunk, moduleAvailable,
+    moduleState, onHostReset,
+} from './registry';
+import { logger } from '../utils/logger';
+
+// Area files import defineModuleArea and lazyEntry from ./contract; AppRoutes imports lazyWithShell from ./lazyZone.
+export { loadZone, moduleState } from './registry';
+export { lazyZone } from './lazyZone';
+
+type ComponentKind = 'screens' | 'parts' | 'wraps';
+/** Props as a host passes them on: the key's own, plus the children of a wrap. */
+type HostedProps<P> = P & { children?: ReactNode };
+
+// Per key, made once and kept for the page. The props differ per key, so the maps hold
+// `unknown` and each accessor reads its entry back at the props type of its key.
+const components = new Map<string, unknown>();
+const resolved = new Map<string, unknown>();
+const bootGates = new Map<string, unknown>();
+const values = new Map<string, unknown>();
+const warned = new Set<string>();
+onHostReset(() => { resolved.clear(); bootGates.clear(); values.clear(); warned.clear(); });
+
+/** The module id of a key, `<id>:<Export>`. */
+function idOfKey(key: string): FirstPartyId {
+    const id = key.slice(0, key.indexOf(':'));
+    if (!isFirstPartyId(id)) throw new Error(`module host: "${key}" does not start with a first-party module id`);
+    return id;
+}
+
+function warnOnce(key: string, message: string) {
+    if (warned.has(key)) return;
+    warned.add(key);
+    logger.warn(`module host: ${message}`);
+}
+
+/** The component behind a key when its module is loaded: as provided, its lazy chunk, or (outside its zone) its area first. */
+function componentOf<P extends object>(kind: ComponentKind, key: string, id: FirstPartyId): ComponentType<P> {
+    const cacheKey = `${kind}\0${key}`;
+    const hit = resolved.get(cacheKey);
+    if (hit) return hit as ComponentType<P>;
+    const fromEntry = (entry: unknown): Promise<{ default: ComponentType<P> }> => (isLazyEntry(entry)
+        ? loadChunk(id, entry.load as () => Promise<{ default: ComponentType<P> }>)
+        : Promise.resolve({ default: entry as ComponentType<P> }));
+    const found = findEntry(kind, key, id);
+    let component: ComponentType<P>;
+    if (found.found && !isLazyEntry(found.entry)) component = found.entry as ComponentType<P>;
+    else if (found.found) component = lazy(() => fromEntry(found.entry));
+    else if (found.pending) {
+        component = lazy(async () => {
+            await loadAreasOf(id);
+            const late = findEntry(kind, key, id);
+            if (!late.found) throw new Error(`module host: no area file of ${id} provides ${key}`);
+            return fromEntry(late.entry);
+        });
+    } else {
+        warnOnce(key, `no area file of ${id} provides ${key}`);
+        component = () => null;
+    }
+    resolved.set(cacheKey, component);
+    return component;
+}
+
+/** What the host renders instead of a key whose module is not loaded. */
+function standIn(kind: ComponentKind, children: ReactNode, state: 'absent' | 'failed'): ReactNode {
+    if (kind === 'wraps') return createElement(Fragment, null, children);
+    if (kind === 'parts') return null;
+    return createElement(state === 'absent' ? ModuleNotInstalled : ModuleUnavailable);
+}
+
+function hosted<P extends object>(kind: ComponentKind, key: string): ComponentType<HostedProps<P>> {
+    const cacheKey = `${kind}\0${key}`;
+    const hit = components.get(cacheKey);
+    if (hit) return hit as ComponentType<HostedProps<P>>;
+    const id = idOfKey(key);
+    function ModuleHosted(props: HostedProps<P>): ReactNode {
+        if (!isBooted()) {
+            // Rendered before the shell booted (a public page): suspend until the states are in.
+            let gate = bootGates.get(cacheKey) as ComponentType<HostedProps<P>> | undefined;
+            if (!gate) {
+                gate = lazy(() => bootModules().then(() => ({ default: ModuleHosted })));
+                bootGates.set(cacheKey, gate);
+            }
+            return createElement(gate, props);
+        }
+        const state = moduleState(id);
+        if (state !== 'loaded') return standIn(kind, props.children, state);
+        return createElement(ModuleBoundary, { moduleId: id, fallback: standIn(kind, props.children, 'failed') },
+            createElement(componentOf<HostedProps<P>>(kind, key, id), props));
+    }
+    ModuleHosted.displayName = `Module(${key})`;
+    components.set(cacheKey, ModuleHosted);
+    return ModuleHosted;
+}
+
+/** A page or panel of a module, by key. */
+export function moduleScreen<K extends keyof ModuleScreens>(key: K): ComponentType<ModuleScreens[K]> {
+    return hosted<ModuleScreens[K]>('screens', key);
+}
+
+/** A part of a core screen that a module provides, by key. */
+export function modulePart<K extends keyof ModuleParts>(key: K): ComponentType<ModuleParts[K]> {
+    return hosted<ModuleParts[K]>('parts', key);
+}
+
+/** A provider a module puts around core children, by key. */
+export function moduleWrap<K extends keyof ModuleWraps>(key: K): ComponentType<ModuleWraps[K] & { children?: ReactNode }> {
+    return hosted<ModuleWraps[K]>('wraps', key);
+}
+
+/**
+ * A value a module provides (a function, a hook, a constant), or `absent`. Read at render or
+ * call time, never at module scope. The first answer after boot is kept for the page, so a hook
+ * read through here is the same hook on every render.
+ */
+export function moduleValue<K extends keyof ModuleValues>(key: K, absent: ModuleValues[K]): ModuleValues[K] {
+    if (values.has(key)) return values.get(key) as ModuleValues[K];
+    if (!assertBooted(`moduleValue('${String(key)}')`)) return absent;
+    const id = idOfKey(key);
+    let value: ModuleValues[K] = absent;
+    if (moduleState(id) === 'loaded') {
+        const found = findEntry('values', key, id);
+        if (found.found) value = found.entry as ModuleValues[K];
+        else warnOnce(key, `${key} was read before the area file that provides it loaded (asked outside its zone?); the fallback stays for this page`);
+    }
+    values.set(key, value);
+    return value;
+}
+
+/** A value of a module, loaded when a callback needs it; null when the module is not loaded. */
+export async function moduleImport<K extends keyof ModuleValues>(key: K): Promise<ModuleValues[K] | null> {
+    await bootModules();
+    const id = idOfKey(key);
+    if (moduleState(id) !== 'loaded') return null;
+    let found = findEntry('values', key, id);
+    if (!found.found) {
+        await loadAreasOf(id);
+        found = findEntry('values', key, id);
+    }
+    return found.found ? (found.entry as ModuleValues[K]) : null;
+}
+
+/** The rows loaded modules add to a core list; read when the list is built, never at module scope. */
+export function moduleList<L extends keyof ModuleLists>(list: L): ReadonlyArray<ModuleLists[L]> {
+    return listRows(list) as ModuleLists[L][];
+}
+
+/**
+ * The rows of a shell list without the rows of absent modules (owners/<host>.ts says whose a
+ * row is). Applied before any gate or lock logic, so an absent module shows no locked row. The
+ * identity when every module is there.
+ */
+export function visibleByOwner<R>(host: OwnerHost, rows: readonly R[], keyOf: (row: R) => string): R[] {
+    return rows.filter((row) => {
+        const owner = ownerOfRow(host, keyOf(row));
+        return !owner || moduleAvailable(owner);
+    });
+}
