diff --git a/agent-hub/src/moduleHost/ModuleBoundary.tsx b/agent-hub/src/moduleHost/ModuleBoundary.tsx
new file mode 100644
index 00000000..c568a384
--- /dev/null
+++ b/agent-hub/src/moduleHost/ModuleBoundary.tsx
@@ -0,0 +1,35 @@
+import { Component, type ErrorInfo, type ReactNode } from 'react';
+import { logger } from '../utils/logger';
+
+interface ModuleBoundaryProps {
+    moduleId: string;
+    /** What the host shows instead: ModuleUnavailable for a screen, nothing for a part, the children for a wrap. */
+    fallback: ReactNode;
+    children?: ReactNode;
+}
+
+interface ModuleBoundaryState {
+    failed: boolean;
+}
+
+/**
+ * Around everything a first-party module renders inside the core: a chunk that will not load
+ * (loadModuleChunk already marked the module failed) or a module component that throws ends
+ * here, and the host keeps rendering. Suspense is not caught: a lazy key suspends to the host's
+ * own boundary, exactly as the core's lazy import did before.
+ */
+export default class ModuleBoundary extends Component<ModuleBoundaryProps, ModuleBoundaryState> {
+    state: ModuleBoundaryState = { failed: false };
+
+    static getDerivedStateFromError(): ModuleBoundaryState {
+        return { failed: true };
+    }
+
+    componentDidCatch(error: Error, info: ErrorInfo) {
+        logger.warn(`module ${this.props.moduleId}: a part of it failed to render; the host goes on without it`, error, info.componentStack);
+    }
+
+    render() {
+        return this.state.failed ? this.props.fallback : this.props.children;
+    }
+}
diff --git a/agent-hub/src/moduleHost/ModuleNotInstalled.tsx b/agent-hub/src/moduleHost/ModuleNotInstalled.tsx
