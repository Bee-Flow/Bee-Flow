index 00000000..9e6d8f62
--- /dev/null
+++ b/agent-hub/vite/beeflowModules.test.ts
@@ -0,0 +1,122 @@
+// @vitest-environment node
+/**
+ * The build plugin of the module host (vite/beeflowModules.mjs), on made-up checkouts: the area
+ * list over every root, the hidden modules left out of it, and real `vite build`s that succeed
+ * without a hidden module's files and fail, naming the file, the module and the importer, when
+ * a static import, an `import()` or an `import.meta.glob` reaches one.
+ */
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { build } from 'vite';
+import { afterAll, describe, expect, it } from 'vitest';
+import { beeflowModules, listAreas, ownerResolver, parseHide, renderFirstParty, webRoots } from './beeflowModules.mjs';
+
+const dirs: string[] = [];
+afterAll(() => { for (const d of dirs) fs.rmSync(d, { recursive: true, force: true }); });
+
+/** A checkout: agent-hub/ and modules/<id>/frontend/ with the given files (repo-relative). */
+function checkout(files: Record<string, string>): string {
+    const repo = fs.mkdtempSync(path.join(os.tmpdir(), 'beeflow-modules-'));
+    dirs.push(repo);
+    for (const [rel, text] of Object.entries(files)) {
+        fs.mkdirSync(path.dirname(path.join(repo, rel)), { recursive: true });
+        fs.writeFileSync(path.join(repo, rel), text);
+    }
+    return repo;
+}
+
+const AREA = "export default { id: 'learning', zone: 'boot' };\n";
+const BASE = {
+    'agent-hub/src/firstParty/cowork.hub.tsx': "export default { id: 'cowork', zone: 'hub' };\n",
+    'agent-hub/src/firstParty/cowork.public.tsx': "export default { id: 'cowork', zone: 'public' };\n",
+    'agent-hub/src/firstParty/cowork.hub.test.tsx': '',
+    'agent-hub/src/firstParty/cowork.i18n.generated.ts': '',
+    'modules/learning/frontend/src/firstParty/learning.boot.tsx': AREA,
+    'modules/learning/frontend/src/components/Lesson.ts': "export const LESSON = 'lesson-code';\n",
+    'modules/learning/frontend/src/components/Other.ts': "export const OTHER = 'other-code';\n",
+};
+
+describe('the area list', () => {
+    it('lists the area files of every root, sorted, tests and generated files left out', () => {
+        const repo = checkout(BASE);
+        const roots = webRoots({ hubDir: path.join(repo, 'agent-hub'), modulesDir: path.join(repo, 'modules') });
+        expect(roots.map((r) => r.id)).toEqual([null, 'learning']);
+        const areas = listAreas(roots, []);
+        expect(areas.map((a) => `${a.id}.${a.zone}`)).toEqual(['cowork.hub', 'cowork.public', 'learning.boot']);
+        expect(listAreas(roots, ['learning']).map((a) => a.id)).toEqual(['cowork', 'cowork']);
+        expect(listAreas(roots, ['all'])).toEqual([]);
+    });
+
+    it('the virtual module: public areas imported statically, every other zone its own chunk', () => {
+        const code = renderFirstParty([
+            { id: 'cowork', zone: 'hub', file: '/r/agent-hub/src/firstParty/cowork.hub.tsx' },
+            { id: 'cowork', zone: 'public', file: '/r/agent-hub/src/firstParty/cowork.public.tsx' },
+        ], ['learning']);
+        expect(code).toContain('import * as area1 from "/r/agent-hub/src/firstParty/cowork.public.tsx";');
+        expect(code).toContain('{ id: "cowork", zone: "hub", load: () => import("/r/agent-hub/src/firstParty/cowork.hub.tsx") },');
+        expect(code).toContain('export const HIDE = ["learning"];');
+    });
+
+    it('refuses an unknown zone and an area in another module\'s root', () => {
+        const bad = checkout({ 'agent-hub/src/firstParty/cowork.sidebar.tsx': '' });
+        expect(() => listAreas(webRoots({ hubDir: path.join(bad, 'agent-hub'), modulesDir: path.join(bad, 'modules') }), []))
+            .toThrow(/"sidebar" is no zone/);
+        const wrongRoot = checkout({ 'modules/learning/frontend/src/firstParty/cowork.hub.tsx': '' });
+        expect(() => listAreas(webRoots({ hubDir: path.join(wrongRoot, 'agent-hub'), modulesDir: path.join(wrongRoot, 'modules') }), []))
+            .toThrow(/area of "cowork" in the root of "learning"/);
+    });
+
+    it('owners: the module root, else the map for a core-root file under src/, else nobody', () => {
+        const roots = [{ id: null, dir: '/r/agent-hub' }, { id: 'learning', dir: '/r/modules/learning/frontend' }];
+        const ownerOf = ownerResolver(roots, (_pkg: string, p: string) => (p.startsWith('src/support/') ? 'support' : null));
+        expect(ownerOf('/r/modules/learning/frontend/src/x.ts')).toBe('learning');
+        expect(ownerOf('/r/agent-hub/src/support/Desk.tsx?v=1')).toBe('support');
+        expect(ownerOf('/r/agent-hub/src/App.tsx')).toBeNull();
+        expect(ownerOf('/r/agent-hub/node_modules/react/index.js')).toBeNull();
+        expect(ownerOf('/r/agent-hub/vite.config.js')).toBeNull();
+        expect(parseHide(' learning, cowork ,')).toEqual(['learning', 'cowork']);
+    });
+});
+
+/** Build a checkout's agent-hub/src/main.ts in memory with the plugin; the bundled module ids. */
+async function buildIt(repo: string, hide: string): Promise<string[]> {
+    const hubDir = path.join(repo, 'agent-hub');
+    const result = await build({
+        root: hubDir, configFile: false, logLevel: 'silent',
+        plugins: [beeflowModules({ hubDir, repoDir: repo, env: { BEEFLOW_HIDE_MODULES: hide } })],
+        build: { write: false, rolldownOptions: { input: path.join(hubDir, 'src', 'main.ts') } },
+    });
+    const outputs = (Array.isArray(result) ? result : [result]) as { output: { type: string; modules?: Record<string, unknown> }[] }[];
+    return outputs.flatMap((r) => r.output).flatMap((o) => (o.type === 'chunk' ? Object.keys(o.modules ?? {}) : []));
+}
+
+// An app build drops what the entry only exports: every main here does something at load.
+const MAIN = "import { AREAS, HIDE } from 'virtual:beeflow/first-party';\nPromise.all(AREAS.map((a) => a.load())).then((m) => console.log(HIDE, m));\n";
+const learningFiles = (ids: string[]) => ids.filter((id) => id.includes('/modules/learning/'));
+
+describe('hide mode in a real build', () => {
+    it('without BEEFLOW_HIDE_MODULES the learning area is built', async () => {
+        const repo = checkout({ ...BASE, 'agent-hub/src/main.ts': MAIN });
+        expect(learningFiles(await buildIt(repo, ''))).toEqual([expect.stringMatching(/learning\.boot\.tsx$/)]);
+    });
+
+    it('with learning hidden the build succeeds and holds no learning file', async () => {
+        const repo = checkout({ ...BASE, 'agent-hub/src/main.ts': MAIN });
+        const ids = await buildIt(repo, 'learning');
+        expect(ids.some((id) => id.endsWith('cowork.hub.tsx'))).toBe(true);
+        expect(learningFiles(ids)).toEqual([]);
+    });
+
+    it.each([
+        ['a static import', "import { LESSON } from '../../modules/learning/frontend/src/components/Lesson';\nconsole.log(LESSON);\n"],
+        ['an import()', "import('../../modules/learning/frontend/src/components/Lesson').then(console.log);\n"],
+        ['an import.meta.glob', "console.log(Object.values(import.meta.glob('../../modules/learning/frontend/src/components/*.ts')).map((f) => f()));\n"],
+    ])('%s of a hidden module\'s file fails the build, naming file, module and importer', async (_kind, main) => {
+        const repo = checkout({ ...BASE, 'agent-hub/src/main.ts': main });
+        await expect(buildIt(repo, 'learning')).rejects.toThrow(
