+/**
+ * The reload guard of lazyWithReload: a chunk that is gone for good reloads the tab at most
+ * once, however often it is asked for afterwards, and another chunk loading in between does
+ * not re-arm it. Only the same import loading clears its record.
+ */
+import { afterEach, beforeEach, describe, expect, it, vi } from 'vitest';
+import { importWithReload } from './lazyWithReload';
+
+const chunkError = () => new TypeError('Failed to fetch dynamically imported module: /assets/Gone-abc123.js');
+
+describe('importWithReload', () => {
+    let reload: ReturnType<typeof vi.fn>;
+
+    beforeEach(() => {
+        vi.useFakeTimers();
+        sessionStorage.clear();
+        reload = vi.fn();
+        vi.spyOn(window, 'location', 'get').mockReturnValue({ ...window.location, reload } as Location);
+    });
+    afterEach(() => {
+        vi.useRealTimers();
+        vi.restoreAllMocks();
+    });
+
+    /** Ask for an import once: 'reloaded' when it hangs for a reload, else the rejection or the module. */
+    async function attempt<M>(importer: () => Promise<M>): Promise<'reloaded' | Error | M> {
+        let settled: 'reloaded' | Error | M = 'reloaded';
+        const p = importWithReload(importer).then((m) => { settled = m; }, (e: Error) => { settled = e; });
+        await vi.advanceTimersByTimeAsync(300);
+        await Promise.race([p, Promise.resolve()]);
+        return settled;
+    }
+
+    it('a chunk that always fails reloads at most once, over any number of attempts', async () => {
+        const gone = () => Promise.reject(chunkError());
+        expect(await attempt(gone)).toBe('reloaded');
+        // After the reload (sessionStorage survives it) the same chunk still fails: give up, every time.
+        for (let i = 0; i < 4; i++) expect(await attempt(gone)).toBeInstanceOf(TypeError);
+        expect(reload).toHaveBeenCalledTimes(1);
+    });
+
+    it('another chunk loading does not re-arm the reload of a failing one', async () => {
+        const gone = () => Promise.reject(chunkError());
+        const fine = () => Promise.resolve({ default: 'ok' });
+        expect(await attempt(gone)).toBe('reloaded');
+        expect(await attempt(fine)).toEqual({ default: 'ok' });
+        expect(await attempt(gone)).toBeInstanceOf(TypeError);
+        expect(reload).toHaveBeenCalledTimes(1);
+    });
+
+    it('the same import loading clears its record, so a later failure may reload again', async () => {
+        let ok = false;
+        const flaky = () => (ok ? Promise.resolve({ default: 'ok' }) : Promise.reject(chunkError()));
+        expect(await attempt(flaky)).toBe('reloaded');
+        ok = true;
+        expect(await attempt(flaky)).toEqual({ default: 'ok' });
+        ok = false;
+        expect(await attempt(flaky)).toBe('reloaded');
+        expect(reload).toHaveBeenCalledTimes(2);
+    });
+
+    it('a transient failure is retried once without a reload; other errors are rethrown as they are', async () => {
+        let calls = 0;
+        const blip = () => (++calls === 1 ? Promise.reject(chunkError()) : Promise.resolve({ default: 'ok' }));
+        expect(await attempt(blip)).toEqual({ default: 'ok' });
+        const broken = () => Promise.reject(new Error('module threw at load'));
+        expect(await attempt(broken)).toBeInstanceOf(Error);
+        expect(reload).not.toHaveBeenCalled();
+    });
+
+    it('an old tab\'s timestamp record counts as none', async () => {
+        sessionStorage.setItem('beeflow-chunk-reload', String(Date.now()));
+        expect(await attempt(() => Promise.reject(chunkError()))).toBe('reloaded');
+    });
+});
