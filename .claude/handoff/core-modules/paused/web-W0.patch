+// @vitest-environment node
+/**
+ * The golden normaliser: a module-host lookup (`modulePart('learning:LessonPlayerHost')`,
+ * src/moduleHost) is read as the lazy import it replaced, through the area file that provides
+ * the key, so converting an import leaves every inventory golden byte-identical, and a key
+ * provided from another file changes the recorded entry.
+ */
+import fs from 'node:fs';
+import { describe, expect, it } from 'vitest';
+import { areaKeyFiles, moduleKeyFiles } from './areaKeys';
+import { webFile } from './ownership';
+import { jsxTree, loadSource, parseSource } from './sourceAst';
+
+const read = (treePath: string) => fs.readFileSync(webFile(treePath) as string, 'utf8');
+
+/** A made-up area file of a module, providing keys from files (`lazyEntry(() => import(…))`). */
+function area(id: string, zone: string, kind: string, keys: Record<string, string>) {
+    const rows = Object.entries(keys).map(([key, spec]) => `        '${key}': lazyEntry(() => import('${spec}')),`).join('\n');
+    return {
+        treePath: `src/firstParty/${id}.${zone}.tsx`,
+        text: `import { defineModuleArea, lazyEntry } from '../moduleHost/contract';\nexport default defineModuleArea({\n    id: '${id}',\n    zone: '${zone}',\n    ${kind}: {\n${rows}\n    },\n});\n`,
+    };
+}
+
+const LESSON_LAZY = "lazy(() => import('./components/onboarding/LessonPlayerHost'))";
+const LESSON_LOOKUP = "modulePart('learning:LessonPlayerHost')";
+
+describe('module-host lookups in the GUI inventory', () => {
+    it('the repository area file provides learning:LessonPlayerHost from the file AuthedApp used to import', () => {
+        expect(moduleKeyFiles().get('learning:LessonPlayerHost')).toBe('src/components/onboarding/LessonPlayerHost.tsx');
+    });
+
+    it('AuthedApp.tsx reads the same with the lookup as with the lazy import it replaced', () => {
+        const text = read('src/AuthedApp.tsx');
+        expect(text).toContain(LESSON_LOOKUP);
+        const before = parseSource('src/AuthedApp.tsx', text.replace(LESSON_LOOKUP, LESSON_LAZY));
+        const after = loadSource('src/AuthedApp.tsx');
+        expect([...after.lazies]).toEqual([...before.lazies]);
+        for (const fn of ['AuthedApp', 'App', 'AppRecorderProvider']) expect(jsxTree(after, fn)).toEqual(jsxTree(before, fn));
+    });
+
+    it('studioRegistry.tsx:29 as a screen lookup reads the same (prototype on a made-up automation area)', () => {
+        const original = read('src/components/admin/Studio/studioRegistry.tsx');
+        const lazyLine = "aiTasks: lazy(() => import('../../automation/index')),";
+        expect(original).toContain(lazyLine);
+        const converted = original.replace(lazyLine, "aiTasks: moduleScreen('automation:AutomationStudio'),");
+        const keys = areaKeyFiles([area('automation', 'studio', 'screens', { 'automation:AutomationStudio': '../components/automation/index' })]);
+        const after = parseSource('src/components/admin/Studio/studioRegistry.tsx', converted, keys);
+        expect([...after.lazies]).toEqual([...loadSource('src/components/admin/Studio/studioRegistry.tsx').lazies]);
+    });
+
+    it('a key provided from another file changes the recorded entry, and an unknown key drops it', () => {
+        const text = read('src/AuthedApp.tsx');
+        const elsewhere = areaKeyFiles([area('learning', 'boot', 'parts', { 'learning:LessonPlayerHost': '../components/onboarding/OnboardingTour' })]);
+        expect(parseSource('src/AuthedApp.tsx', text, elsewhere).lazies.get('LessonPlayerHost')).toBe('src/components/onboarding/OnboardingTour.tsx');
+        expect(parseSource('src/AuthedApp.tsx', text, new Map()).lazies.has('LessonPlayerHost')).toBe(false);
+    });
+
+    it('an area that provides a key as a static import binding resolves to that file', () => {
+        const keys = areaKeyFiles([{
+            treePath: 'src/firstParty/learning.boot.tsx',
+            text: "import LessonPlayerHost from '../components/onboarding/LessonPlayerHost';\nimport { defineModuleArea } from '../moduleHost/contract';\n"
+                + "export default defineModuleArea({ id: 'learning', zone: 'boot', parts: { 'learning:LessonPlayerHost': LessonPlayerHost } });\n",
+        }]);
+        expect(keys.get('learning:LessonPlayerHost')).toBe('src/components/onboarding/LessonPlayerHost.tsx');
+    });
+});
