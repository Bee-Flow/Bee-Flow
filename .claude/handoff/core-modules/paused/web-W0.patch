@@ -0,0 +1,23 @@
+import { useTranslation } from '../hooks/useTranslation';
+
+/**
+ * What a screen of a first-party module shows when the module is there but failed: the server
+ * reports it failed, or its code would not load on this page. The page is not reloaded for the
+ * person (a module chunk never reloads, loadModuleChunk.ts); they can, with the button.
+ */
+export default function ModuleUnavailable() {
+    const { t } = useTranslation();
+    return (
+        <div role="alert" className="h-full flex flex-col items-center justify-center px-6 py-12 text-center">
+            <div className="text-lg font-semibold text-[var(--text-primary)] mb-2">{t('module_host.unavailable_title')}</div>
+            <div className="text-sm text-[var(--text-tertiary)] mb-6 max-w-md leading-relaxed">{t('module_host.unavailable_body')}</div>
+            <button
+                type="button"
+                onClick={() => window.location.reload()}
+                className="px-4 py-2 rounded-full text-sm font-medium bg-[var(--accent-primary)] text-[var(--accent-primary-fg)] hover:opacity-90"
+            >
+                {t('module_host.reload')}
+            </button>
+        </div>
+    );
+}
diff --git a/agent-hub/src/moduleHost/contract.ts b/agent-hub/src/moduleHost/contract.ts
new file mode 100644
index 00000000..ef1ce77d
--- /dev/null
+++ b/agent-hub/src/moduleHost/contract.ts
@@ -0,0 +1,96 @@
+/**
+ * The contract between the core of the web client and its first-party modules.
+ *
+ * The core never imports a module's file. Where it shows something a module provides, it asks
+ * for it by KEY, `<moduleId>:<Export>` (the prefix is the owner), through the accessors of
+ * src/moduleHost (moduleScreen, modulePart, moduleWrap, moduleValue, moduleImport,
+ * moduleList). The core owns the type of every key: the props of a screen, part or wrap, the
+ * type of a value, the row type of a list, written per zone in exports/<zone>.ts. A module
+ * provides its keys in its AREA files, `src/firstParty/<id>.<zone>.tsx` (later
+ * `modules/<id>/frontend/src/firstParty/...`, the same tree path), with defineModuleArea.
+ *
+ * A ZONE is the core lazy boundary that hosts a key: its area files load together with that
+ * boundary (lazyZone), so a part an area provides statically renders on the boundary's first
+ * commit, as it did when the core imported it. A part that was lazy stays lazy: lazyEntry.
+ */
+
+import type { ComponentType, ReactNode } from 'react';
+import type { AdminZone } from './exports/admin';
+import type { BootZone } from './exports/boot';
+import type { DemoZone } from './exports/demo';
+import type { DocsZone } from './exports/docs';
+import type { HubZone } from './exports/hub';
+import type { PublicZone } from './exports/public';
+import type { SettingsZone } from './exports/settings';
+import type { StudioZone } from './exports/studio';
+import type { FIRST_PARTY_IDS } from './ids.generated';
+
+export type FirstPartyId = (typeof FIRST_PARTY_IDS)[number];
+
+/**
+ * loaded: built into this web client and loaded by the server. absent: not built, or the server
+ * did not load it. failed: the server reports it failed, or one of its chunks failed to load on
+ * this page.
+ */
+export type ModuleState = 'loaded' | 'absent' | 'failed';
+
+const ZONES = ['boot', 'public', 'hub', 'studio', 'admin', 'settings', 'docs', 'demo'] as const;
+export type ZoneKey = (typeof ZONES)[number];
+
+type Kind = 'screens' | 'parts' | 'wraps' | 'values' | 'lists';
+type AllZones<K extends Kind> = BootZone[K] & PublicZone[K] & HubZone[K] & StudioZone[K]
+    & AdminZone[K] & SettingsZone[K] & DocsZone[K] & DemoZone[K];
+
+/** Key -> props of a screen: a page or panel; absent -> "not installed" inside the shell. */
+export type ModuleScreens = AllZones<'screens'>;
+/** Key -> props of a part embedded in a core screen; absent -> nothing. */
+export type ModuleParts = AllZones<'parts'>;
+/** Key -> props of a provider around core children; absent -> the children alone. */
+export type ModuleWraps = AllZones<'wraps'>;
+/** Key -> a value (a function, a hook, a constant); absent -> the fallback the caller passes. */
+export type ModuleValues = AllZones<'values'>;
+/** List name -> row type of a list modules contribute rows to; absent -> no rows. */
+export type ModuleLists = AllZones<'lists'>;
+
+const LAZY = Symbol.for('beeflow.moduleHost.lazyEntry');
+
+/** A component an area provides as its own chunk, loaded the first time it renders. */
+export interface LazyEntry<P> {
+    readonly [LAZY]: true;
+    readonly load: () => Promise<{ default: ComponentType<P> }>;
+}
+
+/** A component of an area file: provided as it is (part of the area chunk), or as a chunk of its own. */
+type Entry<P> = ComponentType<P> | LazyEntry<P>;
+
+/**
+ * Provide a component as a chunk of its own: `lazyEntry(() => import('../components/x/X'))`.
+ * The import stays a string literal, so the GUI inventory (test/guiInventory/sourceAst.ts)
+ * resolves the key to the same file the core used to import.
+ */
+export function lazyEntry<P>(load: () => Promise<{ default: ComponentType<P> }>): LazyEntry<P> {
+    return { [LAZY]: true, load };
+}
+
+export function isLazyEntry(entry: unknown): entry is LazyEntry<unknown> {
+    return typeof entry === 'object' && entry !== null && LAZY in entry;
+}
+
+/** The keys of a contract map that a module owns (their prefix is its id). */
+type OwnKeys<I extends string, M> = Extract<keyof M, `${I}:${string}`>;
+
+/** What one area file of module I provides, for one zone. */
+export interface ModuleArea<I extends FirstPartyId = FirstPartyId> {
+    id: I;
+    zone: ZoneKey;
+    screens?: { [K in OwnKeys<I, ModuleScreens>]?: Entry<ModuleScreens[K]> };
+    parts?: { [K in OwnKeys<I, ModuleParts>]?: Entry<ModuleParts[K]> };
+    wraps?: { [K in OwnKeys<I, ModuleWraps>]?: Entry<ModuleWraps[K] & { children?: ReactNode }> };
+    values?: { [K in OwnKeys<I, ModuleValues>]?: ModuleValues[K] };
+    lists?: { [L in keyof ModuleLists]?: ReadonlyArray<ModuleLists[L]> };
+}
+
+/** The default export of an area file: `export default defineModuleArea({ id: 'learning', zone: 'boot', parts: { … } })`. */
+export function defineModuleArea<I extends FirstPartyId>(area: ModuleArea<I>): ModuleArea<I> {
+    return area;
+}
