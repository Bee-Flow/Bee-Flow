diff --git a/scripts/gen-module-host-ids.mjs b/scripts/gen-module-host-ids.mjs
new file mode 100644
index 00000000..377d69b1
--- /dev/null
+++ b/scripts/gen-module-host-ids.mjs
@@ -0,0 +1,78 @@
+#!/usr/bin/env node
+/**
+ * Write agent-hub/src/moduleHost/ids.generated.ts (the first-party module ids the web client's
+ * module host knows) from scripts/module-map.json, or check that it is current.
+ *
+ * The web client asks a first-party module for its parts by key (`<id>:<Export>`,
+ * src/moduleHost/contract.ts); the type of `<id>` is this list, in the order of the map. The
+ * agent-hub image cannot read scripts/, so the list is a generated file in src, and
+ * `npm run lint:module-host-ids` (picked up by check:fast) fails when a module is added to or
+ * removed from the map without regenerating it.
+ *
+ *   node scripts/gen-module-host-ids.mjs            write the file when it differs
+ *   node scripts/gen-module-host-ids.mjs --check    exit 1 when it is stale; writes nothing
+ */
+
+import fs from 'node:fs';
+import path from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { isEntryPoint } from './entry-point.mjs';
+
+const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
+export const IDS_OUT = 'agent-hub/src/moduleHost/ids.generated.ts';
+const MAP = 'scripts/module-map.json';
+
+/**
+ * The text of the generated file.
+ * @param {string[]} ids the module ids, in the order of the map
+ */
+export function renderIds(ids) {
+    return [
+        `// GENERATED from ${MAP} by scripts/gen-module-host-ids.mjs: do not edit.`,
+        '// The first-party module ids the module host knows (src/moduleHost/contract.ts), in the order of the map.',
+        'export const FIRST_PARTY_IDS = [',
+        ...ids.map((id) => `    '${id}',`),
+        '] as const;',
+        '',
+    ].join('\n');
+}
+
+/**
+ * @param {string} root
+ * @returns {string[]}
+ */
+function mapIds(root) {
+    const raw = JSON.parse(fs.readFileSync(path.join(root, MAP), 'utf8'));
+    return Object.keys(raw.modules || {});
+}
+
+/**
+ * @param {{ check?: boolean, root?: string, ids?: string[], log?: (line: string) => void, error?: (line: string) => void }} [opts]
+ * @returns {number} the exit code
+ */
+export function run({ check = false, root = ROOT, ids, log = console.log, error = console.error } = {}) {
+    const wanted = renderIds(ids || mapIds(root));
+    const file = path.join(root, IDS_OUT);
+    const current = fs.existsSync(file) ? fs.readFileSync(file, 'utf8') : null;
+    if (current === wanted) {
+        log('gen-module-host-ids: 1 file up to date.');
+        return 0;
+    }
+    if (check) {
+        error(`gen-module-host-ids: ${IDS_OUT} is out of date with ${MAP}. Run \`npm run gen:module-host-ids\` and commit the result.`);
+        return 1;
+    }
+    fs.mkdirSync(path.dirname(file), { recursive: true });
+    fs.writeFileSync(file, wanted);
+    log(`gen-module-host-ids: wrote ${IDS_OUT}`);
+    return 0;
+}
+
+if (isEntryPoint(import.meta.url)) {
+    try {
+        process.exit(run({ check: process.argv.includes('--check') }));
+    } catch (e) {
+        console.error(`gen-module-host-ids: ${e.message}`);
+        process.exit(1);
+    }
+}
diff --git a/scripts/gen-module-host-ids.test.mjs b/scripts/gen-module-host-ids.test.mjs
new file mode 100644
index 00000000..b24ada53
--- /dev/null
+++ b/scripts/gen-module-host-ids.test.mjs
@@ -0,0 +1,50 @@
+/**
+ * gen-module-host-ids: run() is a gate. --check names a stale or missing file and writes
+ * nothing, write mode makes --check clean again, and the file in the repository lists the ids
+ * of scripts/module-map.json today.
+ *
+ * Sandbox style: a throwaway tree under os.tmpdir() with a map of its own.
+ */
+
+import test from 'node:test';
+import assert from 'node:assert';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { IDS_OUT, renderIds, run } from './gen-module-host-ids.mjs';
+
+function sandbox(modules) {
+    const root = fs.mkdtempSync(path.join(os.tmpdir(), 'gen-module-host-ids-'));
+    fs.mkdirSync(path.join(root, 'scripts'));
+    fs.writeFileSync(path.join(root, 'scripts', 'module-map.json'), JSON.stringify({ modules }));
+    const lines = [];
+    return { root, lines, io: { root, log: (l) => lines.push(l), error: (l) => lines.push(l) }, file: path.join(root, IDS_OUT) };
+}
+
+test('the ids are written in the order of the map, as a const tuple', () => {
+    const text = renderIds(['b', 'a']);
+    assert.match(text, /^\/\/ GENERATED from scripts\/module-map\.json/);
+    assert.match(text, /export const FIRST_PARTY_IDS = \[\n {4}'b',\n {4}'a',\n\] as const;\n$/);
+});
+
+test('--check fails on a missing or stale file and writes nothing', (t) => {
+    const s = sandbox({ learning: {}, support: {} });
+    t.after(() => fs.rmSync(s.root, { recursive: true, force: true }));
+    assert.equal(run({ ...s.io, check: true }), 1);
+    assert.equal(fs.existsSync(s.file), false);
+    assert.match(s.lines.join('\n'), /out of date with scripts\/module-map\.json.*gen:module-host-ids/);
+
+    assert.equal(run({ ...s.io }), 0);
+    assert.equal(fs.readFileSync(s.file, 'utf8'), renderIds(['learning', 'support']));
+    assert.equal(run({ ...s.io, check: true }), 0);
+
+    // A module joined the map: the check names the file and leaves it alone.
+    fs.writeFileSync(path.join(s.root, 'scripts', 'module-map.json'), JSON.stringify({ modules: { learning: {}, support: {}, cms: {} } }));
+    assert.equal(run({ ...s.io, check: true }), 1);
+    assert.equal(fs.readFileSync(s.file, 'utf8'), renderIds(['learning', 'support']));
+});
+
+test('the file in the repository lists the ids of the map today', () => {
+    const lines = [];
+    assert.equal(run({ check: true, log: (l) => lines.push(l), error: (l) => lines.push(l) }), 0, lines.join('\n'));
+});
