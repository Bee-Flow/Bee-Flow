diff --git a/server/core/integrations/ncScopeGuard.testkit.js b/server/core/integrations/ncScopeGuard.testkit.js
new file mode 100644
index 00000000..1db41bff
--- /dev/null
+++ b/server/core/integrations/ncScopeGuard.testkit.js
@@ -0,0 +1,64 @@
+// @typecheck strict
+'use strict';
+/**
+ * ncScopeGuard over a fake configStore and userStore injected into require.cache: no
+ * Postgres, no network. Shared by ncScopeGuard.test.js (the core's guard) and its module
+ * half ncScopeGuard.int_nextcloud.test.js (the Nextcloud tool families and their guarded
+ * entries, module int_nextcloud).
+ */
+
+const path = require('path');
+
+const USER = 'u-1';
+const ORG = 'org-1';
+
+/**
+ * @param {string} rel from this kit's folder
+ * @param {Record<string, unknown>} exports
+ */
+function inject(rel, exports) {
+    const resolved = require.resolve(path.join(__dirname, rel));
+    require.cache[resolved] = /** @type {NodeJS.Module} */ (/** @type {unknown} */ ({ id: resolved, filename: resolved, loaded: true, exports }));
+}
+
+/**
+ * Inject the stores, load the guard, and reset everything before each test.
+ * @param {typeof import('node:test')} test
+ */
+function scopeGuardWorld(test) {
+    /** @type {Map<string, unknown>} */
+    const store = new Map();
+    /** a store that throws: `config` for the scope store, `user` for the user row */
+    const fail = { config: false, user: false };
+    inject('../../stores/configStore.js', {
+        getConfig: async (/** @type {string} */ k) => {
+            if (fail.config) throw new Error('db down');
+            return store.get(k) ?? null;
+        },
+        setConfig: async (/** @type {string} */ k, /** @type {unknown} */ v) => { store.set(k, v); },
+        deleteConfig: async (/** @type {string} */ k) => { store.delete(k); },
+    });
+    inject('../../stores/guardrailEventStore.js', { logGuardrailEvent: async () => {} });
+    /** @type {Map<string, { organizationId?: string }>} */
+    const userRows = new Map();
+    inject('../../stores/userStore.js', { getUser: async (/** @type {string} */ id) => { if (fail.user) throw new Error('db down'); return userRows.get(id) || null; } });
+
+    const guard = require('./ncScopeGuard');
+    require('./ncScope');
+
+    /** @param {Record<string, unknown>} integrations */
+    function setUserScope(integrations) {
+        store.set(`user_nc_scope_${USER}`, { v: 1, integrations });
+        guard.invalidateScopeCache();
+    }
+    /** @param {Record<string, unknown>} integrations */
+    function setOrgScope(integrations) {
+        store.set(`org_nc_scope_${ORG}`, { v: 1, integrations });
+        guard.invalidateScopeCache();
+    }
+
+    test.beforeEach(() => { store.clear(); userRows.clear(); fail.config = false; fail.user = false; guard.invalidateScopeCache(); });
+    return { store, userRows, fail, guard, setUserScope, setOrgScope, USER, ORG };
+}
+
+module.exports = { scopeGuardWorld };
