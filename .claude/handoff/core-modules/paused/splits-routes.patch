diff --git a/server/routes/studio/attention.testkit.js b/server/routes/studio/attention.testkit.js
new file mode 100644
index 00000000..8d7a9b4c
--- /dev/null
+++ b/server/routes/studio/attention.testkit.js
@@ -0,0 +1,151 @@
+// @typecheck
+'use strict';
+/**
+ * GET /api/studio/attention (routes/studio/attention.js) over injected stand-ins, served on
+ * real HTTP. Shared by attention.test.js (the core: the route's contract over the sources that
+ * need no module) and its module half attention.projects.test.js (every source answering,
+ * which needs module projects' completeness.js for app validation and the empty-base finding).
+ */
+
+const { createAttentionRouter } = require('./attention');
+const { studioApp, studioServer } = require('./studioServer.testkit');
+const { optionalFeatureModule } = require('../../core/featureModules');
+
+// One app with no screens → the App Studio validator's `screens.missing`.
+const APP_BROKEN = { schemaVersion: 2, meta: { name: 'Order portal' }, screens: [] };
+
+/**
+ * A fully-open, fully-populated fake dependency set: every gate open and every
+ * source holding exactly ONE problem, so a body has six rows — three errors
+ * (app, automation, Solution) and three warnings (agent, empty base, stale base).
+ * @param {Record<string, unknown>} [overrides]
+ * @returns {Record<string, any>} the deps; any: each test reads its own stand-in back
+ */
+function makeDeps(overrides = {}) {
+    /** @type {Record<string, any>} */
+    const calls = { sql: [] };
+    const bump = (/** @type {string} */ name) => { calls[name] = (calls[name] || 0) + 1; };
+    let clock = 1_000_000;
+    const deps = {
+        now: () => clock,
+        _tick: (/** @type {number} */ ms) => { clock += ms; },
+        _calls: calls,
+        modules: { isModuleActive: async () => true },
+        license: { featureAllowedForRequest: async () => ({ allowed: true, resolution: {} }) },
+        entitlements: { hasCapability: async () => true },
+        permissions: { hasPermission: async () => true, resolvePermissionsByOrg: async () => ({ holds: () => true }) },
+        auth: {
+            resolveUserOrgIds: async () => new Set(['orgA']),
+            resolveUserGroups: async () => ['g1'],
+        },
+        audience: { resolveAudienceContext: async () => ({ userId: 'u1', orgIds: new Set(['orgA']), userGroups: ['g1'] }) },
+        studioAppStore: {
+            getAccessibleStudioApps: async () => { bump('apps'); return [
+                { id: 'app1', name: 'Order portal', userId: 'u1' },
+                // Published into the org by somebody else: visible, NOT editable.
+                { id: 'app2', name: 'Colleague portal', userId: 'u2' },
+            ]; },
+            canWriteStudioApp: (/** @type {{ userId: string }} */ app, /** @type {string} */ userId) => app.userId === userId,
+            getStudioApp: async (/** @type {string} */ id) => { bump('appDefinition'); calls.appIds = [...(calls.appIds || []), id];
+                return { id, name: 'Order portal', definition: APP_BROKEN }; },
+        },
+        automationStore: {
+            getRecentRunStatusesForUser: async (/** @type {string} */ userId, /** @type {Record<string, unknown>} */ opts) => {
+                bump('runs'); calls.runArgs = { userId, ...opts };
+                return [
+                    { automationId: 'a1', title: 'Invoice reminder', status: 'error' },
+                    { automationId: 'a1', title: 'Invoice reminder', status: 'error' },
+                    { automationId: 'a1', title: 'Invoice reminder', status: 'error' },
+                    { automationId: 'a2', title: 'Weekly digest', status: 'success' },
+                ];
+            },
+        },
+        kbStore: {
+            listKBs: async () => { bump('listKBs'); return [
+                { id: 'kb1', name: 'Handbook', document_count: 0 },
+                { id: 'kb2', name: 'Policies', document_count: 5 },
+                { id: 'kbx', name: 'Not yours', document_count: 0 },
+            ]; },
+            // The group filter removes a base whose emptiness would otherwise
+            // be reported — org scoping alone is not the visibility answer.
+            filterByGroupAccess: (/** @type {Array<{ id: string }>} */ kbs) => kbs.filter(kb => kb.id !== 'kbx'),
+            // Reading a base is not being able to fix it: the two knowledge
+            // sources ask this before they hand anyone an instruction.
+            canUserManageKB: () => true,
+        },
+        kbShared: {
+            resolveAdminOrgIds: async () => new Set(),
+            resolveEnabledSystemSlugs: async () => [],
+            listFilterFromQuery: () => ({ sourceKind: 'manual' }),
+            resolveUserGroups: async () => ['g1'],
+        },
+        kbUsage: {
+            usageForKb: async (/** @type {string} */ kbId) => { bump('kbUsage'); calls.usageIds = [...(calls.usageIds || []), kbId];
+                return { rows: [{ kind: 'agent', id: 'ag1', role: 'chat' }], partial: [] }; },
+        },
+        kbSourcesStore: {
+            countErrorSourcesByKb: async (/** @type {string[]} */ ids) => { bump('kbSources'); calls.kbSourceIds = ids;
+                return new Map([['kb2', 1]]); },
+        },
+        projectStore: { listUserProjects: async () => { bump('projects'); return [{ id: 'pr1', name: 'Invoice rollout' }]; } },
+        configStore: { getConfig: async () => null },
+        db: {
+            getAll: async (/** @type {string} */ sql, /** @type {unknown[]} */ params) => {
+                bump('agents'); calls.sql.push({ sql, params });
+                return [
+                    { id: 'ag1', name: 'Helpdesk', config: JSON.stringify({ knowledge_base_ids: [] }) },
+                    { id: 'ag2', name: 'Grounded', config: JSON.stringify({ knowledge_base_ids: ['kb2'] }) },
+                ];
+            },
+        },
+        // Order-preserving, bounded — the real one lives in projects/summary.js.
+        mapLimited: async (/** @type {unknown[]} */ items, /** @type {number} */ _width, /** @type {(item: unknown, i: number) => Promise<unknown>} */ fn) => {
+            const out = [];
+            for (let i = 0; i < items.length; i += 1) out.push(await fn(items[i], i));
+            return out;
+        },
+        // Module projects' own rules (app validation, the empty-base finding), as the route
+        // looks them up: null without that module, and the sources that need them are gated.
+        completeness: optionalFeatureModule('projects/completeness'),
+        solutionCompleteness: async (/** @type {string} */ projectId) => {
+            bump('completeness'); calls.completenessIds = [...(calls.completenessIds || []), projectId];
+            return { blocked: true, complete: true, findings: [{ severity: 'error' }, { severity: 'warning' }], unavailable: [] };
+        },
+    };
+    return Object.assign(deps, overrides);
+}
+
+/** @typedef {ReturnType<typeof createAttentionRouter> & { __clearCacheForTests: () => void }} AttentionRouter */
+
+/**
+ * The server harness: one listening server per test file. `onMount(deps, router)` hands the
+ * test file the deps and router of the app last mounted; `fetch` is the test file's (the
+ * route tree bans a bare fetch outside tests, and this one only ever reaches 127.0.0.1).
+ * @param {typeof import('node:test')} test
+ * @param {{ fetch: typeof globalThis.fetch,
+ *   onMount: (deps: Record<string, any>, router: ReturnType<typeof createAttentionRouter>) => void }} opts
+ */
+function attentionWorld(test, { fetch: get0, onMount }) {
+    /** @type {AttentionRouter | null} */
+    let current = null;
+    const mount = (/** @type {Record<string, any>} */ nextDeps) => {
+        const router = /** @type {AttentionRouter} */ (createAttentionRouter(/** @type {Parameters<typeof createAttentionRouter>[0]} */ (/** @type {unknown} */ (nextDeps))));
+        current = router;
+        onMount(nextDeps, router);
+        return studioApp(router);
+    };
+    const srv = studioServer(test);
+    const listen = srv.listen;
+
+    const get = (user = 'u1') => get0(`${srv.baseUrl}/api/studio/attention`, {
+        headers: user ? { 'x-test-user': user } : {},
+    });
+
+    /** @param {Record<string, unknown>} [o] */
+    const body = async (o = {}) => { await listen(mount(makeDeps(o))); current?.__clearCacheForTests(); return (await get()).json(); };
+    /** @param {{ rows: Array<{ source: string }> }} b @param {string} source */
+    const rowsFrom = (b, source) => b.rows.filter(r => r.source === source);
+    return { srv, mount, listen, get, body, rowsFrom };
+}
+
+module.exports = { APP_BROKEN, makeDeps, attentionWorld };
