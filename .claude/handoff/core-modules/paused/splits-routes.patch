diff --git a/server/integrations/agentSearchTools.testkit.js b/server/integrations/agentSearchTools.testkit.js
new file mode 100644
index 00000000..c3de13ad
--- /dev/null
+++ b/server/integrations/agentSearchTools.testkit.js
@@ -0,0 +1,65 @@
+// @typecheck strict
+'use strict';
+/**
+ * The agent search tool against a configured search URL and a fetch the test chooses.
+ * Shared by agentSearchTools.test.js (the core: the tool and its timeout) and its
+ * automation module half agentSearchTools.automation.test.js (a failed search is a
+ * failed call to the automation runner's tool loop).
+ */
+
+/** @typedef {{ signal?: AbortSignal }} FetchInit */
+
+/**
+ * Point the tool at https://search.example.test, give each test a clean env and fetch log,
+ * and put everything back after the file. Call before requiring agentSearchTools.
+ * @param {typeof import('node:test')} test
+ */
+function agentSearchWorld(test) {
+    // The tool calls configStore through its exports object, so the two lookups
+    // are replaced on the real module for this file and put back afterwards.
+    const configStore = require('../stores/configStore');
+    const realConfig = { getConfig: configStore.getConfig, getSecret: configStore.getSecret };
+    configStore.getConfig = /** @type {typeof configStore.getConfig} */ (async (/** @type {string} */ key) => (key === 'agent_search_url' ? 'https://search.example.test' : null));
+    configStore.getSecret = /** @type {typeof configStore.getSecret} */ (async () => null);
+    test.after(() => { configStore.getConfig = realConfig.getConfig; configStore.getSecret = realConfig.getSecret; });
+
+    const realFetch = globalThis.fetch;
+    const savedEnv = { url: process.env.SEARCH_SERVICE_URL, timeout: process.env.AGENT_SEARCH_TIMEOUT_MS };
+    /** @type {Array<{ url: string, init?: FetchInit }>} */
+    const fetches = [];
+
+    /**
+     * A fetch that never answers on its own: only the request's signal ends it.
+     * The timeout's own timer does not hold the event loop open, so a ref'd one
+     * stands in for the socket a real request would keep open.
+     * @param {unknown} url
+     * @param {FetchInit} [init]
+     */
+    function hangingFetch(url, init) {
+        fetches.push({ url: String(url), init });
+        return new Promise((_resolve, reject) => {
+            const socket = setTimeout(() => reject(new Error('the signal never fired')), 5000);
+            const signal = init && init.signal;
+            if (signal) {
+                signal.addEventListener('abort', () => { clearTimeout(socket); reject(signal.reason); });
+            }
+        });
+    }
+
+    /** @param {string} key @param {string|undefined} v */
+    const setEnv = (key, v) => { if (v === undefined) delete process.env[key]; else process.env[key] = v; };
+
+    test.beforeEach(() => {
+        fetches.length = 0;
+        delete process.env.SEARCH_SERVICE_URL;
+        delete process.env.AGENT_SEARCH_TIMEOUT_MS;
+    });
+    test.afterEach(() => {
+        globalThis.fetch = realFetch;
+        setEnv('SEARCH_SERVICE_URL', savedEnv.url);
+        setEnv('AGENT_SEARCH_TIMEOUT_MS', savedEnv.timeout);
+    });
+    return { fetches, hangingFetch };
+}
+
+module.exports = { agentSearchWorld };
