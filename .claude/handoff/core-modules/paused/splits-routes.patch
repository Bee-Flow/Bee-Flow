diff --git a/server/core/integrations/integrationTools.permittedApps.testkit.js b/server/core/integrations/integrationTools.permittedApps.testkit.js
new file mode 100644
index 00000000..1ef371a7
--- /dev/null
+++ b/server/core/integrations/integrationTools.permittedApps.testkit.js
@@ -0,0 +1,35 @@
+// @typecheck strict
+'use strict';
+/**
+ * The two stores the integration gate reads, stubbed; everything else is real. Shared by
+ * integrationTools.permittedApps.test.js (the core's two helpers) and its module half
+ * integrationTools.permittedApps.apps.test.js (App Studio's browse step).
+ *
+ * `null` from configStore is the "nothing switched off" answer, so the gate falls through
+ * to its org/group layers with an empty org — the shape a consumer account has, and the
+ * widest the gate ever opens. Call before requiring integrationTools.
+ */
+
+/**
+ * @param {string} request resolved from this kit's folder
+ * @param {Record<string, unknown>} exports
+ */
+function stubModule(request, exports) {
+    const p = require.resolve(request);
+    require.cache[p] = /** @type {NodeJS.Module} */ (/** @type {unknown} */ ({ id: p, filename: p, loaded: true, exports }));
+}
+
+function installGateDoubles() {
+    require('../../boot/featureModules'); // core looks feature modules up by name (core/featureModules.js)
+    process.env.NODE_ENV = 'test';
+    stubModule('../../stores/configStore', { getConfig: async () => null, getAllConfig: async () => ({}) });
+    stubModule('../entitlements/entitlements', { resolveEntitlements: async () => ({ degraded: true, effective: { integration: [] } }) });
+
+    // The gate denies when the user lookup fails; there is no DB here, so answer it:
+    // a user without an organisation or groups, the widest shape the gate sees.
+    const userStore = require('../../stores/userStore');
+    userStore.getUser = /** @type {typeof userStore.getUser} */ (/** @type {unknown} */ (async () => ({ id: 'u1', groups: [] })));
+    userStore.getAllGroups = /** @type {typeof userStore.getAllGroups} */ (/** @type {unknown} */ (async () => []));
+}
+
+module.exports = { installGateDoubles };
