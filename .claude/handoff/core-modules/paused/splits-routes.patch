+            if (!nc.connected) throw new Error('Nextcloud not connected.');
+            return {
+                mode: 'basic', baseUrl: 'https://cloud.example', uid: 'tom', authError: 'auth',
+                fetch: async (/** @type {string} */ url, /** @type {FetchOpts} */ opts = {}) => {
