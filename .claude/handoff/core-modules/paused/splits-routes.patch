diff --git a/server/routes/ai/config/userSettings.validation.int_erp_nl.test.js b/server/routes/ai/config/userSettings.validation.int_erp_nl.test.js
new file mode 100644
index 00000000..e9244d67
--- /dev/null
+++ b/server/routes/ai/config/userSettings.validation.int_erp_nl.test.js
@@ -0,0 +1,116 @@
+/**
+ * Module int_erp_nl's half of userSettings.validation.test.js: what POST
+ * /ai/user-settings accepts of the connection settings of AFAS, NMBRS, vPlan,
+ * Firebird and Frappe CRM (usecases/ai/config/erpNlSettingsFields.js), and
+ * that nothing is written when one of them is refused.
+ *
+ * Run: cd server && node --test routes/ai/config/userSettings.validation.int_erp_nl.test.js
+ */
+
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert');
+const { userSettingsWorld } = require('./userSettings.validation.testkit');
+
+const { post, touched, written, clearedNmbrsCache } = userSettingsWorld(test);
+
+test('a refused NMBRS token leaves the API mode as it was — nothing is half-saved', async () => {
+    const res = await post({ nmbrsApiMode: 'rest', nmbrsEnv: 'sandbox', nmbrsToken: 'has spaces in it and more' });
+    assert.strictEqual(res.statusCode, 400);
+    assert.match(res.body.error, /NMBRS token is invalid/);
+    assert.deepStrictEqual(touched, []);
+});
+
+test('a refused AFAS token leaves the member number as it was', async () => {
+    const res = await post({ afasMemberNumber: '12345', afasToken: 'not a token', afasEnvType: 'production' });
+    assert.strictEqual(res.statusCode, 400);
+    assert.match(res.body.error, /AFAS token is not a valid AppConnector token/);
+    assert.deepStrictEqual(touched, []);
+});
+
+test('disconnect still clears with empty strings', async () => {
+    const res = await post({ afasMemberNumber: '', afasToken: '', afasEnvType: '' });
+    assert.strictEqual(res.statusCode, 200);
+    assert.deepStrictEqual(touched.map((t) => [t.key, t.value]), [
+        ['afas_member_number_user_u1', ''],
+        ['afas_token_user_u1', ''],
+        ['afas_env_type_user_u1', ''],
+    ]);
+});
+
+test('the NMBRS form as the settings screen sends it is accepted and stored lowercased', async () => {
+    const res = await post({ nmbrsApiMode: 'SOAP', nmbrsEnv: 'production', nmbrsSubdomain: 'mycompany', nmbrsEmail: 'a@b.nl', nmbrsToken: 'abcdefghijklmnop1234' });
+    assert.strictEqual(res.statusCode, 200);
+    assert.strictEqual(written('nmbrs_api_mode_user_u1').value, 'soap');
+});
+
+test('the NMBRS REST settings (subscription key, client id and secret) are stored; a header-breaking value is refused whole', async () => {
+    const ok = await post({ nmbrsApiMode: 'rest', nmbrsSubscriptionKey: '30d05593229f49c18856be06ebc47b24', nmbrsClientId: '7xr7NV9yqcUz*r2C$ey6', nmbrsClientSecret: 's3cr3t-s3cr3t-s3cr3t' });
+    assert.strictEqual(ok.statusCode, 200);
+    assert.strictEqual(written('nmbrs_subscription_key_user_u1').value, '30d05593229f49c18856be06ebc47b24');
+    assert.strictEqual(written('nmbrs_client_id_user_u1').value, '7xr7NV9yqcUz*r2C$ey6');
+    touched.length = 0;
+    const bad = await post({ nmbrsApiMode: 'rest', nmbrsSubscriptionKey: 'abc\r\nX-Evil: 1 padding padding', nmbrsClientId: 'id' });
+    assert.strictEqual(bad.statusCode, 400);
+    assert.deepStrictEqual(touched, []);
+});
+
+test('changing or removing the NMBRS connection forgets the lists cached under it; other settings do not', async () => {
+    clearedNmbrsCache.length = 0;
+    assert.strictEqual((await post({ nmbrsToken: '' })).statusCode, 200);
+    assert.deepStrictEqual(clearedNmbrsCache, ['u1'], 'removing the token clears the cache of that user');
+    clearedNmbrsCache.length = 0;
+    assert.strictEqual((await post({ afasEnvType: '' })).statusCode, 200);
+    assert.deepStrictEqual(clearedNmbrsCache, []);
+});
+
+// ── Firebird database ──────────────────────────────────────────────────
+test('a Firebird host with a scheme or a path is refused and nothing is saved', async () => {
+    for (const firebirdHost of ['tcp://db.internal', 'db.internal/atrium', 'db internal']) {
+        const res = await post({ firebirdHost });
+        assert.strictEqual(res.statusCode, 400, firebirdHost);
+        assert.match(res.body.error, /Firebird server is invalid/);
+    }
+    assert.deepStrictEqual(touched, []);
+});
+
+test('a Windows database path is accepted and stored as typed', async () => {
+    const res = await post({
+        firebirdHost: 'db.internal', firebirdPort: 3050, firebirdDatabase: 'C:\\Data\\Atrium.fdb',
+        firebirdUser: 'READER', firebirdPassword: ' pass word ', firebirdCharset: 'WIN1252',
+    });
+    assert.strictEqual(res.statusCode, 200);
+    assert.strictEqual(written('firebird_database_user_u1').value, 'C:\\Data\\Atrium.fdb');
+    assert.strictEqual(written('firebird_port_user_u1').value, '3050');
+    assert.strictEqual(written('firebird_password_user_u1').value, ' pass word ');
+    assert.strictEqual(written('firebird_charset_user_u1').value, 'WIN1252');
+});
+
+test('a Firebird port outside 1..65535 is refused; an empty port means the default', async () => {
+    assert.strictEqual((await post({ firebirdPort: 70000 })).statusCode, 400);
+    assert.strictEqual((await post({ firebirdPort: '0' })).statusCode, 400);
+    touched.length = 0;
+    const res = await post({ firebirdPort: '' });
+    assert.strictEqual(res.statusCode, 200);
+    assert.strictEqual(written('firebird_port_user_u1').value, '');
+});
+
+test('a Firebird user with a separator is refused', async () => {
+    const res = await post({ firebirdUser: 'dom\\reader' });
+    assert.strictEqual(res.statusCode, 400);
+    assert.match(res.body.error, /Firebird user is invalid/);
+});
+
+// ── Frappe CRM ─────────────────────────────────────────────────────────
+test('a Frappe CRM connection is saved as typed; a key with a colon is refused and nothing is saved', async () => {
+    const bad = await post({ frappeCrmUrl: 'https://crm.example.com', frappeCrmApiKey: 'key:withcolon', frappeCrmApiSecret: 's3cret' });
+    assert.strictEqual(bad.statusCode, 400);
+    assert.match(bad.body.error, /Frappe CRM API key is invalid/);
+    assert.deepStrictEqual(touched, []);
+    const res = await post({ frappeCrmUrl: ' https://crm.example.com ', frappeCrmApiKey: 'abc123', frappeCrmApiSecret: 's3cret' });
+    assert.strictEqual(res.statusCode, 200);
+    assert.strictEqual(written('frappe_crm_url_user_u1').value, 'https://crm.example.com');
+    assert.strictEqual(written('frappe_crm_api_key_user_u1').value, 'abc123');
+    assert.strictEqual(written('frappe_crm_api_secret_user_u1').value, 's3cret');
+});
