+// @typecheck strict
+'use strict';
+/**
+ * Read which middleware sits on a route, from the route source. Shared by
+ * writeGates.test.js (the core's MCP server definitions) and its module halves
+ * writeGates.apps.test.js (App Studio) and writeGates.playbooks.test.js (Playbooks).
+ */
+
+const assert = require('node:assert');
+const fs = require('node:fs');
+const { walkServerTree, treeFile } = require('../testUtils/serverTree');
+
+/**
+ * The source a router declares its routes in — one file, or, when the router
+ * is a FOLDER whose parts register onto one router, every .js under it, in
+ * every root (a folder may be split over the core and a module).
+ *
+ * RECURSIVE on purpose. A one-level scan stops seeing a part the moment it
+ * moves into a subfolder, and a test would keep passing while proving
+ * nothing about the routes it does not read.
+ * @param {string} rel a tree path
+ * @returns {string}
+ */
+function readRouter(rel) {
+    const file = treeFile(rel);
+    if (file) return fs.readFileSync(file, 'utf8');
+    const parts = walkServerTree({
+        under: rel,
+        filter: (_p, entry) => entry.isDirectory() || (entry.name.endsWith('.js') && !entry.name.includes('.test.')),
+    }).map((f) => fs.readFileSync(f.abs, 'utf8'));
+    assert.ok(parts.length, `${rel} holds no route source in any root — did the router move?`);
+    return parts.join('\n');
+}
+
+/**
+ * Middleware named between the path and the handler of a route declaration.
+ * @param {string} source
+ * @param {string} verb
+ * @param {string} routePath
+ * @returns {string | null}
+ */
+function middlewareFor(source, verb, routePath) {
+    const re = new RegExp(
+        `router\\.${verb}\\('${routePath.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}',([^]*?)(?:async\\s*)?\\(req, res\\)`,
+    );
+    const m = source.match(re);
+    return m ? m[1] : null;
+}
+
+module.exports = { readRouter, middlewareFor };
