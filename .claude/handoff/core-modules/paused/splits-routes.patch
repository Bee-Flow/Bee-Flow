+/**
+ * Module notebooks' half of notebooks.test.js: archiving a notebook from the
+ * Documents library runs usecases/notebookArchive, which folds co-editing back
+ * first and drops task links after.
+ *
+ * Run: cd server && node --test routes/studioDocuments/notebooks.notebooks.test.js
+ */
+
+const test = require('node:test');
+const assert = require('node:assert');
+const { notebookLibraryWorld } = require('./notebooks.testkit');
+
+const { calls, owned, archive } = notebookLibraryWorld(test);
+
+test('the owner archives a notebook: co-editing folded back first, task links dropped after', async () => {
+    const res = await archive('owner');
+    assert.strictEqual(res.status, 200, res.text);
+    assert.deepStrictEqual(res.body, { success: true });
+    assert.deepStrictEqual(calls, [['beforeDelete', 'notebook', 'nb1', 'owner'], ['archived', 'nb1', true], ['dropTaskLinks', 'notebook', 'nb1']]);
+    assert.strictEqual(owned.get('nb1'), true);
+});
