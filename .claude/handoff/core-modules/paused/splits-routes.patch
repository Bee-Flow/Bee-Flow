diff --git a/server/routes/studioDocuments/notebooks.testkit.js b/server/routes/studioDocuments/notebooks.testkit.js
new file mode 100644
index 00000000..af56d05e
--- /dev/null
+++ b/server/routes/studioDocuments/notebooks.testkit.js
@@ -0,0 +1,78 @@
+// @typecheck strict
+'use strict';
+/**
+ * The Documents library's notebook router (studioDocuments/notebooks.js) over doubles of
+ * its stores, lifecycle and gates, served for one test file. Shared by notebooks.test.js
+ * (the core's library routes) and its module half notebooks.notebooks.test.js (archiving,
+ * which runs module notebooks' usecases/notebookArchive).
+ */
+
+const h = require('../../testUtils/routeHarness');
+const { makeNotebookLibraryRouter } = require('./notebooks');
+
+/** @typedef {[string, string, { folderId?: string | null, categories?: unknown }]} Filing */
+/** @typedef {(user: string | null, id?: string) => ReturnType<ReturnType<typeof h.serve>['call']>} Call */
+
+/**
+ * Build the router and serve it; registers the after and beforeEach hooks on `test`.
+ * @param {typeof import('node:test')} test
+ */
+function notebookLibraryWorld(test) {
+    /** @type {Filing[]} */
+    const filings = [];
+    /** the notebook gates: open or refusing */
+    const gate = { open: true };
+    /** owner's notebooks by id: whether each is archived */
+    /** @type {Map<string, boolean>} */
+    const owned = new Map();
+    /** @type {unknown[][]} */
+    const calls = [];
+    const router = makeNotebookLibraryRouter({
+        library: {
+            async setNotebookArchived(userId, id, archived) {
+                if (userId !== 'owner' || !owned.has(id)) return null;
+                if (!archived && !owned.get(id)) return null;
+                owned.set(id, archived);
+                calls.push(['archived', id, archived]);
+                return { id, name: 'Research', folderId: null, categories: [], updatedAt: '2026-11-20T00:00:00.000Z' };
+            },
+            async ownNotebookState(userId, id) {
+                return userId === 'owner' && owned.has(id) ? { archived: /** @type {boolean} */ (owned.get(id)) } : null;
+            },
+            async setNotebookFiling(userId, id, filing, assertFolder) {
+                if (id !== 'nb1' || userId !== 'owner') return null;
+                if (filing.folderId) await assertFolder(filing.folderId, userId);
+                filings.push([userId, id, filing]);
+                return { folderId: filing.folderId ?? null, categories: /** @type {string[]} */ (filing.categories || []) };
+            },
+        },
+        documents: {
+            async assertFolder(folderId) {
+                if (folderId !== 'f1') throw Object.assign(new Error('Folder not found'), { status: 404 });
+            },
+        },
+        lifecycle: {
+            async beforeDelete(kind, id, userId) { calls.push(['beforeDelete', kind, id, userId]); },
+            async dropTaskLinks(kind, id) { calls.push(['dropTaskLinks', kind, id]); },
+            async deleteForGood(id, userId) { calls.push(['deleteForGood', id, userId]); owned.delete(id); return { deleted: true, sources: 2, kbs: 1 }; },
+            forgetTokens(id) { calls.push(['forgetTokens', id]); },
+        },
+        gate: (req, res, next) => (gate.open ? next() : res.status(403).json({ error: 'Notebooks are not available to you.', code: 'notebooks_unavailable' })),
+        requireAuth: (req, res, next) => (req.session?.user ? next() : res.status(401).json({ error: 'Authentication required' })),
+    });
+    const api = h.serve('/api/studio-documents', router);
+    test.after(api.close);
+    test.beforeEach(() => { filings.length = 0; gate.open = true; calls.length = 0; owned.clear(); owned.set('nb1', false); });
+
+    /** @param {string | null} user */
+    const as = (user) => (user ? { id: user, organizationId: 'org1' } : null);
+    /** @type {Call} */
+    const archive = (user, id = 'nb1') => api.call('POST', `/api/studio-documents/notebooks/${id}/archive`, { user: as(user), body: {} });
+    /** @type {Call} */
+    const restore = (user, id = 'nb1') => api.call('POST', `/api/studio-documents/notebooks/${id}/unarchive`, { user: as(user), body: {} });
+    /** @type {Call} */
+    const remove = (user, id = 'nb1') => api.call('DELETE', `/api/studio-documents/notebooks/${id}`, { user: as(user) });
+    return { router, api, filings, gate, owned, calls, archive, restore, remove };
+}
+
+module.exports = { notebookLibraryWorld };
