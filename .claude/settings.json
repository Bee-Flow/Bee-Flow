{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "PowerShell",
      "Bash",
      "mcp__ci-local__ci_wait",
      "mcp__ci-local__ci_findings",
      "mcp__ci-local__ci_status",
      "mcp__ci-local__ci_pr",
      "mcp__ci-local__ci_plan",
      "mcp__beeflow-cms__cms_screenshot",
      "mcp__beeflow-cms__cms_get_locale_overrides",
      "mcp__beeflow-cms__cms_get_page",
      "mcp__beeflow-cms__cms_analytics_metrics",
      "mcp__beeflow-cms__cms_list_site",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__youtrack__search_issues",
      "mcp__youtrack__get_issue",
      "mcp__beeflow-cms__cms_list_sites",
      "mcp__beeflow-cms__cms_get_site_settings",
      "mcp__beeflow-cms__cms_check_links",
      "mcp__beeflow-automations__builder_inspect_tool",
      "mcp__ci-local__ci_doctor"
    ],
    "ask": [
      "Bash(npm run push:prd)",
      "PowerShell(npm run push:prd)",
      "Bash(npm run build:prd)",
      "PowerShell(npm run build:prd)",
      "Bash(kubectl apply:*)",
      "PowerShell(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "PowerShell(kubectl delete:*)",
      "Bash(kubectl rollout:*)",
      "PowerShell(kubectl rollout:*)",
      "Bash(kubectl scale:*)",
      "PowerShell(kubectl scale:*)",
      "Bash(kubectl patch:*)",
      "PowerShell(kubectl patch:*)",
      "Bash(./scripts/deploy:*)",
      "Bash(bash scripts/deploy:*)",
      "Bash(sh scripts/deploy:*)",
      "Bash(./selfhost.sh:*)"
    ],
    "deny": [
      "Read(**/.credentials*)",
      "Edit(**/.credentials*)",
      "Read(**/deploy/**/.env*)",
      "Edit(**/deploy/**/.env*)",
      "Read(**/.env.scaleway*)",
      "Edit(**/.env.scaleway*)",
      "Read(**/deploy/**/.rendered/**)",
      "Edit(**/deploy/**/.rendered/**)",
      "Read(**/deploy/**/*kubeconfig*)",
      "Edit(**/deploy/**/*kubeconfig*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "PowerShell(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(git push -f:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|Grep|Bash|PowerShell|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "secret-guard"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-secret-scan.mjs\"",
            "timeout": 130,
            "statusMessage": "secret-scan"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/push-branch-gate.mjs\"",
            "timeout": 10,
            "statusMessage": "push-gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-lint.mjs\"",
            "timeout": 30,
            "statusMessage": "eslint --fix"
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-test.mjs\"",
            "timeout": 130,
            "async": true,
            "asyncRewake": true,
            "rewakeSummary": "Sibling test failed",
            "statusMessage": "sibling tests"
          }
        ]
      }
    ]
  }
}
