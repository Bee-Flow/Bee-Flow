# WhisperX Transcription Service Configuration
# Copy to .env and configure. Speech-to-text with alignment and diarization;
# listens on port 8787 (fixed in the image's CMD, not env-configurable).

# ── Auth ─────────────────────────────────────────────────────────
# Shared API key: when set, every request except /health needs X-API-Key.
SERVICES_API_KEY=

# ── Model ────────────────────────────────────────────────────────
# Whisper model size. medium: ~1.5GB VRAM on a shared L4, still strong for
# Dutch; large-v3 needs ~4GB.
WHISPER_MODEL=medium
# HuggingFace token — required for the pyannote diarization models.
HF_TOKEN=

# ── Devices ──────────────────────────────────────────────────────
# Empty = cuda when torch sees a GPU, else cpu.
# WHISPERX_DEVICE=
# Device for the alignment (wav2vec2) and diarization (pyannote) stages.
# On some ROCm targets these must run on CPU while CTranslate2 transcribes
# on the GPU. Empty = same device as transcription.
# WHISPERX_TORCH_DEVICE=

# ── Work bounds ──────────────────────────────────────────────────
# WHISPERX_BATCH_SIZE=4
# Max upload size in MB; larger uploads get a 413.
# WHISPERX_MAX_UPLOAD_MB=500
