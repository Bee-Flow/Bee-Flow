{
    // Type-checks the e2e suite and the Playwright config. Playwright runs
    // them itself, so nothing here is emitted.
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "lib": ["ES2023", "DOM"],
        "noEmit": true
    },
    "include": ["./**/*.ts", "../playwright.config.ts", "../src/shell/bridge.ts"]
}
