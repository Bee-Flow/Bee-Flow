# ─────────────────────────────────────────────────────────────
# BeeFlow — Portainer Stack Environment
#
# Copy to .env.portainer, fill in values, then upload to Portainer:
#   Stacks → your-stack → Edit → Environment variables → Load from .env
#
# Generate the secrets (lines marked GENERATE):
#   openssl rand -hex 32   →  SESSION_SECRET, MASTER_ENCRYPTION_KEY, SERVICES_API_KEY
#   openssl rand -hex 16   →  DB_PASSWORD, RUSTFS_PASSWORD
#
# Lines marked OPTIONAL can stay empty; the relevant feature simply
# won't activate (e.g. no Serper key → web search disabled but KB
# search still works).
# ─────────────────────────────────────────────────────────────


# ── Network / ports ──────────────────────────────────────────
# The host ports that the stack exposes. Pick anything free on
# your Portainer host; the internal container ports are fixed.
SERVER_PORT=3002
FRONTEND_PORT=3001


# ── Public URLs ──────────────────────────────────────────────
# How users reach the app from a browser. If you front this with
# nginx/Caddy + a real domain, set these to https://your-domain.tld
# and bump COOKIE_SECURE=true.
SERVER_PROTOCOL=http
SERVER_PUBLIC_HOST=localhost:3002
CLIENT_PROTOCOL=http
CLIENT_PUBLIC_HOST=localhost:3001

# Comma-separated list of origins allowed by CORS. Must include the
# CLIENT_PROTOCOL://CLIENT_PUBLIC_HOST value above.
CORS_ORIGIN=http://localhost:3001


# ── Cookies / sessions ───────────────────────────────────────
COOKIE_NAME=beeflow.sid
# Set to "true" only if SERVER_PROTOCOL=https. Browsers reject
# Secure cookies over plain HTTP.
COOKIE_SECURE=false
# Optional cookie domain. Leave empty for hostname-only cookies.
# Set to ".your-domain.tld" if you have subdomains sharing sessions.
COOKIE_DOMAIN=
# "lax" works for same-site; switch to "none" + Secure=true for cross-site.
COOKIE_SAMESITE=lax


# ── Feature flags ────────────────────────────────────────────
# DEPLOYMENT_MODE: "self-hosted" goes straight to login and uses licence keys
# (no Stripe/billing; Community tier by default). "cloud" is Bee Flow SaaS only.
DEPLOYMENT_MODE=self-hosted
DEMO_MODE_ENABLED=false
# Set to "false" to hide the sign-up button.
ALLOW_SIGNUPS=true
# Set to "false" for SSO-only deployments.
ALLOW_PASSWORD_LOGIN=true
ENABLE_TASKS=true
ENABLE_MONITORING=true


# ── PostgreSQL ───────────────────────────────────────────────
DB_USER=beeflow
DB_PASSWORD=                                    # GENERATE: openssl rand -hex 16
DB_NAME=beeflow_core
# Other DBs (beeflow_tasks, monitoring_db) are created automatically
# by the server on first boot — no extra config needed.


# ── RustFS (S3-compatible object storage) ────────────────────
RUSTFS_USER=beeflow
RUSTFS_PASSWORD=                                # GENERATE: openssl rand -hex 16
S3_BUCKET=beeflow-media


# ── Secrets ──────────────────────────────────────────────────
# CRITICAL: changing MASTER_ENCRYPTION_KEY after data exists makes
# encrypted columns unreadable. Generate ONCE and back it up.
SESSION_SECRET=                                 # GENERATE: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=                          # GENERATE: openssl rand -hex 32

# API key for inter-service calls. The server uses this to authenticate
# with guard-service AND to authenticate the client (your customer) when
# they call /api/search from outside. Treat it like a password.
SERVICES_API_KEY=                               # GENERATE: openssl rand -hex 32


# ── Web search (optional) ────────────────────────────────────
# Get a key from https://serper.dev (free tier: 2,500 queries/month).
# Empty = KB search still works, web search via agent_search disabled.
SERPER_API_KEY=                                 # OPTIONAL
